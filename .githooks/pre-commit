#!/usr/bin/env bash
# Optional git hook, enabled with `pixi run install-git-hooks` (git config core.hooksPath .githooks).
# Runs the read-only lint hooks of .pre-commit-config.yaml on the staged files, with the tools of the pixi `lint`
# environment (never host tools). `pixi run fmt` fixes formatting findings; CI runs the same checks on every PR.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if ! command -v pixi >/dev/null 2>&1; then
  echo "pre-commit hook: pixi is not on PATH (see AGENTS.md, Setup)." >&2
  echo "Disable the hook with: git config --unset core.hooksPath" >&2
  exit 1
fi
export PRE_COMMIT_HOME="$PWD/.cache/pre-commit"
exec pixi run --frozen -e lint pre-commit run --hook-stage pre-commit
