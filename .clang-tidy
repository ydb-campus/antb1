---
# clang-tidy 23 (pixi env `default`). Run with `pixi run tidy` (preset `tidy`, -Werror).
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-use-nodiscard,
  performance-*,
  portability-*,
  readability-*,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-function-cognitive-complexity,
  -readability-uppercase-literal-suffix,
  -readability-avoid-unconditional-preprocessor-if,
  -readability-trailing-comma,
  -portability-avoid-pragma-once,
  -performance-enum-size
WarningsAsErrors: '*'
HeaderFilterRegex: '/(src|tests|tools|fuzz|bench)/'
ExcludeHeaderFilterRegex: '/\.pixi/|/build/'
FormatStyle: file
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  # Google style: cheap accessors may be snake_case (schema(), exact_row_count()).
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^[a-z][a-z0-9_]*$'
  - key: readability-identifier-naming.MethodIgnoredRegexp
    value: '^[a-z][a-z0-9_]*$'
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k
  - key: misc-const-correctness.AnalyzeValues
    value: false
...
