Output: zn_id:INTEGER
Project zn_id
  Sort zn_id ASC NULLS LAST
    Filter zn_parent > "max(c.ct_pop)"
      Join INNER build=right keys=["z.zn_city" = ct_id] carries 2 of 5 unread above
        Scan table=zones source=parquet(files=1, rows=40) columns=[zn_id, zn_city, zn_parent]
        GroupAggregate keys=[ct_id] MAX(ct_pop)
          Scan table=cities source=parquet(files=1, rows=6) columns=[ct_id, ct_pop]
