Output: tr_pickup:INTEGER sum(CASE  WHEN (tr_rider IN (SELECT rd_id FROM riders WHERE rd_id < 50)) THEN (1) ELSE 0 END):HUGEINT
Project tr_pickup, "sum(CASE  WHEN (tr_rider IN (SELECT rd_id FROM riders WHERE rd_id < 50)) THEN (1) ELSE 0 END)"
  Filter "((count_star() > 60) OR tr_pickup IN (SELECT zn_id FROM zones WHERE zn_city = 1))"
    Compute ((count_star() > 60) OR tr_pickup IN (SELECT zn_id FROM zones WHERE zn_city = 1))
      Join NULL-AWARE MARK build=right keys=[tr_pickup = zn_id]
        GroupAggregate keys=[tr_pickup] SUM("CASE  WHEN (tr_rider IN (SELECT rd_id FROM riders WHERE rd_id < 50)) THEN (1) ELSE 0 END"), COUNT(*)
          Compute CASE  WHEN (tr_rider IN (SELECT rd_id FROM riders WHERE rd_id < 50)) THEN (1) ELSE 0 END
            Join NULL-AWARE MARK build=right keys=[tr_rider = rd_id] carries 2 of 4 unread above
              Filter tr_row > 100
                Scan table=trips source=parquet(files=1, rows=3000) columns=[tr_row, tr_rider, tr_pickup]
              Project rd_id
                Filter rd_id < 50
                  Scan table=riders source=parquet(files=1, rows=240) columns=[rd_id]
        Project zn_id
          Filter zn_city = 1
            Scan table=zones source=parquet(files=1, rows=40) columns=[zn_id, zn_city]
