# Projections over NULLs.
query TII rowsort
SELECT s, i32, i64 FROM edge WHERE id >= 5
----
NULL	54321	-42
NULL	NULL	NULL
\x20leading space	100000	1000000000000000
\x4eULL	NULL	42
naïve café	-7	7
x\x01y	-100000	-1000000000000000
Привет, мир	7	NULL


query RTI rowsort
SELECT d, u, u16 FROM edge WHERE u16 >= 15000
----
-9007199254740992	x\x7fy	40000
0.1	back\\slash	15887
0.3333333333333333	a	65535
0.6666666666666666	line\nbreak	32768
123456789.125	trailing space\x20	15917

