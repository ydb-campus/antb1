# SELECT * and plain columns: any order, repeated columns, aliases, names in any case or quoted. SQL does not
# order the rows of a projection, so these records use rowsort (LIMIT records are in limit/limit.slt).

query IIIIIRTT rowsort
SELECT * FROM edge
----
0	-32768	-2147483648	-9223372036854775808	0	-0.5	(empty)	(empty)
1	32767	2147483647	9223372036854775807	65535	0.3333333333333333	a	a
10	-12345	54321	-42	12	922337203685477632	NULL	日本語
11	7	-7	7	7	-0.3333333333333333	naïve café	NULL
2	0	0	0	1	0	tab\there	tab\there
3	-1	-1	-1	32768	0.6666666666666666	line\nbreak	line\nbreak
4	1	1	1	15887	0.1	back\\slash	back\\slash
5	NULL	NULL	NULL	NULL	NULL	NULL	NULL
6	100	100000	1000000000000000	15917	123456789.125	\x20leading space	trailing space\x20
7	-100	-100000	-1000000000000000	40000	-9007199254740992	x\x01y	x\x7fy
8	NULL	7	NULL	2	9.99999993e-10	Привет, мир	Привет, мир
9	12345	NULL	42	NULL	NULL	\x4eULL	\x28empty)

query TIT rowsort
SELECT u, id, s FROM edge WHERE id < 4
----
(empty)	0	(empty)
a	1	a
line\nbreak	3	line\nbreak
tab\there	2	tab\there

query III rowsort
SELECT id, id AS again, i16 FROM edge WHERE i16 > 0
----
1	1	32767
11	11	7
4	4	1
6	6	100
9	9	12345

query IT rowsort
SELECT "ID", "U" FROM "EDGE" WHERE Id >= 9
----
10	日本語
11	NULL
9	\x28empty)

query ITIT rowsort
select watchid, eventdate, regionid AS r, title AS "The Title" from HITS_LIKE where regionid > 19990
