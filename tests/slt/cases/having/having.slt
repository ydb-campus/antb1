# HAVING (docs/sql-subset.md): a conjunction of <aggregate or column> <op> literal, with the operators of
# WHERE (comparisons, [NOT] LIKE, [NOT] IN), filtering the groups after aggregation. An aggregate may be
# one of the select list or another one; a column is a GROUP BY key (a table column that is a key comes
# first), else the alias of a key or an aggregate in the select list.

query II rowsort
SELECT i16, COUNT(*) FROM edge GROUP BY i16 HAVING COUNT(*) > 1
----
NULL	2

query II rowsort
SELECT AdvEngineID, COUNT(*) AS c FROM hits_like GROUP BY AdvEngineID HAVING c >= 500
----
0	8968

query I rowsort
SELECT AdvEngineID FROM hits_like GROUP BY AdvEngineID HAVING 500 <= COUNT(*) AND SUM(ResolutionWidth) > 0
----
0

