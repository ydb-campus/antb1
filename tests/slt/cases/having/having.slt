query II rowsort
SELECT i32, SUM(i64) FROM edge GROUP BY i32 HAVING SUM(i64) > 9223372036854775807
----
INTEGER	HUGEINT

query I rowsort
SELECT id FROM edge GROUP BY id HAVING SUM(i64) <= -9223372036854775808
----
INTEGER
0

query I rowsort
SELECT id FROM edge GROUP BY id HAVING MAX(d) >= 1e308
----
INTEGER

query TI rowsort
SELECT MIN(u) AS m, COUNT(DISTINCT i16) FROM edge GROUP BY i32 HAVING COUNT(DISTINCT i16) = 1 AND m <> ''
----
VARCHAR	BIGINT
\x28empty)	1
a	1
back\\slash	1
line\nbreak	1
tab\there	1
trailing space\x20	1
x\x7fy	1
日本語	1

# NULL aggregates and keys fail every comparison, NOT IN and NOT LIKE too.
query II rowsort
SELECT i16, SUM(i32) FROM edge GROUP BY i16 HAVING SUM(i32) <> 0
----
SMALLINT	HUGEINT
-1	-1
-100	-100000
-12345	54321
-32768	-2147483648
1	1
100	100000
32767	2147483647
7	-7
NULL	7

query I rowsort
SELECT i16 FROM edge GROUP BY i16 HAVING i16 NOT IN (0)
----
SMALLINT
-1
-100
-12345
-32768
1
100
12345
32767
7

# A table column that is a key comes before a select alias of the same name; otherwise the alias names a
# key or an aggregate.
query I rowsort
SELECT COUNT(*) AS i16 FROM edge GROUP BY i16 HAVING i16 > 1
----
BIGINT
1
1
1
1

query II rowsort
SELECT i16 AS id, COUNT(*) AS n FROM edge GROUP BY i16 HAVING id < 100 AND n = 1
----
SMALLINT	BIGINT
-1	1
-100	1
-12345	1
-32768	1
0	1
1	1
7	1

# Without GROUP BY, HAVING makes the query one aggregate row, which it may filter out.
query I nosort
SELECT COUNT(*) FROM edge HAVING COUNT(*) > 100
----
BIGINT

query I nosort
SELECT COUNT(*) FROM edge HAVING 100 > COUNT(*)
----
BIGINT
12

query IT nosort
SELECT 7 AS k, 'x' FROM hits_like HAVING SUM(AdvEngineID) >= 0 AND MAX(EventDate) > DATE '2000-01-01'
----
INTEGER	VARCHAR
7	x

query I nosort
SELECT COUNT(*) FROM edge WHERE id > 100 HAVING MIN(id) = 5
----
BIGINT

query I nosort
SELECT COUNT(*) FROM empty HAVING COUNT(*) = 0
----
BIGINT
0

# With ORDER BY, LIMIT and OFFSET: the filter comes before the sort.
query II nosort
SELECT CounterID, COUNT(*) AS c FROM hits_like WHERE AdvEngineID = 0 GROUP BY CounterID HAVING c > 10 ORDER BY c DESC, CounterID LIMIT 5 OFFSET 1
----
INTEGER	BIGINT
9062	252
7062	250
17062	247
2062	244
34062	243

query I nosort
SELECT UserID FROM hits_like GROUP BY UserID HAVING COUNT(*) >= 2 ORDER BY SUM(ResolutionWidth) DESC, UserID LIMIT 3
----
BIGINT
9223372036854775807

# The order, as DuckDB's: HAVING filters the groups before the select list and ORDER BY are computed, so an overflow
# in those over a group HAVING drops never shows.
query II nosort
SELECT id, MAX(i32) * 2 AS m FROM edge GROUP BY id HAVING MAX(i32) = 100000
----
INTEGER	INTEGER
6	200000

query II nosort
SELECT id, MAX(i32) * 2 AS m FROM edge GROUP BY id HAVING MAX(i32) BETWEEN -100000 AND 100000 ORDER BY m, id
----
INTEGER	INTEGER
7	-200000
11	-14
3	-2
2	0
4	2
8	14
10	108642
6	200000

query I nosort
SELECT MAX(i32) * 2 FROM edge HAVING MAX(i32) < 0
----
INTEGER

query I nosort
SELECT DISTINCT MAX(i32) * 2 AS m FROM edge GROUP BY id % 4 HAVING MAX(i32) <= 100000 ORDER BY m
----
INTEGER
-2
14
200000

query III nosort
SELECT i16, GROUPING(i16) AS g, MAX(i32) * 2 AS m FROM edge GROUP BY ROLLUP (i16) HAVING GROUPING(i16) = 0 AND MAX(i32) BETWEEN -100000 AND 100000 ORDER BY i16
----
SMALLINT	BIGINT	INTEGER
-12345	0	108642
-100	0	-200000
-1	0	-2
0	0	0
1	0	2
7	0	-14
100	0	200000
NULL	0	14

query II nosort
SELECT id, SUM(i16) + 1 AS s FROM edge GROUP BY id HAVING s > 100 ORDER BY id
----
INTEGER	HUGEINT
1	32768
6	101
9	12346

# HAVING reads an alias as its item's expression, whose constant moves as written there (no overflow)...
query II nosort
SELECT id, MAX(i32) * 2 AS m FROM edge GROUP BY id HAVING m = 200000
----
INTEGER	INTEGER
6	200000

# ...but its own operands are computed for every group, the expression of an alias included.
statement error Overflow in multiplication of
SELECT id, MAX(i32) * 2 AS m FROM edge GROUP BY id HAVING m > id

statement error Overflow in multiplication of
SELECT id FROM edge GROUP BY id HAVING COUNT(*) > 1 AND MAX(i32) * 2 > id

# DuckDB, though, pushes a conjunct over GROUP BY keys alone below its aggregation and computes the other conjuncts
# only over the groups it keeps, where antb1 computes them over every group (D16).
onlyif antb1
statement error Overflow in multiplication of INTEGER
SELECT id FROM edge GROUP BY id HAVING MAX(i32) * 2 > id AND id = 6

onlyif duckdb
query I nosort
SELECT id FROM edge GROUP BY id HAVING MAX(i32) * 2 > id AND id = 6
----
INTEGER
6

# A conjunct that holds a subquery comes after the other conjuncts, in either order, and before the select list and
# ORDER BY are computed.
query I nosort
SELECT id FROM edge GROUP BY id HAVING MAX(i32) BETWEEN -100000 AND 100000 AND MAX(i32) * 2 > (SELECT MIN(i32) FROM edge) ORDER BY id
----
INTEGER
2
3
4
6
7
8
10
11

query I nosort
SELECT id FROM edge GROUP BY id HAVING MAX(i32) * 2 > (SELECT MIN(i32) FROM edge) AND COUNT(*) > 1
----
INTEGER

query II nosort
SELECT id, MAX(i32) * 2 AS m FROM edge GROUP BY id HAVING MAX(i32) = (SELECT MAX(i32) FROM edge WHERE id = 6)
----
INTEGER	INTEGER
6	200000

query I nosort
SELECT id FROM edge GROUP BY id HAVING MAX(i32) IN (SELECT i32 FROM edge WHERE id > 5) ORDER BY MAX(i32) * 2, id
----
INTEGER
7
11
8
10
6

# DuckDB pushes an enclosing block's filter on a column that a derived table computes over its aggregation into the
# table's HAVING, ahead of its conjuncts, so it computes the column for every group; antb1 computes it only over the
# groups HAVING keeps (D16).
onlyif antb1
query I nosort
SELECT id FROM (SELECT id, MAX(i64) * 2 AS m FROM edge GROUP BY id HAVING MAX(i64) BETWEEN -50 AND 50) t WHERE m > 0 ORDER BY id
----
INTEGER
4
9
11

onlyif duckdb
statement error Overflow in multiplication of
SELECT id FROM (SELECT id, MAX(i64) * 2 AS m FROM edge GROUP BY id HAVING MAX(i64) BETWEEN -50 AND 50) t WHERE m > 0 ORDER BY id

# FLOAT (floats): DuckDB's MIN and MAX of a FLOAT column are FLOAT, compared in FLOAT like the column in
# WHERE; SUM and AVG are DOUBLE.
query I rowsort
SELECT id FROM floats GROUP BY id HAVING MAX(f) = 0.1
----
INTEGER
0

query I rowsort
SELECT id FROM floats GROUP BY id HAVING SUM(f) = 0.1
----
INTEGER

query I rowsort
SELECT id FROM floats GROUP BY id HAVING AVG(f) > 0.1 AND MIN(f) IN (0.1, 0.5, 2)
----
INTEGER
0

# antb1 reads a FLOAT column as DOUBLE, so its result is DOUBLE where DuckDB's is FLOAT (divergence D11): one
# record per engine. Their label ties both to a record that both engines run, DOUBLE in both through an empty
# DOUBLE branch, so that antb1's values are still DuckDB's.
query R rowsort float_keys
SELECT f FROM floats GROUP BY f HAVING f >= 0.1 UNION ALL SELECT d FROM edge WHERE id < 0
----
DOUBLE
0.10000000149011612
0.20000000298023224
0.30000001192092896
1.2676506002282294e+30
1.2676507513439569e+30
1234.5
16777216
16777218
19.989999771118164
3.299999952316284
3.4028234663852886e+38
inf

onlyif duckdb
