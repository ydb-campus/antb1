# WHERE literals are folded exactly into the column's type at bind time (docs/sql-subset.md, "Binding"):
# a non-integer bound becomes the nearest integer on the kept side, and a bound outside the type makes
# the comparison true for every non-NULL value or for none. NULL still rejects the row.

# SMALLINT i16: -32768, 32767, 0, -1, 1, NULL, 100, -100, NULL, 12345, -12345, 7.
query I nosort
SELECT COUNT(*) FROM edge WHERE i16 < 32767
----
BIGINT
9

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 <= 32767
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 > 32767
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 >= 32768
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 < 32768
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 > -32769
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 = -32769
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 <> 40000
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 = -32768
----
BIGINT
1

# Decimals against integer columns.
query I nosort
SELECT COUNT(*) FROM edge WHERE i16 > 1.5
----
BIGINT
4

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 >= 1.5
----
BIGINT
4

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 < -1.5
----
BIGINT
3

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 <= -1.5
----
BIGINT
3

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 = 1.0
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 = 1.5
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 <> 1.5
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 < 0.5
----
BIGINT
5

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 >= -0.5
----
BIGINT
6

query I nosort
SELECT COUNT(*) FROM edge WHERE -1.5 > i16
----
BIGINT
3

query I nosort
SELECT COUNT(*) FROM edge WHERE 32767 <= i16
----
BIGINT
1

# USMALLINT u16: 0, 65535, 1, 32768, 15887, NULL, 15917, 40000, 2, NULL, 12, 7.
query I nosort
SELECT COUNT(*) FROM edge WHERE u16 = -1
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM edge WHERE u16 > -1
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE u16 < 65536
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE u16 >= 65535
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM edge WHERE u16 > 65534.5
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM edge WHERE u16 <= 0.25
----
BIGINT
1

# INTEGER i32 holds both extremes.
query I nosort
SELECT COUNT(*) FROM edge WHERE i32 >= 2147483647
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 > 2147483647
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 < -2147483648
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 >= -2147483648.5
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 <> 2147483648
----
BIGINT
10

# BIGINT i64 holds both extremes: literals beyond 64 bits compare exactly.
query I nosort
SELECT COUNT(*) FROM edge WHERE i64 = 9223372036854775807
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM edge WHERE i64 > 9223372036854775807
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM edge WHERE i64 < 9223372036854775808
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE i64 >= -9223372036854775808
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE i64 > -9223372036854775809
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE i64 <> 99999999999999999999999
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE i64 > 9223372036854775806.5
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM edge WHERE i64 <= -9223372036854775807.5
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM hits_like WHERE UserID > 4611686018427387904
----
BIGINT
2

# DOUBLE: a number is the nearest double.
query I nosort
SELECT COUNT(*) FROM edge WHERE d = 0.1
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM edge WHERE d = 922337203685477580
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM edge WHERE d > 922337203685477580
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM edge WHERE d < 0
----
BIGINT
3

query I nosort
SELECT COUNT(*) FROM edge WHERE d >= -0.5
----
BIGINT
9

query I nosort
SELECT COUNT(*) FROM edge WHERE d <> 123456789.125
----
BIGINT
9

# NULL rejects the row, also for comparisons folded to "every value".
query III nosort
SELECT COUNT(*), COUNT(RegionID), COUNT(Title) FROM hits_like_nulls WHERE RegionID > -1
----
BIGINT	BIGINT	BIGINT
9215	9215	8445

query I nosort
SELECT COUNT(*) FROM hits_like_nulls WHERE Interests > -40000
----
BIGINT
9260

# Numbers that DuckDB reads as DOUBLE (an exponent, or a decimal of more than 38 digits) are rounded
# to the nearest double first, then compared exactly (divergence D7 covers BIGINT values beyond 2^53).
query I nosort
SELECT COUNT(*) FROM edge WHERE i16 = 1.0000000000000000000001e0
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 < 1.00000000000000000000000000000000000000001
----
BIGINT
5

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 <= 0.99999999999999999999999999999999999999999
----
BIGINT
6

query I nosort
SELECT COUNT(*) FROM edge WHERE i16 = 1.00000000000000000000000000000001
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 > 1.5e0
----
BIGINT
4

query I nosort
SELECT COUNT(*) FROM edge WHERE u16 < 1e5
----
BIGINT
10

query I nosort
SELECT COUNT(*) FROM edge WHERE i64 = 1e15
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM edge WHERE i64 = 1e-400
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM edge WHERE i64 < 1e400
----
BIGINT
10

# A quotient of two numbers (ADR 0037's CT4) folds into the DOUBLE DuckDB computes: each side converted to a double and
# divided.

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 BETWEEN 2.0 / 3.0 AND 7 / 2
----
BIGINT
5

query I nosort
SELECT COUNT(*) FROM trips WHERE tr_fare > 10 / 3 AND tr_row < 500
----
BIGINT
484

query I rowsort
SELECT ct_id FROM cities WHERE ct_id IN (6 / 3, 9 / 2.0, -(1.5) / -0.5)
----
SMALLINT
2
3

query I nosort
SELECT COUNT(*) FROM decimals WHERE d18_4 < -(10) / 4.0
----
BIGINT
11

# A minus over a decimal is part of the literal, which DuckDB converts with its sign: a DECIMAL of more than 18 digits by
# a formula that is not symmetric in it, so -(000009007199254740994.) / 1 is -9007199254740992.
query I nosort
SELECT COUNT(*) FROM edge WHERE d > -(000009007199254740994.) / 1
----
BIGINT
9

# A minus over a number is part of the literal (DuckDB's parser folds it), which then folds as any literal.
query I nosort
SELECT COUNT(*) FROM edge WHERE i16 < -(-32767) AND i16 > -(32768.5) AND i16 <> - -12345
----
BIGINT
8
