# WHERE predicates on scan columns are applied by the scan while it decodes (filter pushdown,
# docs/adr/0020-filter-pushdown.md): comparisons with literals, [NOT] IN, [NOT] LIKE. Comparisons of
# two columns and computed conditions stay in the Filter. The rows are the same either way; these
# mix both kinds over several parts (hits_like_split), NULLs (hits_like_nulls) and every column
# type (edge).

query TII nosort
SELECT MAX(URL), COUNT(*), MIN(RegionID) FROM hits_like_split WHERE URL LIKE '%a%' AND Title NOT LIKE '%e%' AND RegionID > 100
----
https://www.example.org/погода/99688?q=quick	3943	101

query TI nosort
SELECT SearchPhrase, COUNT(*) AS c FROM hits_like_split WHERE SearchPhrase <> '' AND SearchPhrase < 'm' GROUP BY SearchPhrase ORDER BY c DESC, SearchPhrase LIMIT 5
----
green	34
alpha	27
cloud	25
lemon	25
beta	24

query II nosort
SELECT COUNT(*), SUM(ResolutionWidth) FROM hits_like_split WHERE ResolutionWidth > ResolutionHeight AND URL NOT LIKE '%a%' AND IsMobile = 0
----
70	120010

query II nosort
SELECT COUNT(*), SUM(RegionID) FROM hits_like_split WHERE RegionID + 1 > 200 AND Title LIKE '%o%' AND EventDate >= '2013-07-05'
----
3399	34407158

query IT nosort
SELECT WatchID, URL FROM hits_like_split WHERE Title LIKE '%a%' AND RegionID < 50 AND SearchPhrase NOT IN ('', 'beta') ORDER BY WatchID LIMIT 3
----
-8758085333988542591	https://www.example.org/музыка/73371
-8007520545429623500	https://www.example.org/pixel/84013
-6547949369732627505	https://www.example.org/maple/64708?q=новости

query IIII nosort
SELECT COUNT(*), COUNT(Title), COUNT(UserID), COUNT(URL) FROM hits_like_nulls WHERE Title LIKE '%a%' AND UserID <> 0 AND URL NOT LIKE '%z%'
----
4000	4000	4000	4000

query IT nosort
SELECT COUNT(*), MIN(Title) FROM hits_like_nulls WHERE Title IN ('', 'a') OR RegionID < 0
----
2286	(empty)

query I rowsort
SELECT id FROM edge WHERE s >= '' AND d < 1e300 AND u NOT IN ('x') AND i32 <> 0
----
0
1
3
4
6
7
8

query I rowsort
SELECT id FROM edge WHERE i16 + 1 > 5 AND u LIKE '%a%'
----
1
6
