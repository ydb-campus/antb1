# [NOT] BETWEEN (docs/sql-subset.md): x BETWEEN lo AND hi is lo <= x AND x <= hi, both bounds inclusive; a plain
# BETWEEN in WHERE or HAVING splits into its two comparisons (pushed into the scan), NOT BETWEEN, NOT (x BETWEEN ...)
# and BETWEEN under OR or in CASE are compound conditions. A side of a comparison may be constant integer
# arithmetic, folded in DuckDB's types.

query I nosort
SELECT COUNT(*) FROM hits_like WHERE RegionID BETWEEN 100 AND 200
----
54

query I nosort
SELECT COUNT(*) FROM hits_like WHERE RegionID between 200 and 100
----
0

query I nosort
SELECT COUNT(*) FROM hits_like WHERE RegionID BETWEEN 150 AND 150
----
1

query I nosort
SELECT COUNT(*) FROM hits_like WHERE RegionID NOT BETWEEN 100 AND 200
----
9946

query I nosort
SELECT COUNT(*) FROM hits_like WHERE NOT RegionID BETWEEN 100 AND 200
----
9946

query I nosort
SELECT COUNT(*) FROM hits_like WHERE NOT (RegionID NOT BETWEEN 100 AND 200)
----
54

