query T rowsort
SELECT CASE WHEN RegionID BETWEEN 100 AND 200 THEN 'in' WHEN RegionID NOT BETWEEN 0 AND 1000 THEN 'far' END FROM hits_like_nulls GROUP BY 1
----
NULL
far
in

statement error
SELECT COUNT(*) FROM hits_like WHERE RegionID > 2147483647 + 1

# DuckDB raises the overflow only when a row computes it, so it answers over an empty table: divergence D17.
onlyif antb1
statement error ^bind: Overflow in addition of INTEGER
SELECT COUNT(*) FROM empty WHERE RegionID > 2147483647 + 1

onlyif antb1
statement error ^bind: cannot compare
SELECT COUNT(*) FROM hits_like WHERE RegionID BETWEEN 1 AND 'x'
