# WHERE is a conjunction of column <op> literal comparisons; literal-first comparisons are mirrored.

query IIIIIIT nosort
SELECT COUNT(*), COUNT(i32), SUM(i32), MIN(i32), MAX(i32), COUNT(s), MIN(s) FROM edge WHERE i32 <> 0
----
BIGINT	BIGINT	HUGEINT	INTEGER	INTEGER	BIGINT	VARCHAR
9	9	54320	-2147483648	2147483647	8	(empty)

