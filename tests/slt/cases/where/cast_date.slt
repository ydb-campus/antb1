# Date casts (docs/sql-subset.md): CAST('YYYY-MM-DD' AS DATE) and 'YYYY-MM-DD'::DATE are the literal
# DATE 'YYYY-MM-DD' in every clause, in any case and on either side of a comparison. EventDate (uint16 days)
# reads as DATE through the `clickbench` option of tests/slt/tables.txt.

query I nosort
SELECT COUNT(*) FROM hits_like WHERE EventDate = CAST('2013-07-15' AS DATE)
----
335

query I nosort
SELECT COUNT(*) FROM hits_like WHERE EventDate >= '2013-07-10'::DATE AND EventDate < cast('2013-07-20' as date)
----
3227

query I nosort
SELECT COUNT(*) FROM hits_like WHERE '2013-07-04'::date >= EventDate
----
1376

query I nosort
SELECT COUNT(*) FROM hits_like WHERE CAST('2013-07-30' AS DATE) < EventDate OR EventDate <= ('2013-07-01')::Date
----
676

query I nosort
SELECT COUNT(*) FROM hits_like_nulls WHERE EventDate IN ('2013-07-01'::DATE, CAST('2013-07-31' AS DATE), DATE '2013-07-15')
----
941

query I nosort
SELECT COUNT(*) FROM hits_like_nulls WHERE EventDate NOT IN ('2013-07-01'::DATE, CAST('2013-07-31' AS DATE))
----
8604

query TI rowsort
SELECT EventDate, COUNT(*) FROM hits_like_split WHERE EventDate > '2013-07-27'::DATE GROUP BY EventDate
----
2013-07-28	335
2013-07-29	336
2013-07-30	327
2013-07-31	323

query ITT rowsort
SELECT AdvEngineID, MIN(EventDate), MAX(EventDate) FROM hits_like GROUP BY AdvEngineID HAVING MIN(EventDate) <= CAST('2013-07-01' AS DATE) AND MAX(EventDate) >= '2013-07-31'::DATE
----
0	2013-07-01	2013-07-31
12	2013-07-01	2013-07-31
20	2013-07-01	2013-07-31
27	2013-07-01	2013-07-31
33	2013-07-01	2013-07-31
34	2013-07-01	2013-07-31
35	2013-07-01	2013-07-31
40	2013-07-01	2013-07-31
43	2013-07-01	2013-07-31
48	2013-07-01	2013-07-31
5	2013-07-01	2013-07-31
57	2013-07-01	2013-07-31
6	2013-07-01	2013-07-31

query IT nosort
SELECT AdvEngineID, MAX(EventDate) FROM hits_like WHERE EventDate < '2013-07-02'::DATE GROUP BY AdvEngineID ORDER BY '2013-07-15'::DATE, AdvEngineID
----
0	2013-07-01
3	2013-07-01
5	2013-07-01
6	2013-07-01
7	2013-07-01
9	2013-07-01
10	2013-07-01
12	2013-07-01
14	2013-07-01
16	2013-07-01
20	2013-07-01
27	2013-07-01
33	2013-07-01
34	2013-07-01
35	2013-07-01
39	2013-07-01
40	2013-07-01
42	2013-07-01
43	2013-07-01
45	2013-07-01
48	2013-07-01
49	2013-07-01
55	2013-07-01
56	2013-07-01
