59	2013-07-01

# Constants: DuckDB names a cast like the DATE literal, CAST('2020-01-02' AS "DATE").

query TTT nosort
SELECT CAST('2020-01-02' AS DATE), '2024-01-31'::date AS d, DATE '2013-07-15' FROM hits_like LIMIT 2
----
2020-01-02	2024-01-31	2013-07-15
2020-01-02	2024-01-31	2013-07-15

query TI nosort
SELECT '2020-01-02'::DATE, COUNT(*) FROM hits_like GROUP BY '2020-01-02'::DATE
----
2020-01-02	10000

query TI nosort
SELECT CAST('2020-01-02' AS DATE) AS k, COUNT(*) FROM hits_like_split GROUP BY 1
----
2020-01-02	10000

query TI rowsort
SELECT CASE WHEN EventDate < '2013-07-03'::DATE THEN CAST('2013-07-01' AS DATE) ELSE EventDate END AS d, COUNT(*) FROM hits_like WHERE EventDate < DATE '2013-07-06' GROUP BY d
----
2013-07-01	715
2013-07-03	350
2013-07-04	311
2013-07-05	320

query I nosort
SELECT COUNT(CASE EventDate WHEN '2013-07-15'::DATE THEN 1 END) FROM hits_like
----
335

# Timestamps: a date cast compared with a timestamp is its midnight.

query I nosort
SELECT COUNT(*) FROM hits_like WHERE toDateTime(EventTime) >= CAST('2013-07-15' AS DATE) AND toDateTime(EventTime) < '2013-07-16'::DATE
----
335

query TII nosort
SELECT date_trunc('month', '2013-07-15'::DATE), EXTRACT(year FROM '2013-07-15'::DATE), EXTRACT(day FROM CAST('2013-07-15' AS DATE)) FROM hits_like LIMIT 1
----
2013-07-01 00:00:00	2013	15

# The empty table and a table of several files.

query IT nosort
SELECT COUNT(*), MAX(EventDate) FROM empty WHERE EventDate >= '2013-07-01'::DATE
----
0	NULL

query TT nosort
SELECT MIN(EventDate), MAX(EventDate) FROM hits_like_split WHERE AdvEngineID <> 0 AND EventDate > CAST('2013-07-05' AS DATE)
----
2013-07-06	2013-07-31

# An invalid date fails in both engines.

statement error
SELECT COUNT(*) FROM hits_like WHERE EventDate = CAST('2013-02-30' AS DATE)

statement error
SELECT '2013-13-01'::DATE FROM hits_like

# D5 (docs/sql-subset.md): a date is written exactly YYYY-MM-DD; DuckDB also accepts 2013-7-1.

onlyif antb1
statement error ^bind: invalid date '2013-7-1': expected YYYY-MM-DD
SELECT COUNT(*) FROM hits_like WHERE EventDate = '2013-7-1'::DATE

# D4: a DATE compared with a VARCHAR column is a bind error; DuckDB casts the column's values.

onlyif antb1
statement error ^bind: cannot compare VARCHAR column 'Title' with a DATE literal
SELECT COUNT(*) FROM hits_like WHERE Title = CAST('2013-07-01' AS DATE)
