query T rowsort
SELECT label FROM cities EXCEPT SELECT label FROM cities WHERE ct_id < 3
----
VARCHAR
airport
hills
old town
outskirts

# ---- errors ----

statement error Set operations can only apply to expressions with the same number of result columns
SELECT ct_id FROM cities EXCEPT SELECT ct_id, label FROM cities

statement error Set operations can only apply to expressions with the same number of result columns
SELECT ct_id FROM cities EXCEPT SELECT ct_id, label FROM cities EXCEPT SELECT nope FROM cities

# ---- divergence D29: which of -0.0 and 0.0 an EXCEPT keeps ----
# (B EXCEPT C) UNION A, with B holding -0.0 and C and A 0.0: B's row is removed, but B is read first among the blocks
# that can bring a row in, so antb1 keeps -0.0; DuckDB keeps A's 0.0.

onlyif antb1
query R rowsort
(SELECT d * 0 FROM edge WHERE i16 = 7 EXCEPT SELECT d * 0 FROM edge WHERE i16 = 1) UNION SELECT d * 0 FROM edge WHERE i16 = 1
----
DOUBLE
-0

onlyif duckdb
query R rowsort
(SELECT d * 0 FROM edge WHERE i16 = 7 EXCEPT SELECT d * 0 FROM edge WHERE i16 = 1) UNION SELECT d * 0 FROM edge WHERE i16 = 1
----
DOUBLE
0

# Under an ALL root antb1 prints the normalized value; DuckDB drops an EXCEPT ALL whose later operand a LIMIT 0 empties,
# and its rows keep their own value.

onlyif antb1
query R rowsort
SELECT d * 0 FROM edge WHERE i16 = 7 EXCEPT ALL (SELECT d * 0 FROM edge WHERE i16 = 1 LIMIT 0)
----
DOUBLE
0

onlyif duckdb
query R rowsort
SELECT d * 0 FROM edge WHERE i16 = 7 EXCEPT ALL (SELECT d * 0 FROM edge WHERE i16 = 1 LIMIT 0)
----
DOUBLE
-0

# ---- divergence D30: which error an EXCEPT reports ----
# With both operands failing, antb1 reports the left one's, the addition; DuckDB builds the right operand first and
# reports the multiplication.

onlyif antb1
statement error Overflow in addition
SELECT i16 + 1 FROM edge EXCEPT SELECT i16 * 2 FROM edge

onlyif duckdb
statement error Overflow in multiplication
SELECT i16 + 1 FROM edge EXCEPT SELECT i16 * 2 FROM edge

# With the left operand emptied by a LIMIT 0, DuckDB skips the right one and returns no rows; antb1 reads every operand
# and fails on the right one's overflow.

onlyif antb1
statement error Overflow in multiplication
(SELECT i16 FROM edge LIMIT 0) EXCEPT SELECT i16 * 2 FROM edge

onlyif duckdb
query I nosort
(SELECT i16 FROM edge LIMIT 0) EXCEPT SELECT i16 * 2 FROM edge
----
SMALLINT
