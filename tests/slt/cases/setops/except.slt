# ---- where a compound stands ----

query I nosort
SELECT COUNT(*) FROM (SELECT zn_city FROM zones EXCEPT ALL SELECT zn_city FROM zones WHERE zn_id > 20) AS u
----
BIGINT
20

query II rowsort
WITH e AS (SELECT zn_city AS c FROM zones EXCEPT ALL SELECT zn_city FROM zones WHERE zn_id > 10) SELECT c, COUNT(*) FROM e GROUP BY c
----
SMALLINT	BIGINT
1	2
2	2
3	2
4	2
5	2

query IT rowsort
SELECT e.c, ct.label FROM (SELECT ct_id AS c FROM cities EXCEPT SELECT zn_city FROM zones WHERE zn_id < 20) AS e JOIN cities AS ct ON e.c = ct.ct_id
----
SMALLINT	VARCHAR
6	outskirts

query II rowsort
SELECT tr_pickup % 4, COUNT(*) FROM (SELECT tr_pickup FROM trips WHERE tr_row < 1500 EXCEPT SELECT tr_dropoff FROM trips WHERE tr_row >= 1000) AS u GROUP BY tr_pickup % 4
----
INTEGER	BIGINT
1	1
2	1
3	1

