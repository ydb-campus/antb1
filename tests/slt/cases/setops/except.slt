# EXCEPT [DISTINCT] and EXCEPT ALL (ADR 0039's X4d): each distinct row of the left operand that the right one lacks,
# and max(m - n, 0) copies of a row held m and n times; rows compared as GROUP BY keys (NULL equals NULL). EXCEPT
# shares UNION's level and associates to the left; INTERSECT binds tighter; a run of EXCEPT types as DuckDB's binary
# nodes. Divergences D29 and D30 at the end.

# ---- the inputs ----

query III nosort
SELECT COUNT(*), COUNT(DISTINCT zn_city), COUNT(zn_parent) FROM zones
----
BIGINT	BIGINT	BIGINT
40	6	35

# ---- rows ----

query I rowsort
SELECT ct_id FROM cities EXCEPT SELECT zn_city FROM zones
----
SMALLINT
6

query I rowsort
SELECT zn_city FROM zones EXCEPT DISTINCT SELECT ct_id FROM cities WHERE ct_id < 4
----
SMALLINT
4
5
9
NULL

query II rowsort
SELECT zn_city, zn_parent FROM zones EXCEPT SELECT zn_city, zn_parent FROM zones WHERE zn_id > 10
----
SMALLINT	INTEGER
1	NULL
2	NULL
3	NULL
4	NULL
5	NULL

# NULL equals NULL.
query I rowsort
SELECT zn_parent FROM zones EXCEPT SELECT zn_parent FROM zones WHERE zn_parent IS NULL OR zn_parent > 3
----
INTEGER
1
2
3

# An empty right operand still removes the left one's duplicates; an empty left operand leaves nothing.
query I rowsort
SELECT zn_city FROM zones EXCEPT SELECT ct_id FROM cities WHERE ct_id < 0
----
SMALLINT
1
2
3
4
5
9
NULL

query I rowsort
SELECT zn_city FROM zones WHERE zn_id < 0 EXCEPT SELECT ct_id FROM cities
----
SMALLINT

