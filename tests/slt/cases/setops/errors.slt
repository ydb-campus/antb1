# UNION ALL's errors and what is not answered yet (ADR 0036, ADR 0039): column counts that differ are a bind error in
# both engines; INTERSECT and EXCEPT (X4c, X4d) and BY NAME (X4), a compound's own ORDER BY, LIMIT and
# OFFSET at any depth (X5) and a subquery over a UNION ALL (X6) wait on their roadmap items; values with no exact
# common type stay DuckDB's; the errors of the blocks a condition rules out (X7a); and divergences D26 and D27.

# ---- the input ----

query II nosort
SELECT COUNT(*), MAX(ct_id) FROM cities
----
BIGINT	SMALLINT
6	6

# ---- bind errors in both engines: column counts ----

statement error Set operations can only apply to expressions with the same number of result columns
SELECT ct_id FROM cities UNION ALL SELECT ct_id, label FROM cities

statement error Set operations can only apply to expressions with the same number of result columns
SELECT x FROM (SELECT ct_id AS x FROM cities UNION ALL SELECT ct_id FROM cities UNION ALL SELECT ct_id, ct_pop FROM cities) AS u

# Every block binds before the counts are compared.
statement error nope
SELECT ct_id FROM cities UNION ALL SELECT ct_id, label FROM cities UNION ALL SELECT nope FROM cities

# A block does not see another block's names.
statement error zn_id
SELECT ct_id FROM cities UNION ALL SELECT zn_id FROM cities

# ---- the other set operations (ADR 0039's X4c and X4d, UNION answered in union.slt; BY NAME stays ADR 0036's X4) ----

pending X4c
query I rowsort
SELECT ct_id FROM cities INTERSECT SELECT zn_city FROM zones
----
SMALLINT
1
2
3
4
5

pending X4d
query I rowsort
SELECT ct_id FROM cities EXCEPT SELECT zn_city FROM zones
----
SMALLINT
6

pending X4
query I rowsort
SELECT ct_id AS x FROM cities UNION ALL BY NAME SELECT zn_city AS x FROM zones WHERE zn_id < 3
----
SMALLINT
1
1
2
2
3
4
5
6

# A parenthesized branch, which ADR 0039's X4a answers for UNION ALL (more in union_all.slt).
query I rowsort
SELECT ct_id FROM cities UNION ALL (SELECT zn_city FROM zones WHERE zn_id < 3)
----
SMALLINT
1
1
2
2
3
4
5
6

# ---- a UNION ALL's own ORDER BY, LIMIT and OFFSET (ADR 0036's X5) ----

pending X5
query I nosort
SELECT ct_id FROM cities UNION ALL SELECT zn_city FROM zones ORDER BY 1 DESC LIMIT 3
----
SMALLINT
9
6
5

pending X5
query I nosort
SELECT COUNT(*) FROM (SELECT ct_id FROM cities UNION ALL SELECT zn_city FROM zones LIMIT 10) AS u
----
BIGINT
10

pending X5
query I nosort
SELECT COUNT(*) FROM (SELECT ct_id FROM cities UNION ALL SELECT zn_city FROM zones OFFSET 40) AS u
----
BIGINT
6

# A parenthesized compound's own tail is X5's too (ADR 0039's X4a update), and so is a second tail after a
# parenthesized query that has its own, which would need a compound of one branch; DuckDB answers both.

pending X5
query I rowsort
SELECT ct_id FROM cities UNION ALL (SELECT zn_city FROM zones UNION ALL SELECT zn_id FROM zones ORDER BY 1 LIMIT 2)
----
INTEGER
1
1
1
2
3
4
5
6

pending X5
query I nosort
SELECT COUNT(*) FROM ((SELECT ct_id FROM cities LIMIT 4) ORDER BY 1) AS u
----
BIGINT
4

pending X5
query I rowsort
SELECT ct_id FROM cities UNION ALL ((SELECT zn_id FROM zones ORDER BY zn_id OFFSET 1) LIMIT 2)
----
INTEGER
1
2
2
3
3
4
5
6

# ---- a subquery over a UNION ALL (ADR 0036's X6) ----

pending X6
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_pickup IN (SELECT zn_id FROM zones WHERE zn_id < 3 UNION ALL SELECT ct_id FROM cities)
----
BIGINT
420

pending X6
query I nosort
SELECT COUNT(*) FROM cities AS c WHERE EXISTS (SELECT * FROM zones AS z WHERE z.zn_city = c.ct_id UNION ALL SELECT * FROM zones AS z WHERE z.zn_id = c.ct_id)
----
BIGINT
6

pending X6
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_row > (SELECT MAX(ct_pop) FROM cities UNION ALL SELECT zn_id FROM zones WHERE zn_id < 0)
----
BIGINT
0

# ---- DuckDB only, for good: values with no exact common type (ADR 0036) ----
# DuckDB casts every type mix, a cast that fails failing per row; antb1 casts only exact widenings and exits 4.

onlyif duckdb
query T rowsort
SELECT ct_id FROM cities WHERE ct_id < 3 UNION ALL SELECT label FROM cities WHERE ct_id < 3
----
VARCHAR
1
2
center
harbor

onlyif duckdb
query T rowsort
SELECT tr_day FROM trips WHERE tr_row < 2 UNION ALL SELECT '2020-01-01' FROM cities WHERE ct_id = 1
----
VARCHAR
2020-01-01
2026-03-01
2026-03-02

