# A NULL item is the fold's identity.
query I rowsort
SELECT NULL FROM cities WHERE ct_id < 3 UNION SELECT ct_id FROM cities WHERE ct_id < 3
----
SMALLINT
1
2
NULL

# ---- errors ----

statement error Set operations can only apply to expressions with the same number of result columns
SELECT ct_id FROM cities UNION SELECT ct_id, label FROM cities

# A run of UNION binds every leaf before it compares the counts.
statement error nope
SELECT ct_id FROM cities UNION SELECT ct_id, label FROM cities UNION SELECT nope FROM cities

# A UNION next to a UNION ALL is a binary node: its counts are compared before the next leaf binds.
statement error Set operations can only apply to expressions with the same number of result columns
SELECT ct_id FROM cities UNION SELECT ct_id, label FROM cities UNION ALL SELECT nope FROM cities

# ---- divergence D29: which of -0.0 and 0.0 a UNION keeps ----
# Over an empty block, a block of 0.0 and one of -0.0 (d * 0 of a positive and a negative d): antb1 keeps the value
# first seen in written order, 0.0; DuckDB, at one thread, reads the first block and then the others from the last
# back, and keeps -0.0.

onlyif antb1
query R rowsort
SELECT d FROM edge WHERE i16 = 2 UNION SELECT d * 0 FROM edge WHERE i16 = 1 UNION SELECT d * 0 FROM edge WHERE i16 = 7
----
DOUBLE
0

onlyif duckdb
query R rowsort
SELECT d FROM edge WHERE i16 = 2 UNION SELECT d * 0 FROM edge WHERE i16 = 1 UNION SELECT d * 0 FROM edge WHERE i16 = 7
----
DOUBLE
-0

# ---- divergence D30: which error a UNION reports when several blocks fail ----
# antb1 reports the first failing block in written order, the addition; DuckDB, under its deduplication, reads the
# first block and then the others from the last back, and reports the multiplication.

onlyif antb1
statement error Overflow in addition
SELECT COUNT(*) FROM (SELECT i16 FROM edge UNION SELECT i16 + 1 FROM edge UNION SELECT i16 * 2 FROM edge) AS u

onlyif duckdb
statement error Overflow in multiplication
SELECT COUNT(*) FROM (SELECT i16 FROM edge UNION SELECT i16 + 1 FROM edge UNION SELECT i16 * 2 FROM edge) AS u

# ---- divergence D27: a condition above a UNION stays above it ----
# antb1 runs every block in full, so the second block's overflow fails the query although the condition keeps only the
# first block's rows; DuckDB pushes the condition into each block and rules the second one out.

onlyif antb1
statement error Overflow
SELECT MAX(x) FROM (SELECT ct_id AS x, 'a' AS tag FROM cities UNION SELECT ct_id + 9223372036854775807, 'b' FROM cities) AS u WHERE tag = 'a'

onlyif duckdb
query I nosort
SELECT MAX(x) FROM (SELECT ct_id AS x, 'a' AS tag FROM cities UNION SELECT ct_id + 9223372036854775807, 'b' FROM cities) AS u WHERE tag = 'a'
----
BIGINT
6
