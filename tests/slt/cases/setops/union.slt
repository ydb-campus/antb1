# UNION [DISTINCT] (ADR 0039's X4b): each distinct row of the operands, rows compared as GROUP BY keys (NULL equals
# NULL), alone or next to UNION ALL in any nesting. The names are the first leaf's; each column's type folds along
# DuckDB's tree: a run of UNION, or of UNION ALL, as one list in written order, a run next to the other as a binary
# node. Divergences D27, D29 and D30 at the end.

# ---- the inputs ----

query II nosort
SELECT COUNT(*), COUNT(DISTINCT zn_city) FROM zones
----
BIGINT	BIGINT
40	6

# ---- rows: duplicates within and across the operands, NULLs ----

query I rowsort
SELECT zn_city FROM zones UNION SELECT ct_id FROM cities
----
SMALLINT
1
2
3
4
5
6
9
NULL

query I rowsort
SELECT zn_city FROM zones UNION DISTINCT SELECT zn_city FROM zones
----
SMALLINT
1
2
3
4
5
9
NULL

query II rowsort
SELECT zn_city, zn_parent FROM zones WHERE zn_id < 12 UNION SELECT zn_city, zn_parent FROM zones WHERE zn_id > 30
----
SMALLINT	INTEGER
1	1
1	NULL
2	2
2	NULL
3	3
3	NULL
4	4
4	NULL
5	5
5	77
5	NULL
9	4
NULL	3

query I rowsort
SELECT zn_parent FROM zones WHERE zn_parent IS NULL UNION SELECT zn_parent FROM zones WHERE zn_parent IS NULL
----
INTEGER
NULL

query IT rowsort
SELECT ct_id, label FROM cities UNION SELECT ct_id, label FROM cities WHERE ct_id < 3 UNION SELECT ct_id + 10, label FROM cities WHERE ct_id > 4
----
SMALLINT	VARCHAR
1	center
15	old town
16	outskirts
2	harbor
3	hills
4	airport
5	old town
6	outskirts

# An empty operand still removes the other's duplicates.
query I rowsort
SELECT zn_city FROM zones UNION SELECT ct_id FROM cities WHERE ct_id < 0
----
SMALLINT
1
2
3
4
5
9
NULL

# ---- next to UNION ALL: one node per run of UNION, a UnionAll per run of UNION ALL ----

query I rowsort
SELECT zn_city FROM zones UNION SELECT ct_id FROM cities UNION ALL SELECT ct_id FROM cities WHERE ct_id < 3
----
SMALLINT
1
1
2
2
3
4
5
6
9
NULL

query I rowsort
SELECT ct_id FROM cities WHERE ct_id < 3 UNION ALL SELECT ct_id FROM cities WHERE ct_id < 3 UNION SELECT zn_city FROM zones
----
SMALLINT
1
2
3
4
5
9
NULL

