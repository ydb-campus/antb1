# A parenthesized run of UNION is spliced into the run around it.
query I rowsort
SELECT ct_id FROM cities WHERE ct_id < 2 UNION (SELECT zn_city FROM zones UNION SELECT ct_id FROM cities) UNION SELECT 7 FROM cities
----
INTEGER
1
2
3
4
5
6
7
9
NULL

# A parenthesized branch with its own WITH list or tail is a leaf.
query I rowsort
SELECT ct_id FROM cities UNION (WITH z AS (SELECT zn_city FROM zones) SELECT zn_city FROM z)
----
SMALLINT
1
2
3
4
5
6
9
NULL

query I rowsort
SELECT ct_id FROM cities WHERE ct_id > 4 UNION (SELECT zn_id FROM zones ORDER BY zn_id LIMIT 3)
----
INTEGER
1
2
3
5
6

# ---- where a compound stands: a derived table, a CTE, below GROUP BY and a join ----

query I nosort
SELECT COUNT(*) FROM (SELECT zn_city FROM zones UNION SELECT ct_id FROM cities) AS u
----
BIGINT
8

query II rowsort
WITH u AS (SELECT zn_city AS c FROM zones UNION SELECT ct_id FROM cities) SELECT c, COUNT(*) FROM u GROUP BY c
----
SMALLINT	BIGINT
1	1
2	1
3	1
4	1
5	1
6	1
9	1
NULL	1

query IT rowsort
SELECT u.c, ct.label FROM (SELECT zn_city AS c FROM zones WHERE zn_id < 6 UNION SELECT ct_id FROM cities WHERE ct_id > 5) AS u JOIN cities AS ct ON u.c = ct.ct_id
----
SMALLINT	VARCHAR
1	center
2	harbor
3	hills
4	airport
5	old town
6	outskirts

query II rowsort
SELECT tr_pickup % 3, COUNT(*) FROM (SELECT tr_pickup FROM trips WHERE tr_row < 500 UNION SELECT tr_dropoff FROM trips WHERE tr_row < 500) AS u GROUP BY tr_pickup % 3
----
INTEGER	BIGINT
0	14
1	15
2	14
NULL	1

query I nosort
WITH u AS (SELECT ct_id AS c FROM cities UNION SELECT zn_city FROM zones) SELECT COUNT(*) FROM u AS a JOIN u AS b ON a.c = b.c
----
BIGINT
7

