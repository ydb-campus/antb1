# A WITH list before the first block is every block's.
query I rowsort
WITH c AS (SELECT ct_id AS x FROM cities WHERE ct_id <= 2) SELECT x FROM c UNION ALL SELECT x + 10 FROM c
----
SMALLINT
1
11
12
2

# A CTE whose query is a UNION ALL, referenced twice and three times.
query II nosort
WITH u AS (SELECT ct_id AS x FROM cities UNION ALL SELECT zn_city FROM zones) SELECT COUNT(*), SUM(a.x) FROM u AS a JOIN u AS b ON a.x = b.x
----
BIGINT	HUGEINT
373	1111

query I nosort
WITH u AS (SELECT ct_id AS x FROM cities UNION ALL SELECT ct_id FROM cities WHERE ct_id < 3) SELECT COUNT(*) FROM u AS a, u AS b, u AS c WHERE a.x = b.x AND b.x = c.x
----
BIGINT
20

