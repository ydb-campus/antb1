----
BIGINT	HUGEINT
188	281980

query II nosort
SELECT COUNT(*), COUNT(u.z) FROM zones AS z LEFT JOIN (SELECT zn_id AS z FROM zones WHERE zn_id <= 3 UNION ALL SELECT zn_id FROM zones WHERE zn_id = 3) AS u ON z.zn_id = u.z
----
BIGINT	BIGINT
41	4

# A UNION ALL in the FROM list of a subquery: answered, as any derived table there.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_pickup IN (SELECT z FROM (SELECT zn_id AS z FROM zones WHERE zn_id <= 3 UNION ALL SELECT ct_id FROM cities) AS u)
