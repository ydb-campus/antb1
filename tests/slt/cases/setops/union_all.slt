# UNION ALL (ADR 0036): two or more blocks as the whole statement, a derived table's query or a CTE's query, over the
# star schema and the type tables. Every row of each block in written order, duplicates and NULLs kept; the names are
# the first block's; each column's type is a left fold over the blocks' types in written order.

# ---- the inputs, one table at a time ----

query II nosort
SELECT COUNT(*), MAX(ct_id) FROM cities
----
BIGINT	SMALLINT
6	6

query III nosort
SELECT COUNT(*), COUNT(zn_parent), MAX(zn_id) FROM zones
----
BIGINT	BIGINT	INTEGER
40	35	40

# ---- placements: the whole statement, a derived table, a CTE ----

query I rowsort
SELECT ct_id FROM cities UNION ALL SELECT ct_id FROM cities WHERE ct_id > 4
