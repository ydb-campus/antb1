# A UNION ALL as a join's build side and as its probe side.
query II nosort
SELECT COUNT(*), SUM(t.tr_row) FROM trips AS t JOIN (SELECT zn_id AS z FROM zones WHERE zn_id <= 5 UNION ALL SELECT zn_id FROM zones WHERE zn_id = 7) AS u ON t.tr_pickup = u.z
----
BIGINT	HUGEINT
420	624190

query II nosort
