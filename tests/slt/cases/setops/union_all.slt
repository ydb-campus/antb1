query II nosort union_cte
WITH u AS (SELECT ct_id AS x FROM cities UNION ALL SELECT zn_city FROM zones) SELECT COUNT(*), SUM(x) FROM u
----
46	143

query II nosort union_cte
SELECT COUNT(*), SUM(x) FROM (SELECT ct_id AS x FROM cities UNION ALL SELECT zn_city FROM zones) AS u
----
46	143

# A WITH list before the first block is every block's.
query I rowsort
WITH c AS (SELECT ct_id AS x FROM cities WHERE ct_id <= 2) SELECT x FROM c UNION ALL SELECT x + 10 FROM c
----
1
11
12
2

# A CTE whose query is a UNION ALL, referenced twice and three times.
query II nosort
WITH u AS (SELECT ct_id AS x FROM cities UNION ALL SELECT zn_city FROM zones) SELECT COUNT(*), SUM(a.x) FROM u AS a JOIN u AS b ON a.x = b.x
----
373	1111

query I nosort
WITH u AS (SELECT ct_id AS x FROM cities UNION ALL SELECT ct_id FROM cities WHERE ct_id < 3) SELECT COUNT(*) FROM u AS a, u AS b, u AS c WHERE a.x = b.x AND b.x = c.x
----
20

# ---- blocks: aggregates, GROUP BY and HAVING, joins, subqueries, nested unions ----

query II rowsort
SELECT tr_pickup, COUNT(*) FROM trips GROUP BY tr_pickup HAVING COUNT(*) > 74 UNION ALL SELECT zn_city, COUNT(*) FROM zones GROUP BY zn_city
----
1	8
2	8
3	7
4	7
5	8
9	1
NULL	1

query ID rowsort
SELECT COUNT(*), SUM(tr_fare) FROM trips UNION ALL SELECT COUNT(*), SUM(tr_rate) FROM trips WHERE tr_row < 1000
----
1000	1518.80
3000	44992.50

query IT rowsort
SELECT z.zn_id, c.label FROM zones AS z JOIN cities AS c ON z.zn_city = c.ct_id WHERE z.zn_id <= 3 UNION ALL SELECT ct_id, label FROM cities WHERE ct_id = 1
----
1	center
1	center
2	harbor
3	hills

query I rowsort
SELECT ct_id FROM cities AS c WHERE EXISTS (SELECT * FROM zones AS z WHERE z.zn_city = c.ct_id AND z.zn_id < 5) UNION ALL SELECT ct_id FROM cities WHERE ct_id = 6
----
1
2
3
4
6

query I rowsort
SELECT ct_id FROM cities WHERE ct_id IN (SELECT zn_city FROM zones WHERE zn_id < 9) UNION ALL SELECT dv_city FROM drivers WHERE dv_row < 3
----
1
1
2
2
3
3
4
5

query I nosort
SELECT COUNT(*) FROM (SELECT ct_id AS x FROM cities UNION ALL SELECT y FROM (SELECT zn_id AS y FROM zones UNION ALL SELECT dv_city FROM drivers) AS v) AS u
----
143

# Each block counts its own derived tables without an alias.
query I rowsort
SELECT unnamed_subquery.c FROM (SELECT ct_id AS c FROM cities) UNION ALL SELECT unnamed_subquery.z FROM (SELECT zn_id AS z FROM zones WHERE zn_id < 3)
----
1
1
2
2
3
4
5
6

# ---- what reads a UNION ALL: SELECT *, alias lists, ORDER BY with LIMIT, COUNT(DISTINCT), joins ----

query IT rowsort
SELECT * FROM (SELECT ct_id, label FROM cities UNION ALL SELECT zn_city, label FROM zones WHERE zn_id = 1) AS u
----
1	center
1	center
2	harbor
3	hills
4	airport
5	old town
6	outskirts

query II rowsort
SELECT a, b FROM (SELECT ct_id, ct_pop FROM cities UNION ALL SELECT zn_city, zn_id FROM zones WHERE zn_id < 3) AS u(a, b)
----
1	1
1	120000
2	2
2	45000
3	30000
4	NULL
5	8000
6	2500

query II nosort
SELECT x, y FROM (SELECT ct_id AS x, ct_pop AS y FROM cities UNION ALL SELECT zn_city, zn_id FROM zones) AS u ORDER BY y DESC, x LIMIT 5 OFFSET 1
----
2	45000
3	30000
5	8000
6	2500
5	40

query II nosort
SELECT COUNT(DISTINCT x), COUNT(*) FROM (SELECT tr_pickup AS x FROM trips UNION ALL SELECT zn_id FROM zones) AS u
----
43	3040

# A UNION ALL as a join's build side and as its probe side.
query II nosort
SELECT COUNT(*), SUM(t.tr_row) FROM trips AS t JOIN (SELECT zn_id AS z FROM zones WHERE zn_id <= 5 UNION ALL SELECT zn_id FROM zones WHERE zn_id = 7) AS u ON t.tr_pickup = u.z
----
420	624190

query II nosort
SELECT COUNT(*), SUM(u.r) FROM (SELECT tr_row AS r, tr_pickup AS p FROM trips WHERE tr_row < 500 UNION ALL SELECT tr_row, tr_dropoff FROM trips WHERE tr_row >= 2500) AS u JOIN zones AS z ON u.p = z.zn_id WHERE z.zn_city = 2
----
188	281980

query II nosort
SELECT COUNT(*), COUNT(u.z) FROM zones AS z LEFT JOIN (SELECT zn_id AS z FROM zones WHERE zn_id <= 3 UNION ALL SELECT zn_id FROM zones WHERE zn_id = 3) AS u ON z.zn_id = u.z
----
41	4

# A UNION ALL in the FROM list of a subquery: answered, as any derived table there.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_pickup IN (SELECT z FROM (SELECT zn_id AS z FROM zones WHERE zn_id <= 3 UNION ALL SELECT ct_id FROM cities) AS u)
----
420

query I nosort
SELECT COUNT(*) FROM cities AS c WHERE EXISTS (SELECT * FROM (SELECT zn_city AS k FROM zones UNION ALL SELECT dv_city FROM drivers) AS u WHERE u.k = c.ct_id)
----
5

query I nosort
SELECT COUNT(*) FROM trips WHERE tr_row > (SELECT MAX(x) FROM (SELECT ct_id * 400 AS x FROM cities UNION ALL SELECT zn_id * 70 FROM zones) AS u)
----
199


# ---- NULLs, empty blocks, several row groups ----

query II nosort
SELECT COUNT(*), COUNT(x) FROM (SELECT tr_promo AS x FROM trips UNION ALL SELECT zn_parent FROM zones) AS u
----
3040	95

query II nosort
SELECT COUNT(*), SUM(x) FROM (SELECT tr_row AS x FROM trips WHERE tr_row < 0 UNION ALL SELECT ct_pop FROM cities) AS u
----
6	205500

query II nosort
SELECT COUNT(*), SUM(x) FROM (SELECT RegionID AS x FROM hits_like_split WHERE IsMobile = 1 UNION ALL SELECT RegionID FROM hits_like WHERE IsMobile = 0) AS u
----
10000	97210255

