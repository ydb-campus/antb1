# A select alias comes before a table column of the same name; with two items of one alias, the last.

query II nosort
SELECT id AS i16, i16 AS id FROM edge ORDER BY i16 DESC
----
11	7
10	-12345
9	12345
8	NULL
7	-100
6	100
5	NULL
4	1
3	-1
2	0
1	32767
0	-32768

query II nosort
SELECT i16 AS x, id AS x FROM edge ORDER BY x
----
-32768	0
32767	1
0	2
-1	3
1	4
NULL	5
100	6
-100	7
NULL	8
12345	9
-12345	10
7	11

query II nosort
