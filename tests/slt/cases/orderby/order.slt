# ORDER BY (docs/sql-subset.md): ASC by default, NULLS LAST by default in both directions, VARCHAR by
# bytes. Rows with equal keys come in no particular order, so every multi-row query here orders by a
# unique column last.

query II nosort
SELECT id, i16 FROM edge ORDER BY i16, id
----
0	-32768
10	-12345
7	-100
3	-1
2	0
4	1
11	7
6	100
9	12345
1	32767
5	NULL
8	NULL

query II nosort
SELECT id, i16 FROM edge ORDER BY i16 DESC, id
----
1	32767
9	12345
6	100
11	7
4	1
2	0
3	-1
7	-100
10	-12345
0	-32768
5	NULL
8	NULL

query II nosort
SELECT id, i16 FROM edge ORDER BY i16 NULLS FIRST, id DESC
----
