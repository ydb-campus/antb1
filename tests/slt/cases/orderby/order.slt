# SELECT *, WHERE, and a table read from several files.

query IIIIIRTT nosort
SELECT * FROM edge WHERE id > 2 ORDER BY i64 DESC, id
----
6	100	100000	1000000000000000	15917	123456789.125	\x20leading space	trailing space\x20
9	12345	NULL	42	NULL	NULL	\x4eULL	\x28empty)
11	7	-7	7	7	-0.3333333333333333	naïve café	NULL
4	1	1	1	15887	0.1	back\\slash	back\\slash
3	-1	-1	-1	32768	0.6666666666666666	line\nbreak	line\nbreak
10	-12345	54321	-42	12	922337203685477632	NULL	日本語
7	-100	-100000	-1000000000000000	40000	-9007199254740992	x\x01y	x\x7fy
5	NULL	NULL	NULL	NULL	NULL	NULL	NULL
8	NULL	7	NULL	2	9.99999993e-10	Привет, мир	Привет, мир

