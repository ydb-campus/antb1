query IT nosort
SELECT id, s FROM edge ORDER BY s, id
----
0	(empty)
6	\x20leading space
9	\x4eULL
1	a
4	back\\slash
3	line\nbreak
11	naïve café
2	tab\there
7	x\x01y
8	Привет, мир
5	NULL
10	NULL

query IT nosort
SELECT id, u FROM edge ORDER BY u DESC, id
----
10	日本語
8	Привет, мир
7	x\x7fy
6	trailing space\x20
2	tab\there
3	line\nbreak
4	back\\slash
1	a
9	\x28empty)
0	(empty)
5	NULL
11	NULL

