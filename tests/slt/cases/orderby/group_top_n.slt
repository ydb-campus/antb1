# ORDER BY ... LIMIT over a GROUP BY: each partition of the aggregation keeps only its first rows
# in the top-N's order, and the top-N picks from those (docs/adr/0011-sorting-and-top-n.md). The
# rows are those of sorting every group.

query II nosort
SELECT UserID, COUNT(*) AS c FROM hits_like_split GROUP BY UserID ORDER BY c DESC, UserID LIMIT 5
----
9223372036854775807	2
-9223372036854775808	1
386056098584291	1
806893882316698	1
3139869338429733	1

query II nosort
SELECT UserID, COUNT(*) AS c FROM hits_like_split GROUP BY UserID ORDER BY c DESC, UserID LIMIT 4 OFFSET 3000
----
1352933567315323775	1
1353141830839239171	1
1353323344675940665	1
1354087595029117100	1

query ITI nosort
SELECT RegionID, MIN(URL), COUNT(*) AS c FROM hits_like_nulls GROUP BY RegionID ORDER BY c DESC, RegionID NULLS FIRST LIMIT 6
----
NULL	(empty)	785
0	(empty)	276
8830	(empty)	6
7430	https://www.example.org/naïve/83807	5
306	https://www.example.org/cloud/70023	4
2493	https://www.example.org/green/3416?q=alpha	4

query III nosort
SELECT CounterID, RegionID, SUM(ResolutionWidth) AS w FROM hits_like_split GROUP BY CounterID, RegionID ORDER BY w DESC, CounterID, RegionID LIMIT 5 OFFSET 2
----
15062	0	17932
4062	0	16248
28062	0	15350
35062	0	15094
37062	0	14796

query TI nosort
SELECT SearchPhrase, COUNT(*) AS c FROM hits_like_split WHERE SearchPhrase <> '' GROUP BY SearchPhrase ORDER BY c, SearchPhrase DESC LIMIT 3
----
погода погода погода	1
погода погода новости	1
погода погода	1

