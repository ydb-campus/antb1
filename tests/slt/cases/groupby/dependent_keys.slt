# GROUP BY keys computed from other keys (docs/adr/0018-dependent-group-keys.md): the plan groups
# by the determining keys and computes the others once per group. The groups, their values and
# the errors are those of grouping by every key.

# Several keys of one integer key, with NULLs (NULL keys give NULL expressions).
query IIIII nosort
SELECT RegionID, RegionID - 1, RegionID * 2, RegionID % 7, COUNT(*) AS c FROM hits_like_nulls GROUP BY RegionID, RegionID - 1, RegionID * 2, RegionID % 7 ORDER BY c DESC, RegionID NULLS FIRST LIMIT 6
----
NULL	NULL	NULL	NULL	785
0	-1	0	0	276
8830	8829	17660	3	6
7430	7429	14860	3	5
306	305	612	5	4
2493	2492	4986	1	4

# A VARCHAR key and a function of it.
query TII nosort
SELECT URL, strlen(URL), COUNT(*) AS c FROM hits_like_nulls GROUP BY URL, strlen(URL) ORDER BY c DESC, URL NULLS FIRST LIMIT 5
----
NULL	NULL	775
(empty)	0	186
https://www.example.org/beta/23449	34	2
https://www.example.org/beta/23721	34	2
https://www.example.org/beta/31881	34	2

# The determining key after another key; ORDER BY the dependent key.
query IIII nosort
SELECT CounterID, RegionID + 10, RegionID, SUM(ResolutionWidth) AS w FROM hits_like GROUP BY CounterID, RegionID, RegionID + 10 ORDER BY RegionID + 10 DESC, CounterID LIMIT 5
----
18062	20008	19998	1920
5062	20007	19997	1440
39062	20007	19997	0
30062	20004	19994	2560
28062	20003	19993	1024

# HAVING on the dependent key.
query III nosort
SELECT RegionID, RegionID % 5, COUNT(*) AS c FROM hits_like GROUP BY RegionID, RegionID % 5 HAVING RegionID % 5 = 3 ORDER BY c DESC, RegionID LIMIT 5
----
2493	3	4
19043	3	4
728	3	3
3053	3	3
3233	3	3

# Only the dependent key in the select list.
query II nosort
SELECT UserID // 1000, COUNT(*) AS c FROM hits_like GROUP BY UserID, UserID // 1000 ORDER BY c DESC, UserID // 1000 LIMIT 5
----
9223372036854775	2
-9223372036854775	1
386056098584	1
806893882316	1
3139869338429	1

# With COUNT(DISTINCT) (the two-level aggregation).
query IIII nosort
SELECT OS, OS * 3, COUNT(DISTINCT UserID) AS u, COUNT(*) FROM hits_like GROUP BY OS, OS * 3 ORDER BY u DESC, OS LIMIT 5
----
10	30	107	107
116	348	104	104
118	354	103	103
73	219	102	102
26	78	100	100

# Parallel parts.
query IIII nosort
SELECT RegionID, RegionID * 3, RegionID + 7, COUNT(*) AS c FROM hits_like_split GROUP BY RegionID, RegionID * 3, RegionID + 7 ORDER BY c DESC, RegionID LIMIT 5
----
0	0	7	304
8830	26490	8837	6
7430	22290	7437	5
306	918	313	4
2493	7479	2500	4

# A function of a DOUBLE key stays a key (a DOUBLE key groups -0.0 with 0.0, which 1 / d tells
# apart); the groups are the same.
query RRI rowsort
SELECT d, 1 / d, COUNT(*) FROM edge GROUP BY d, 1 / d
----
-0.3333333333333333	-3	1
-0.5	-2	1
-9007199254740992	-1.1102230246251565e-16	1
0	inf	1
0.1	10	1
0.3333333333333333	3	1
0.6666666666666666	1.5	1
123456789.125	8.10000006550875e-09	1
9.99999993e-10	1000000007	1
922337203685477632	1.0842021724855044e-18	1
NULL	NULL	2

# An overflow in a dependent key is an error, as when every key is hashed.
statement error
SELECT i32, i32 + 1, COUNT(*) FROM edge GROUP BY i32, i32 + 1

# The same under a LIMIT without ORDER BY: every group's keys are still computed.
statement error
SELECT i32, i32 + 1, COUNT(*) FROM edge GROUP BY i32, i32 + 1 LIMIT 1

# ORDER BY ... LIMIT reads every group before the Limit: still an error.
statement error
SELECT i32, i32 + 1, COUNT(*) AS c FROM edge GROUP BY i32, i32 + 1 ORDER BY c LIMIT 1
