# Repeated keys are one key.
query II rowsort
SELECT OS, COUNT(*) FROM hits_like WHERE OS < 5 GROUP BY OS, os, "OS"
----
0	82
1	82
2	97
3	93
4	71

# No rows: no groups.
query II rowsort
SELECT AdvEngineID, COUNT(*) FROM hits_like WHERE AdvEngineID > 1000 GROUP BY AdvEngineID
----

query II rowsort
SELECT AdvEngineID, COUNT(*) FROM empty GROUP BY AdvEngineID
----

