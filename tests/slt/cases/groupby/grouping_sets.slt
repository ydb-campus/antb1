# HAVING, ORDER BY with NULLs first and a LIMIT over the ROLLUP's rows; a key by alias and by position.
query ITD nosort
SELECT tr_driver % 4 AS dv, tr_tariff, SUM(tr_fare) FROM trips GROUP BY ROLLUP (dv, 2) HAVING COUNT(*) > 10 ORDER BY 1 NULLS FIRST, 2 NULLS FIRST, 3 LIMIT 12
