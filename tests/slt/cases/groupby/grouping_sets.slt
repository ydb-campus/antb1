# ROLLUP of three keys, one of them VARCHAR, with every exact aggregate: each set is its own GROUP BY, a key NULL
# in the sets without it (and NULL in the data too: GROUPING() tells them apart, RU4).
query TIIIIDT rowsort
SELECT cities.label, tr_driver % 2, tr_promo % 3, COUNT(*), COUNT(tr_promo), MIN(tr_fare), MAX(cities.label) FROM trips JOIN riders ON tr_rider = rd_id JOIN cities ON rd_city = ct_id GROUP BY ROLLUP (cities.label, tr_driver % 2, tr_promo % 3)
