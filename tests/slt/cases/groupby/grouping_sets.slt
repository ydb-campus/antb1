# Calls that do not merge exactly: each set is aggregated from the input.
query IIR rowsort
SELECT tr_pickup % 4, COUNT(DISTINCT tr_rider), SUM(tr_distance) FROM trips GROUP BY ROLLUP (tr_pickup % 4)
----
INTEGER	BIGINT	DOUBLE
0	241	6668.875
1	240	7350.5
2	241	7336.125
3	241	7301.625
NULL	243	28657.125

# Two ROLLUPs and a key: the cross product of their sets, the plain key in every set.
query TIII rowsort
SELECT tr_tariff, tr_promo % 2, tr_pickup % 3, COUNT(*) FROM trips GROUP BY tr_tariff, ROLLUP (tr_promo % 2), ROLLUP (tr_pickup % 3)
