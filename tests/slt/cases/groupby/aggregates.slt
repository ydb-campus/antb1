# Every aggregate per group: the same semantics as without GROUP BY (exact integer SUM and AVG, NULLs
# skipped, NULL over a group without values).

query IIIIRTT rowsort
SELECT OS, COUNT(*), COUNT(Title), SUM(ResolutionWidth), AVG(ResolutionWidth), MIN(EventDate), MAX(URL) FROM hits_like_nulls WHERE OS < 8 GROUP BY OS
----
