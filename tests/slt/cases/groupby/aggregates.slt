# A group whose argument values are all NULL.
query IIIIR rowsort
SELECT IsMobile, COUNT(SocialAction), SUM(HistoryLength), MIN(HistoryLength), AVG(HistoryLength) FROM hits_like_nulls GROUP BY IsMobile
----
0	0	NULL	NULL	NULL
1	0	NULL	NULL	NULL
NULL	0	NULL	NULL	NULL

# The aggregates of a grouped query are exactly those without GROUP BY, per group.
query IIIR rowsort
SELECT CounterID, SUM(UserID), COUNT(*), AVG(ClientIP) FROM hits_like_split WHERE CounterID < 100 GROUP BY CounterID
----
62	566968500224212501132	242	-41145722.13636363

