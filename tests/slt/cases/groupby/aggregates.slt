# SUM of BIGINT beyond int64 in a group, and AVG of extremes.
query IIIRII rowsort
SELECT i16, SUM(i64), COUNT(i64), AVG(i64), MIN(i64), MAX(i64) FROM edge GROUP BY i16
----
