# GROUP BY keys with nearly one group per row: a part whose first batch hardly reduces sends its
# other rows straight to the partitions (the parallel run reads in batches of 1000 rows). The
# groups are those of any other plan.

query II nosort
SELECT WatchID, COUNT(*) AS c FROM hits_like_split GROUP BY WatchID ORDER BY c DESC, WatchID LIMIT 5
----
-9223372036854775808	1
-9222731508449045939	1
-9221648886445140287	1
-9221484110054234133	1
-9219525906035539994	1

query IIIT nosort
SELECT UserID, COUNT(*) AS c, SUM(RegionID), MIN(URL) FROM hits_like_split GROUP BY UserID ORDER BY c DESC, UserID LIMIT 5
