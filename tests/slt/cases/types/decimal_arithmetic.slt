# Comparisons over computed DECIMALs fold the literal into the result's scale.

query I rowsort
SELECT id FROM decimals WHERE p * id > 1000
----
10
16
27
30
32
35
38

query I rowsort
SELECT id FROM decimals WHERE p + 1 > 20.995 AND id >= 14
----
16
21
27
30
32
35
38

query I nosort
SELECT COUNT(*) FROM decimals WHERE -p <= -59.97
----
10

query I nosort
SELECT COUNT(*) FROM decimals WHERE p - q < 0 OR d9_2 * 2 = 2.50
----
19

# SUM and AVG: over every row (the extremes cancel), over computed values, and over no rows.

query DDDDDD nosort
SELECT SUM(p), SUM(q), SUM(d9_2), SUM(d18_4), SUM(d38_10), SUM(d38_0) FROM decimals
----
-39.98	819.59	-10.00	99999999999990.9990	-5.0000000005	-500000000000000000000

query RRRR nosort
SELECT AVG(p), AVG(d9_2), AVG(d18_4), AVG(d38_10) FROM decimals
----
-1.249375	-0.29411764705882354	2857142857142.6	-0.14285714287142856

query DDR nosort
SELECT SUM(p * q), SUM(d9_2 + id), AVG(p - q) FROM decimals WHERE id >= 14
----
62337.6156	572.75	-19.99

query DR nosort
SELECT SUM(p), AVG(p) FROM decimals WHERE id > 100
----
NULL	NULL

query IDRD nosort
SELECT id % 4 AS g, SUM(p), AVG(q), SUM(d9_2 * 2) FROM decimals GROUP BY g ORDER BY g
----
0	-79.96	1000000000017.99	-10.00
1	-79.96	-1999999999952.022	19999997.48
2	10000000000099.94	25.987	-20000017.48
3	-9999999999980.00	13.993	10.00

query ID rowsort
SELECT id % 3, SUM(p) FROM decimals GROUP BY id % 3 HAVING SUM(p) > 0
----
1	9999999999860.06

query DD nosort
SELECT d9_2, SUM(q) AS s FROM decimals WHERE id >= 14 GROUP BY d9_2 ORDER BY s DESC, d9_2 NULLS FIRST LIMIT 5
----
6.25	219.89
5.00	179.91
NULL	159.92
2.50	119.94
3.75	99.95

query DD rowsort
SELECT d18_4, SUM(p) + MIN(p) FROM decimals WHERE id >= 14 GROUP BY d18_4 HAVING SUM(q) <= 59.97
----
-1.0001	-39.98
-2.0002	-119.94
-3.0003	-179.91
-4.0004	-239.88
-5.0005	-199.90
0.0000	0.00

# No integer-only rewrite: SUM(p + 1) adds 1 to every value, p + 1 > 2 computes p + 1 (rule 18).

query DI nosort
SELECT SUM(p + 1), COUNT(p) FROM decimals
----
-7.98	32

query I nosort
SELECT COUNT(*) FROM decimals WHERE p + 1 > 2
----
14

# Overflows past a capped width, and a rescaled operand that does not fit, fail with DuckDB's messages.

statement error Overflow in multiplication of DECIMAL\(18\)
SELECT d18_4 * d18_4 FROM decimals

statement error Overflow in addition of DECIMAL\(18\)
SELECT d18_4 + d18_4 FROM decimals

statement error Overflow in subtract of DECIMAL\(18\)
SELECT d18_4 - (-d18_4) FROM decimals

statement error Overflow in addition of DECIMAL\(38\)
SELECT d38_0 + d38_0 FROM decimals

statement error Overflow in multiplication of DECIMAL\(38\)
SELECT d38_0 * d38_0 FROM decimals

statement error Casting value "99999999999999999999999999999999999999" to type DECIMAL\(38,10\) failed: value is out of range!
SELECT d38_0 + d38_10 FROM decimals

statement error Needed scale 40 to accurately represent the multiplication result
SELECT d38_10 * d38_10 * d38_10 * d38_10 FROM decimals

# A SUM beyond 38 digits: antb1 fails, DuckDB returns 39 digits (a divergence, docs/sql-subset.md).

onlyif antb1
statement error SUM overflow: the result is outside the range of DECIMAL\(38,0\)
SELECT SUM(d38_0) FROM decimals WHERE id = 7 OR id = 8

onlyif duckdb
query D nosort
SELECT SUM(d38_0) FROM decimals WHERE id = 7 OR id = 8
----
100000000000000000099999999999999999999

# / and % of a DECIMAL and decimal literals in arithmetic (more in decimal_literals.slt).

