# Comparisons of a DECIMAL with other types (ADR 0021 rule 11, docs/sql-subset.md): with a DECIMAL of another
# precision or scale and with an integer exactly by value, with a DOUBLE operand, a number DuckDB types as DOUBLE or
# an IN list with one in DOUBLE, the DECIMAL converted as DuckDB converts it. decimals.parquet adds b BIGINT (its
# extremes and 2^53 + 1) and d DOUBLE to the DECIMAL columns; rows 12 and 13 hold pairs of values that are equal as
# doubles but not exactly.

# DECIMALs of other precisions and scales, and integers: exactly by value.

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 = p
----
3

query I rowsort
SELECT id FROM decimals WHERE p < d9_2 AND id >= 14
----
20
22
23
25
28
33
36

query I rowsort
SELECT id FROM decimals WHERE d18_4 >= p AND id >= 14
----
15
17
20
22
23
25
28
31
36
37

query I rowsort
SELECT id FROM decimals WHERE d38_10 <> d18_4 AND id >= 30
----
30
31
32
34
35
36
39

query I nosort
SELECT COUNT(*) FROM decimals WHERE p < id
----
18

query I rowsort
SELECT id FROM decimals WHERE d38_0 > b
----
10
13
16
19
2
21
27
32
38
7
8

query I rowsort
SELECT id FROM decimals WHERE d38_10 <= b AND id < 14
----
10
12
4
7
8

query I rowsort
SELECT id FROM decimals WHERE id >= d38_0 AND id >= 14
----
14
15
17
20
22
23
25
26
28
31
33
34
37
39

# Equal as doubles, not exactly: row 12's d38_10 (2^53 + 0.5) and b (2^53 + 1), row 13's d18_4 and d38_10.
query I rowsort
SELECT id FROM decimals WHERE d38_10 < b AND id IN (12, 13)
----
12

query I rowsort
SELECT id FROM decimals WHERE d38_10 > d18_4 AND id >= 12 AND id <= 13
----
13

# Beyond 2^53: b + 0.5 is DECIMAL(21,1), above b in every row; in DOUBLE 2^53 + 1.5 and 2^53 + 1 would be equal.
query I rowsort
SELECT id FROM decimals WHERE b + 0.5 > b AND (id < 4 OR id = 12)
----
0
1
12
2
3

# DECIMAL(21,1) and DECIMAL(22,2): exactly, so never equal; in DOUBLE rows 2, 3 and 12 would be.
query I nosort
SELECT COUNT(*) FROM decimals WHERE b + 0.5 = b + 0.25
----
0

# Against a DOUBLE operand: in DOUBLE.

query I rowsort
SELECT id FROM decimals WHERE d9_2 = d
----
7

# DuckDB converts 2^53 + 1.5 to 2^53 (its integer part first), the DOUBLE of b in row 12.
query I rowsort
SELECT id FROM decimals WHERE b + 0.5 = b * 1e0 AND (id < 4 OR id = 12)
----
12
2
3

# A comparison converts a DECIMAL as arithmetic does, beyond 2^53 and at width 38 too.
query I nosort
SELECT COUNT(*) FROM decimals WHERE d18_4 = d18_4 * 1e0 AND d38_10 <= d38_10 + 0e0
----
30

query I rowsort
SELECT id FROM decimals WHERE p > d AND id >= 30
----
30
32
35
37
38

query I rowsort
SELECT id FROM decimals WHERE d9_2 <= d AND id >= 14
----
14
15
18
21
25
28
33
36
39

query I rowsort
SELECT id FROM decimals WHERE p < id / 4 AND id >= 30
----
31
33
36
37

# Against a number DuckDB types as DOUBLE: an exponent, a decimal of more than 38 digits, an integer outside -2^127 to
# 2^128 - 1.

query I nosort
SELECT COUNT(*) FROM decimals WHERE p > 1e1
----
14

query I rowsort
SELECT id FROM decimals WHERE p = 1.999e1 OR p = -7.996e1
----
18
25
3
36
7

query I rowsort
SELECT id FROM decimals WHERE p >= 39.98000000000000000000000000000000000001 AND id >= 14
----
16
21
27
30
32
35
38

query I nosort
SELECT COUNT(*) FROM decimals WHERE d38_0 < 340282366920938463463374607431768211456
----
33

# 9999999999999999999999999999.9999999999 becomes 10^28 in DOUBLE.
query I rowsort
SELECT id FROM decimals WHERE d38_10 = 1e28
----
6

query I rowsort
SELECT id FROM decimals WHERE d38_10 < 1e28 AND id < 14
----
0
1
10
12
13
3
4
5
7
8
9

# IN lists: with such a number every value compares in DOUBLE, a HUGEINT literal through DuckDB's 128-bit formula.

query I rowsort
SELECT id FROM decimals WHERE p IN (59.97, 1e0, -19.99)
----
1
12
13
2
23
35

query I rowsort
SELECT id FROM decimals WHERE d38_10 NOT IN (5.0000000005, 1e28) AND id < 14
----
0
1
10
12
13
3
4
5
7
9

query I rowsort
SELECT id FROM decimals WHERE d38_0 IN (99999999999999999999999999999999999999, 2e20)
----
10
21
32
8

query I rowsort
SELECT id FROM decimals WHERE NOT (p IN (1e0)) AND id >= 30
----
30
31
32
33
35
36
37
38

# Inside CASE, OR and an aggregate.

query II rowsort
SELECT id, CASE WHEN p > 1e0 THEN 1 ELSE 0 END FROM decimals WHERE id >= 30
----
30	1
31	0
32	1
33	0
34	0
35	1
36	0
37	0
38	1
39	0

query IT rowsort
SELECT id, CASE p WHEN 1.999e1 THEN 'a' WHEN d9_2 THEN 'b' ELSE 'c' END FROM decimals WHERE id >= 30
----
30	c
31	c
32	c
33	c
34	c
35	c
36	c
37	b
38	c
39	c

query I rowsort
SELECT id FROM decimals WHERE p > q OR p IN (1e0, 59.97)
----
10
13
2
35

query I nosort
SELECT SUM(CASE WHEN p > d9_2 THEN 1 ELSE 0 END) FROM decimals
----
12

# HAVING: aggregates of different types.

query II rowsort
SELECT id % 4 AS g, COUNT(*) FROM decimals GROUP BY g HAVING SUM(p) > MAX(q) OR SUM(p) > AVG(d)
----
2	10

query II rowsort
SELECT id % 4 AS g, COUNT(*) FROM decimals GROUP BY g HAVING SUM(id) < MAX(d38_10)
----
0	10
1	10
2	10

# An integer SUM (HUGEINT) against a DOUBLE converts as DuckDB converts a HUGEINT: -2^53 - 2 becomes -2^53.
query I rowsort
SELECT id FROM decimals GROUP BY id HAVING SUM(b) - 9007199254740993 - 9007199254740994 > AVG(b) * 0 - 9007199254740994
----
12
2

# BETWEEN: pairwise where both pairs compare as DuckDB's one type does (exactly, or both in DOUBLE).

query I rowsort
SELECT id FROM decimals WHERE p BETWEEN d9_2 AND id AND id >= 14
----
15
26
37

query I rowsort
SELECT id FROM decimals WHERE d BETWEEN p AND q
----
12
20
23

query I rowsort
SELECT id FROM decimals WHERE p BETWEEN 1e0 AND 1e2
----
13
16
18
2
21
27
30
32
35
38
5
7
8

# Divergence D13: DuckDB compares d9_2 and d38_0 in DECIMAL(38,2), which cannot hold d38_0's extremes, and fails.

onlyif antb1
query I rowsort
SELECT id FROM decimals WHERE d9_2 < d38_0
----
13
16
19
2
21
27
29
32
35
5
7
8

onlyif duckdb
statement error out of range
SELECT id FROM decimals WHERE d9_2 < d38_0

# The sums of d are exact in any order, so the engines agree to the bit.
query DRR rowsort
SELECT d9_2, SUM(d), AVG(d) FROM decimals GROUP BY d9_2
----
-1.25	-7.5	-2.5
-2.50	-5	-2.5
-3.75	1.25	0.4166666666666667
-5.00	5.625	1.875
-6.25	-3.75	-1.25
-9999999.99	-0.625	-0.625
0.00	-3.75	-1.25
1.25	3.75	1.25
2.50	5	2.5
3.75	2.5	2.5
5.00	-5.625	-1.875
6.25	-1.875	-0.625
9999999.99	2.5	2.5
NULL	-4.375	-0.875
