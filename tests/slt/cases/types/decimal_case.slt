# DECIMAL CASE values and % beyond 38 digits (ADR 0021 rule 10, docs/sql-subset.md). DuckDB folds the values' types
# from the ELSE value through the THEN values in written order, so the type can depend on their order, and casts each
# value to it on the rows that take it: rounded half away from zero where the scale shrinks, an integer that does not
# fit failing with a conversion error. % beyond 38 digits is DOUBLE, NULL for a zero divisor.

# DECIMALs of one scale, and of several: the larger scale and the most integer digits.

query ID nosort
SELECT id, CASE WHEN id < 8 THEN p ELSE q END FROM decimals WHERE id < 16 ORDER BY id
----
0	-99.95
1	-19.99
2	59.97
3	-79.96
4	NULL
5	79.96
6	-59.97
7	19.99
8	139.93
9	NULL
10	59.97
11	-59.97
12	9999999999999.99
13	-9999999999999.99
14	-39.98
15	0.00

query ID nosort
SELECT id, CASE WHEN id % 3 = 0 THEN d9_2 WHEN id % 3 = 1 THEN d18_4 ELSE p END FROM decimals WHERE id < 16 ORDER BY id
----
0	-6.2500
1	-1.0001
2	59.9700
3	NULL
4	99999999999999.9999
5	79.9600
6	-3.7500
7	1.0001
8	99.9500
9	-2.5000
10	2.0002
11	-9999999999999.9900
12	-1.2500
13	12345678901234.5678
14	NULL
15	0.0000

# Beyond 38 digits d38_10 next to d38_0 is DECIMAL(38,0): its values round half away from zero, the extremes to a new
# digit (10^28).

query ID nosort
SELECT id, CASE WHEN id % 2 = 0 THEN d38_0 ELSE d38_10 END FROM decimals WHERE id < 16 ORDER BY id
----
0	NULL
1	-1
2	300000000000000000000
3	-4
4	0
5	4
6	NULL
7	-10000000000000000000000000000
8	99999999999999999999999999999999999999
9	-2
10	200000000000000000000
11	NULL
12	NULL
13	12345678901235
14	-400000000000000000000
15	0

query ID nosort
SELECT id, CASE WHEN id IN (6, 7, 8, 12, 13) THEN d38_10 ELSE d38_0 END FROM decimals WHERE id < 16 ORDER BY id
----
0	NULL
1	-100000000000000000000
2	300000000000000000000
3	-400000000000000000000
4	0
5	400000000000000000000
6	10000000000000000000000000000
7	-10000000000000000000000000000
8	5
9	-99999999999999999999999999999999999999
10	200000000000000000000
11	-500000000000000000000
12	9007199254740993
13	12345678901235
14	-400000000000000000000
15	0

# Integers keep the DECIMAL's scale: b next to d9_2 is DECIMAL(21,2), its extremes included; an integer literal counts by
# its own type next to a DECIMAL.

query ID nosort
SELECT id, CASE WHEN id < 4 THEN b ELSE d9_2 END FROM decimals WHERE id < 8 ORDER BY id
----
0	-15000000095.00
1	-3000000019.00
2	9223372036854775807.00
3	-9223372036854775808.00
4	0.00
5	5.00
6	-3.75
7	1.25

query ID nosort
SELECT id, CASE WHEN id < 4 THEN 7 WHEN id < 8 THEN d9_2 ELSE id END FROM decimals WHERE id < 12 ORDER BY id
----
0	7.00
1	7.00
2	7.00
3	7.00
4	0.00
5	5.00
6	-3.75
7	1.25
8	8.00
9	9.00
10	10.00
11	11.00

query ID nosort
SELECT id, CASE WHEN id < 4 THEN 2.5 WHEN id < 8 THEN -(7) ELSE 1.125 END FROM decimals WHERE id < 12 ORDER BY id
----
0	2.500
1	2.500
2	2.500
3	2.500
4	-7.000
5	-7.000
6	-7.000
7	-7.000
8	1.125
9	1.125
10	1.125
11	1.125

# The order of the values matters beyond 38 digits: with b folded before the decimal literal the CASE is DECIMAL(38,19);
# with the literal (30 decimals) first it is DECIMAL(38,30), which b's values do not fit.

query ID nosort
SELECT id, CASE WHEN id < 4 THEN d9_2 WHEN id < 8 THEN 0.000000000000000000000000000001 ELSE b END FROM decimals WHERE id < 12 ORDER BY id
----
0	-6.2500000000000000000
1	9999999.9900000000000000000
2	-9999999.9900000000000000000
3	NULL
4	0.0000000000000000000
5	0.0000000000000000000
6	0.0000000000000000000
7	0.0000000000000000000
8	15000000095.0000000000000000000
9	-6000000038.0000000000000000000
10	6000000038.0000000000000000000
11	NULL

statement error Could not cast value -?[0-9]+ to DECIMAL\(38,30\)
SELECT CASE WHEN id < 4 THEN b WHEN id < 8 THEN d9_2 ELSE 0.000000000000000000000000000001 END FROM decimals

# Only the rows that take a value cast it: row 4's b is 0 and row 5's NULL.

query ID nosort
SELECT id, CASE WHEN id IN (4, 5) THEN b ELSE 0.000000000000000000000000000001 END FROM decimals WHERE id < 8 ORDER BY id
----
0	0.000000000000000000000000000001
1	0.000000000000000000000000000001
2	0.000000000000000000000000000001
3	0.000000000000000000000000000001
4	0.000000000000000000000000000000
5	NULL
6	0.000000000000000000000000000001
7	0.000000000000000000000000000001

# A string literal next to NULL (the first THEN value without an ELSE) is VARCHAR, which a DECIMAL does not mix with.

statement error mix values of type VARCHAR and DECIMAL\(9,2\) in CASE
SELECT CASE WHEN id < 4 THEN 'a' WHEN id < 8 THEN d9_2 END FROM decimals

# DECIMAL CASE values in conditions, aggregates and keys.

query II rowsort
SELECT id % 3 AS g, COUNT(*) FROM decimals WHERE CASE WHEN id < 20 THEN d9_2 ELSE d18_4 END > 2 GROUP BY g
----
0	4
1	4
2	5

query DDI rowsort
SELECT CASE WHEN id < 20 THEN d9_2 ELSE p END AS k, SUM(CASE WHEN id % 2 = 0 THEN d18_4 ELSE q END), COUNT(*) FROM decimals GROUP BY k
