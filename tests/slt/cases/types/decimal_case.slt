query D nosort
SELECT SUM(CASE WHEN id % 2 = 0 THEN d38_10 ELSE d38_0 END) FROM decimals WHERE id >= 14
----
-300000000000000000002

# % beyond 38 digits: DOUBLE, NULL for a zero divisor, -0 for a negative multiple, the operands converted as DuckDB
# converts them (an integer SUM through its 128-bit formula).

query IRRR nosort
SELECT id, d38_0 % 0.0, d38_0 % 0.5, d38_10 % 0.00000000001 FROM decimals WHERE id < 16 ORDER BY id
----
0	NULL	NULL	-3.4388533912009765e-16
1	NULL	-0	-6.877706782401953e-17
2	NULL	0	NULL
3	NULL	-0	-2.751082712960781e-16
4	NULL	0	0
5	NULL	0	2.751082712960781e-16
6	NULL	NULL	4.482862320759837e-12
7	NULL	0	-4.482862320759837e-12
8	NULL	0	3.4388533912009765e-16
9	NULL	-0	-1.3755413564803906e-16
10	NULL	0	1.3755413564803906e-16
11	NULL	-0	NULL
12	NULL	NULL	3.2831140265917468e-12
13	NULL	0	9.796702697692991e-12
14	NULL	-0	-2.751082712960781e-16
15	NULL	0	0

query IR rowsort
SELECT id % 4 AS g, SUM(b) % 2.5 FROM decimals GROUP BY g
----
0	2
1	-0.5
2	1
3	-1

query R rowsort
