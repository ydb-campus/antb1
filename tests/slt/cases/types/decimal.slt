query I nosort
SELECT COUNT(*) FROM decimals WHERE p < -50 OR d38_10 > 3
----
19

query I nosort
SELECT COUNT(*) FROM decimals WHERE p > 0 OR q < 0
----
24

# Folded literals under OR and NOT keep three-valued logic: a NULL p stays NULL.

query I rowsort
SELECT id FROM decimals WHERE p = 59.975 OR id = 1
----
1

query I nosort
SELECT COUNT(*) FROM decimals WHERE NOT (p <> 59.975)
----
0

query I nosort
SELECT COUNT(*) FROM decimals WHERE NOT (p = 59.975)
----
32

# HAVING folds into the aggregate's own scale.

query DI rowsort
SELECT d9_2, COUNT(*) FROM decimals GROUP BY d9_2 HAVING MAX(p) < 59.975
----
-1.25	3
-2.50	2
-3.75	3
-5.00	3
-6.25	4
-9999999.99	1
0.00	4
1.25	3
2.50	2
3.75	2
9999999.99	1

query DD rowsort
SELECT d18_4, MIN(q) FROM decimals GROUP BY d18_4 HAVING MIN(q) >= -59.975 AND MAX(d38_10) > 0.0000000001
----
-3.0003	-59.97
1.0001	19.99
2.0002	39.98
4.0004	79.96
5.0005	99.95
NULL	39.98

# Two columns of the same DECIMAL(p,s) compare by value.

query I rowsort
SELECT id FROM decimals WHERE p = q
----
0
15
18
21
27
3
30
36
6

query I nosort
SELECT COUNT(*) FROM decimals WHERE p < q
----
17

# Keys: ORDER BY, top-N and GROUP BY order and group by value.

query ID nosort
SELECT id, d38_10 FROM decimals ORDER BY d38_10 DESC NULLS LAST, id LIMIT 6
----
6	9999999999999999999999999999.9999999999
8	5.0000000005
19	5.0000000005
30	5.0000000005
5	4.0000000004
16	4.0000000004

query ID nosort
SELECT id, d9_2 FROM decimals ORDER BY d9_2 NULLS FIRST, id LIMIT 8 OFFSET 3
----
