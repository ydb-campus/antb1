# DECIMAL(p,s) columns (ADR 0021, docs/sql-subset.md): decimals.parquet stores DECIMAL(9,2) as INT32, (18,4) and
# (15,2) as INT64, and (38,10) and (38,0) as FIXED_LEN_BYTE_ARRAY. Values print with exactly s digits after the point;
# literals fold exactly into the column's (p,s); keys compare by value. SUM, AVG, arithmetic, CASE values and mixed
# types are not supported yet (onlyif duckdb records).

query IDDDDDD nosort
SELECT id, d9_2, d18_4, d38_10, d38_0, p, q FROM decimals ORDER BY id LIMIT 14
----
0	-6.25	-5.0005	-5.0000000005	NULL	-99.95	-99.95
1	9999999.99	-1.0001	-1.0000000001	-100000000000000000000	-19.99	NULL
2	-9999999.99	3.0003	NULL	300000000000000000000	59.97	99.95
3	NULL	-4.0004	-4.0000000004	-400000000000000000000	-79.96	-79.96
4	0.00	99999999999999.9999	0.0000000000	0	NULL	19.99
5	5.00	NULL	4.0000000004	400000000000000000000	79.96	119.94
6	-3.75	-3.0003	9999999999999999999999999999.9999999999	NULL	-59.97	-59.97
7	1.25	1.0001	-9999999999999999999999999999.9999999999	100000000000000000000	19.99	39.98
8	6.25	5.0005	5.0000000005	99999999999999999999999999999999999999	99.95	139.93
9	-2.50	-2.0002	-2.0000000002	-99999999999999999999999999999999999999	NULL	NULL
10	NULL	2.0002	2.0000000002	200000000000000000000	9999999999999.99	59.97
11	-6.25	-5.0005	NULL	-500000000000000000000	-9999999999999.99	-59.97
12	-1.25	NULL	-1.0000000001	NULL	-19.99	9999999999999.99
13	3.75	3.0003	3.0000000003	300000000000000000000	59.97	-9999999999999.99

query IIIIII nosort
SELECT COUNT(d9_2), COUNT(d18_4), COUNT(d38_10), COUNT(d38_0), COUNT(p), COUNT(q) FROM decimals
----
34	35	35	33	32	35

query DDDDDD nosort
SELECT MIN(d9_2), MAX(d9_2), MIN(d18_4), MAX(d18_4), MIN(d38_10), MAX(d38_10) FROM decimals
----
-9999999.99	9999999.99	-5.0005	99999999999999.9999	-9999999999999999999999999999.9999999999	9999999999999999999999999999.9999999999

query DDDD nosort
SELECT MIN(d38_0), MAX(d38_0), MIN(p), MAX(q) FROM decimals WHERE id > 13
----
-500000000000000000000	500000000000000000000	-99.95	119.94

query IIII nosort
SELECT COUNT(DISTINCT d9_2), COUNT(DISTINCT d18_4), COUNT(DISTINCT d38_0), COUNT(DISTINCT p) FROM decimals
----
13	12	13	13

# Literal folding: integers, the column's scale, more digits than the scale (rounded by direction), out of range.

query I rowsort
SELECT id FROM decimals WHERE d9_2 = 1.25
----
18
29
7

query I rowsort
SELECT id FROM decimals WHERE d9_2 = 1.250000
----
18
29
7

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 = 1.251
----
0

query I rowsort
SELECT id FROM decimals WHERE d9_2 = 5
----
16
27
5

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 < 1.251
----
23

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 <= 1.251
----
23

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 > 1.249
----
14

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 >= -1.249
----
18

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 <> -3.75
----
31

query I nosort
SELECT COUNT(*) FROM decimals WHERE -3.75 < d9_2
----
23

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 <= 9999999.99
----
34

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 < 10000000
----
34

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 > -10000000
----
34

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 = 10000000
----
0

query I nosort
SELECT COUNT(*) FROM decimals WHERE d9_2 <> 123456789012
----
34

query I rowsort
SELECT id FROM decimals WHERE d18_4 = -5.0005
----
0
11
22

query I nosort
SELECT COUNT(*) FROM decimals WHERE d18_4 >= 99999999999999.9999
----
1

query I rowsort
SELECT id FROM decimals WHERE d38_10 = 9999999999999999999999999999.9999999999
----
6

query I rowsort
SELECT id FROM decimals WHERE d38_10 < -9999999999999999999999999999.999999999
----
7

# Divergence D13: DuckDB compares in DECIMAL(38, 11), which cannot hold the column's largest value, and fails.

onlyif antb1
query I nosort
SELECT COUNT(*) FROM decimals WHERE d38_10 > 0.00000000001
----
14

onlyif duckdb
statement error out of range
SELECT COUNT(*) FROM decimals WHERE d38_10 > 0.00000000001

# The same rows: the smallest positive value is 1.0000000001.
query I nosort
SELECT COUNT(*) FROM decimals WHERE d38_10 > 0
----
14

query I rowsort
SELECT id FROM decimals WHERE d38_0 = 99999999999999999999999999999999999999
----
8

onlyif antb1
query I rowsort
SELECT id FROM decimals WHERE d38_0 >= 300000000000000000000.4
----
16
19
27
38
5
8

onlyif duckdb
statement error out of range
SELECT id FROM decimals WHERE d38_0 >= 300000000000000000000.4

query I rowsort
SELECT id FROM decimals WHERE d38_0 = -400000000000000000000
----
14
25
3

query I rowsort
SELECT id FROM decimals WHERE p IN (59.97, -19.99, 1.001)
----
1
12
13
2
23
35

query I nosort
SELECT COUNT(*) FROM decimals WHERE p NOT IN (59.97, -19.99)
----
