query I rowsort
SELECT id FROM decimals WHERE p BETWEEN 19.99 AND 80 AND d9_2 >= 0
----
13
16
18
21
27
32
35
5
7

query I nosort
SELECT COUNT(*) FROM decimals WHERE p NOT BETWEEN -20 AND 20
----
