# Not supported yet (exit 4): SUM and AVG, arithmetic, CASE values, mixed types and approximate literals.

onlyif duckdb
query D nosort
SELECT SUM(p) FROM decimals
----
-39.98

onlyif duckdb
query R nosort
SELECT AVG(d9_2) FROM decimals
----
-0.29411764705882354

onlyif duckdb
query D rowsort
SELECT p + 1 FROM decimals WHERE id < 3
----
-18.99
-98.95
60.97

