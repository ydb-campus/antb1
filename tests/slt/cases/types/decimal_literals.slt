# Decimal literals, / // % and DOUBLE operands with DECIMALs (ADR 0021 rules 3, 8 and 9; docs/sql-subset.md).
# A decimal literal is DECIMAL(digits, fraction digits); / and // of a DECIMAL are DOUBLE, the DECIMAL converted as
# DuckDB converts it; % computes in the common DECIMAL. Rows 0 to 13 of decimals hold the columns' extremes.

query DDDDD nosort
SELECT 2.5, 007.50, .125, -0.5, 5. FROM decimals WHERE id = 0
----
2.5	7.50	.125	-0.5	5

# Integers with decimal literals compute in DECIMAL.

query IDDDDD nosort
SELECT id, i16 + 1.5, i32 * 0.5, i64 - 0.25, i64 % 2.5, u16 * 1.5 FROM edge ORDER BY id
