# In conditions and aggregates.

query I rowsort
SELECT id FROM decimals WHERE p % 7 = 0 AND id >= 14
----
15
26
37

query I rowsort
SELECT id FROM decimals WHERE id * 0.5 > 17.25
----
35
36
37
38
39

query I nosort
SELECT COUNT(*) FROM decimals WHERE p / 3 > 10
----
12

query DRDR nosort
SELECT SUM(p % 7), AVG(p / 3), SUM(id * 0.5), MAX(p // 2) FROM decimals WHERE id >= 14
----
-2.96	-1.3326666666666669	344.5	49.975

query IDD nosort
SELECT id % 3 AS g, SUM(q % 10), MIN(d9_2 * 1.5) FROM decimals GROUP BY g ORDER BY g
----
0	10.03	-9.375
1	19.90	-9.375
2	69.66	-14999999.985

# A decimal literal against a DOUBLE converts as DuckDB converts a DECIMAL, not to the nearest double
# (divergence D12 keeps only HUGEINT literals).

# 9007199254740993.5 converts to 2^53, where the nearest double is 2^53 + 2; 9007199254740992.5 to 2^53.

query I nosort
SELECT COUNT(*) FROM edge WHERE d * 0 + 9007199254740994 = 9007199254740993.5
----
0

query I nosort
SELECT COUNT(*) FROM edge WHERE d * 0 + 9007199254740992 = 9007199254740993.5
----
10

query I nosort
SELECT COUNT(*) FROM edge WHERE d * 0 + 9007199254740992 IN (1.5, 9007199254740992.5)
----
10

# Overflows past a capped width fail with DuckDB's messages, literals included.

statement error Overflow in multiplication of DECIMAL\(18\)
SELECT d18_4 * 1.5 FROM decimals

statement error Casting value "99999999999999.9999" to type DECIMAL\(18,5\) failed: value is out of range! when casting from source column d18_4
SELECT d18_4 + 0.00005 FROM decimals

# Not supported yet (exit 4, roadmap PR D4b): % beyond 38 digits, a decimal literal as a CASE value next to a
# non-DOUBLE value.

onlyif duckdb
query R rowsort
SELECT d38_0 % 0.5 FROM decimals WHERE id >= 30
----
-0
-0
-0
-0
0
0
0
0
NULL
NULL

onlyif duckdb
query D rowsort
SELECT CASE WHEN id > 35 THEN p ELSE 0.5 END FROM decimals WHERE id >= 30
----
-79.96
0.00
0.50
0.50
0.50
0.50
0.50
0.50
79.96
NULL
