SELECT pu.label, dr.label, COUNT(*) FROM trips, zones AS pu, zones AS dr
WHERE tr_pickup = pu.zn_id AND tr_dropoff = dr.zn_id AND pu.zn_id <= 2 GROUP BY pu.label, dr.label
