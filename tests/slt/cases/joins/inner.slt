# Inner joins over the star schema (tools/fixturegen/star.h, ADR 0022): comma lists, CROSS JOIN with WHERE and
# [INNER] JOIN ... ON over NULL, dangling and repeated keys, keys of two types, a two-column key, a cycle, a
# many-to-many edge, residuals, an expression key and self-joins. Every query joins all its tables through
# equalities whose common type is not DOUBLE, as ADR 0022 rejects a disconnected join graph with exit code 4.

# ---- the inputs, one table at a time ----

# A 32-bit wrap of drivers' key 2^32 + 1000 would meet the 29 trips of driver 1000.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_driver = 1000
----
29

query I nosort
SELECT dv_id FROM drivers WHERE dv_id > 2147483647
----
4294968296

# Riders 7, 47, 64 and 192 repeat their key; rider 8 does not exist, and rider 237 has no trip.
query II rowsort
SELECT tr_rider, COUNT(*) FROM trips WHERE tr_rider IN (7, 8, 47, 64, 192, 236, 237) GROUP BY tr_rider
----
192	12
236	12
47	12
64	11
7	13
8	12

# shifts repeats the keys (1111, 2026-03-22) and (1148, 2026-03-29), and one trip has each.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_driver = 1111 AND tr_day = DATE '2026-03-22'
----
1

query I nosort
SELECT COUNT(*) FROM trips WHERE tr_driver = 1148 AND tr_day = DATE '2026-03-29'
----
1

# ---- inner joins (ADR 0022) ----

# The INTEGER tr_driver meets the BIGINT dv_id in BIGINT: driver 2^32 + 1000 matches no trip, and NULL keys on either
# side never match. Five spellings of one join.
query IDT nosort trips_drivers
SELECT COUNT(*), SUM(tr_fare), MIN(dv_since) FROM trips, drivers WHERE tr_driver = dv_id
----
2577	38689.00	2025-01-01

query IDT nosort trips_drivers
SELECT COUNT(*), SUM(tr_fare), MIN(dv_since) FROM drivers, trips WHERE dv_id = tr_driver
----
2577	38689.00	2025-01-01

query IDT nosort trips_drivers
SELECT COUNT(*), SUM(tr_fare), MIN(dv_since) FROM trips JOIN drivers ON tr_driver = dv_id
----
2577	38689.00	2025-01-01

query IDT nosort trips_drivers
SELECT COUNT(*), SUM(tr_fare), MIN(dv_since) FROM trips INNER JOIN drivers ON dv_id = tr_driver
----
2577	38689.00	2025-01-01

query IDT nosort trips_drivers
SELECT COUNT(*), SUM(tr_fare), MIN(dv_since) FROM trips CROSS JOIN drivers WHERE tr_driver = dv_id
----
2577	38689.00	2025-01-01

query II rowsort
SELECT dv_id, COUNT(*) FROM trips JOIN drivers ON tr_driver = dv_id WHERE dv_id IN (1000, 4294968296) GROUP BY dv_id
----
1000	29

# A repeated rider key matches twice: 2841 rows hold 2745 trips.
query II nosort trips_riders
SELECT COUNT(*), COUNT(DISTINCT tr_row) FROM trips JOIN riders ON tr_rider = rd_id
----
2841	2745

query II nosort trips_riders
SELECT COUNT(*), COUNT(DISTINCT tr_row) FROM riders, trips WHERE rd_id = tr_rider
----
2841	2745

query II rowsort
SELECT rd_id, COUNT(*) FROM trips JOIN riders ON tr_rider = rd_id WHERE rd_id IN (7, 8, 47, 64, 192, 236, 237) GROUP BY rd_id
----
192	24
236	12
47	24
64	22
7	26

# The empty dimension: no row, and SUM is NULL.
query ID nosort
SELECT COUNT(*), SUM(pm_discount) FROM trips JOIN promos ON tr_promo = pm_id
----
0	NULL

# VARCHAR keys: std and XL match no code (case, a trailing space), and the NULL code matches nothing.
query TI rowsort
SELECT tf_code, COUNT(*) FROM trips JOIN tariffs ON tr_tariff = tf_code GROUP BY tf_code
----
(empty)	284
AIRPORT	285
NIGHT	284
POOL	284
STD	284
Std	284
XL\x20	285
Ж-1	284

# DECIMAL(4,2) keys against DECIMAL(5,3) rates: 2.25 and 0.88 match no rate, 2.125 and 0.875 no trip.
query DDI rowsort
SELECT tr_rate, tf_rate, COUNT(*) FROM trips JOIN tariffs ON tr_rate = tf_rate GROUP BY tr_rate, tf_rate
----
1.00	1.000	348
1.25	1.250	350
1.50	1.500	348
1.75	1.750	350
2.00	2.000	345
2.50	2.500	342

# The two-column key: a key with a NULL part never matches, and each repeated key of shifts, (1111, 2026-03-22) and
# (1148, 2026-03-29), matches twice.
query IDD nosort trips_shifts
SELECT COUNT(*), MIN(sh_hours), MAX(sh_hours) FROM trips JOIN shifts ON tr_driver = sh_driver AND tr_day = sh_day
----
447	4.0	12.0

query IDD nosort trips_shifts
SELECT COUNT(*), MIN(sh_hours), MAX(sh_hours) FROM shifts, trips WHERE sh_day = tr_day AND sh_driver = tr_driver
----
447	4.0	12.0

query TI rowsort
SELECT sh_day, COUNT(*) FROM trips JOIN shifts ON tr_driver = sh_driver AND tr_day = sh_day WHERE sh_driver = 1111 GROUP BY sh_day
----
2026-03-03	1
2026-03-06	1
2026-03-17	1
2026-03-22	2
2026-03-25	1

# No shift is on March 31.
query I nosort
SELECT COUNT(*) FROM trips JOIN shifts ON tr_driver = sh_driver AND tr_day = sh_day WHERE tr_day = DATE '2026-03-31'
----
0

# A FROM list that starts with two tables sharing no predicate, the join chain, and an ON that names an earlier comma
# sibling (zones), which DuckDB allows.
query ID nosort unconnected_first
SELECT COUNT(*), SUM(tr_fare) FROM zones, riders, trips WHERE tr_pickup = zn_id AND tr_rider = rd_id
----
2650	39900.50

query ID nosort unconnected_first
SELECT COUNT(*), SUM(tr_fare) FROM trips JOIN zones ON tr_pickup = zn_id JOIN riders ON tr_rider = rd_id
----
2650	39900.50

query ID nosort unconnected_first
SELECT COUNT(*), SUM(tr_fare) FROM zones, trips JOIN riders ON tr_rider = rd_id AND tr_pickup = zn_id
----
2650	39900.50

# A cycle: trips -> zones -> cities <- riders <- trips, in two FROM orders.
query ID nosort cycle
SELECT COUNT(*), SUM(tr_fare) FROM trips, zones, cities, riders
WHERE tr_pickup = zn_id AND zn_city = ct_id AND rd_city = ct_id AND tr_rider = rd_id
----
492	7333.75

query ID nosort cycle
SELECT COUNT(*), SUM(tr_fare) FROM riders, cities, zones, trips
WHERE tr_rider = rd_id AND rd_city = ct_id AND zn_city = ct_id AND tr_pickup = zn_id
----
492	7333.75

# A cycle whose shortcut zn_city = dv_city is many-to-many, next to the keys tr_pickup = zn_id and tr_driver = dv_id.
query ID nosort shortcut
SELECT COUNT(*), SUM(tr_fare) FROM trips, zones, drivers WHERE tr_pickup = zn_id AND tr_driver = dv_id AND zn_city = dv_city
----
416	6174.25

query ID nosort shortcut
SELECT COUNT(*), SUM(tr_fare) FROM drivers JOIN zones ON zn_city = dv_city JOIN trips ON tr_pickup = zn_id AND tr_driver = dv_id
----
416	6174.25

# The many-to-many edge as the only way to zones: every trip meets each zone of its driver's city.
query ID nosort many_to_many
SELECT COUNT(*), SUM(tr_fare) FROM trips, drivers, riders, zones WHERE tr_driver = dv_id AND tr_rider = rd_id AND zn_city = dv_city
----
16652	250781.75

query ID nosort many_to_many
SELECT COUNT(*), SUM(tr_fare) FROM zones JOIN drivers ON zn_city = dv_city JOIN trips ON tr_driver = dv_id JOIN riders ON tr_rider = rd_id
----
16652	250781.75

# Residuals across two tables, in WHERE and in ON.
query I nosort
SELECT COUNT(*) FROM trips JOIN riders ON tr_rider = rd_id WHERE rd_joined > tr_day
----
59

query I nosort residual_or
SELECT COUNT(*) FROM trips JOIN riders ON tr_rider = rd_id WHERE rd_joined > tr_day OR rd_city = 1
----
949

query I nosort residual_or
SELECT COUNT(*) FROM trips JOIN riders ON tr_rider = rd_id AND (rd_joined > tr_day OR rd_city = 1)
----
949

# A DOUBLE equality next to a key is a residual.
query ID nosort
SELECT COUNT(*), SUM(tr_fare) FROM trips JOIN zones ON tr_pickup = zn_id AND tr_distance = zn_radius
----
19	274.25

# An expression key.
query III nosort
SELECT COUNT(*), MIN(zn_id), MAX(zn_id) FROM trips JOIN zones ON tr_pickup + 1 = zn_id
----
2724	2	40

# Self-joins: a zone and its parent (zone 40's parent 77 does not exist), and zones in two roles.
query ITI rowsort
SELECT z.zn_id, p.label, p.zn_id FROM zones AS z JOIN zones AS p ON z.zn_parent = p.zn_id WHERE z.zn_id > 30
----
31	center	1
32	north	2
33	south	3
34	airport	4
35	docks	5
36	center	1
37	north	2
38	south	3
39	airport	4

query III nosort
SELECT COUNT(*), MIN(pu.zn_id), MAX(dr.zn_id) FROM trips, zones AS pu, zones AS dr WHERE tr_pickup = pu.zn_id AND tr_dropoff = dr.zn_id
----
2629	1	40

query TTI rowsort
SELECT pu.label, dr.label, COUNT(*) FROM trips, zones AS pu, zones AS dr
WHERE tr_pickup = pu.zn_id AND tr_dropoff = dr.zn_id AND pu.zn_id <= 2 GROUP BY pu.label, dr.label
----
center	NULL	9
center	airport	8
center	center	8
center	docks	9
center	market	9
center	north	7
center	park	9
center	south	7
north	NULL	7
north	airport	9
north	center	8
north	docks	9
north	market	8
north	north	8
north	park	9
north	south	8

# The fan-out case: the trips of one rider, and of one driver (up to 28 matches for a probe row, 40488 in all), with
# a residual that keeps each pair once.
query IDI nosort
SELECT COUNT(*), SUM(a.tr_fare), MIN(b.tr_row - a.tr_row) FROM trips AS a JOIN trips AS b ON a.tr_rider = b.tr_rider AND a.tr_row < b.tr_row
----
15785	236682.00	236

query I nosort
SELECT COUNT(*) FROM trips AS a JOIN trips AS b ON a.tr_driver = b.tr_driver AND a.tr_row < b.tr_row
----
40488

# The row counts that integration.JoinTest (tests/integration/join_test.cc) pins for its hand-built plans of these
# joins: VARCHAR keys, the self-reference of zones, a chain of two joins and a filter on each side. Its other counts
# are those of trips with riders, shifts and promos above, and of trips with zones in names.slt.
query I nosort
SELECT COUNT(*) FROM trips JOIN tariffs ON tr_tariff = tf_code
----
2274

query I nosort
SELECT COUNT(*) FROM zones AS z JOIN zones AS p ON z.zn_parent = p.zn_id
----
34

query I nosort
SELECT COUNT(*) FROM trips JOIN zones ON tr_pickup = zn_id JOIN cities ON zn_city = ct_id
----
2655

query I nosort
SELECT COUNT(*) FROM trips JOIN zones ON tr_pickup = zn_id WHERE tr_row >= 2400 AND zn_id <= 10
----
140

# ---- DuckDB only until DOUBLE join keys get a PR (ADR 0022: a graph connected only through one exits 4) ----

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM trips, zones WHERE tr_distance = zn_radius
----
828

onlyif duckdb
query RI rowsort
SELECT zn_radius, COUNT(*) FROM trips JOIN zones ON tr_distance = zn_radius WHERE zn_radius > 3 GROUP BY zn_radius
----
3.25	276
