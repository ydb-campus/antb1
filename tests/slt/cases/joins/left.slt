# LEFT [OUTER] JOIN over the star schema (ADR 0022): padded rows and COUNT(col) against COUNT(*), the same predicate
# in ON and in WHERE, ON conjuncts on either side, the empty dimension, a two-column key and inner joins mixed with a
# LEFT JOIN in several FROM orders. Every pending join has an equality key whose common type is not DOUBLE.

# ---- the inputs, one table at a time ----

query II nosort
SELECT COUNT(*), COUNT(tr_fare) FROM trips WHERE tr_fare > 20
----
897	897

query I nosort
SELECT COUNT(*) FROM zones WHERE zn_radius > 2
----
15

query I rowsort
SELECT ct_id FROM cities WHERE ct_pop > 40000
----
1
2

# ---- pending: left joins (ADR 0022; roadmap PR J6 removes these guards) ----

# The same predicate in ON keeps every trip and pads those without a zone of radius above 2; in WHERE it drops them.
pending J6
query III nosort
SELECT COUNT(*), COUNT(zn_id), COUNT(zn_radius) FROM trips LEFT JOIN zones ON tr_pickup = zn_id AND zn_radius > 2
----
3000	1047	1047

pending J6
query III nosort
SELECT COUNT(*), COUNT(zn_id), COUNT(zn_radius) FROM trips LEFT JOIN zones ON tr_pickup = zn_id WHERE zn_radius > 2
----
1047	1047	1047

# An ON conjunct on the preserved side pads the trips that fail it, and drops none.
pending J6
query IID nosort
SELECT COUNT(*), COUNT(dv_id), SUM(tr_fare) FROM trips LEFT JOIN drivers ON tr_driver = dv_id AND tr_fare > 20
----
3000	771	44992.50

# COUNT(col) skips the padded NULLs, and the NULLs of the data.
pending J6
query IIIII nosort
SELECT COUNT(*), COUNT(dv_id), COUNT(dv_city), COUNT(dv_since), COUNT(tr_driver) FROM trips LEFT OUTER JOIN drivers ON tr_driver = dv_id
----
3000	2577	2345	2577	2896

# The empty dimension pads every row.
pending J6
query IID nosort
SELECT COUNT(*), COUNT(pm_id), SUM(pm_discount) FROM trips LEFT JOIN promos ON tr_promo = pm_id
----
3000	0	NULL

# Padded rows group under NULL, with zone 38's NULL city.
pending J6
query III rowsort
SELECT zn_city, COUNT(*), COUNT(zn_id) FROM trips LEFT JOIN zones ON tr_pickup = zn_id GROUP BY zn_city
----
1	559	559
2	559	559
3	490	490
4	489	489
5	558	558
9	69	69
NULL	276	69

# The two-column key: the two repeated keys of shifts add a row each.
pending J6
query III nosort
SELECT COUNT(*), COUNT(sh_row), COUNT(sh_hours) FROM trips LEFT JOIN shifts ON tr_driver = sh_driver AND tr_day = sh_day
----
3002	447	426

# An ON conjunct on the null-supplying side filters that side only.
pending J6
query III rowsort
SELECT ct_id, ct_pop, COUNT(*) FROM riders LEFT JOIN cities ON rd_city = ct_id AND ct_pop > 40000 GROUP BY ct_id, ct_pop
----
1	120000	77
2	45000	77
NULL	NULL	86

# A WHERE conjunct on the preserved side.
pending J6
query II nosort
SELECT COUNT(*), COUNT(dv_id) FROM trips LEFT JOIN drivers ON tr_driver = dv_id WHERE tr_fare > 20
----
897	771

# DECIMAL keys of two types: 0.88, 2.25 and NULL rates are padded.
pending J6
query DII rowsort
SELECT tr_rate, COUNT(*), COUNT(tf_rate) FROM trips LEFT JOIN tariffs ON tr_rate = tf_rate GROUP BY tr_rate
----
0.88	343	0
1.00	348	348
1.25	350	350
1.50	348	348
1.75	350	350
2.00	345	345
2.25	343	0
2.50	342	342
NULL	231	0

# Padding of every type: VARCHAR, DECIMAL and the empty string next to NULL.
pending J6
query ITTDT rowsort
SELECT tr_row, tr_tariff, tf_code, tf_rate, tf_label FROM trips LEFT JOIN tariffs ON tr_tariff = tf_code WHERE tr_row < 10
----
0	STD	STD	1.000	standard
1	Std	Std	1.250	standard
2	Ж-1	Ж-1	1.750	center
3	NULL	NULL	NULL	NULL
4	AIRPORT	AIRPORT	2.000	airport
5	XL\x20	XL\x20	2.500	xl
6	std	NULL	NULL	NULL
7	NIGHT	NIGHT	1.500	night
8	(empty)	(empty)	2.125	center
9	POOL	POOL	0.875	pool

# Two LEFT JOINs: the second pads the trips the first padded, and those of zone 38 (NULL city) and zone 39 (city 9).
pending J6
query III nosort
SELECT COUNT(*), COUNT(zn_id), COUNT(ct_id) FROM trips LEFT JOIN zones ON tr_pickup = zn_id LEFT JOIN cities ON zn_city = ct_id
----
3000	2793	2655

# An inner join and a LEFT JOIN in three FROM orders. The items from the last comma up to a LEFT JOIN form its left
# input (ADR 0022): trips JOIN drivers in the first, trips in the other two.
pending J6
query IID nosort inner_left
SELECT COUNT(*), COUNT(zn_id), SUM(tr_fare) FROM trips JOIN drivers ON tr_driver = dv_id LEFT JOIN zones ON tr_pickup = zn_id
----
2577	2398	38689.00

pending J6
query IID nosort inner_left
SELECT COUNT(*), COUNT(zn_id), SUM(tr_fare) FROM drivers, trips LEFT JOIN zones ON tr_pickup = zn_id WHERE tr_driver = dv_id
----
2577	2398	38689.00

pending J6
query IID nosort inner_left
SELECT COUNT(*), COUNT(zn_id), SUM(tr_fare) FROM trips LEFT JOIN zones ON tr_pickup = zn_id JOIN drivers ON dv_id = tr_driver
----
2577	2398	38689.00

