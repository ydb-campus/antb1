# Cross products and joins without an equality key over the star schema (ADR 0040): plain products, inequality,
# `<>`, OR and BETWEEN conditions between the two sides, NULLs in them, empty inputs, a cross of parts that keys
# join inside, conditions across the parts, grouped derived tables and CTEs, and products under a LEFT and a FULL
# JOIN. A join with no equality key is a nested loop, its conditions the residuals on its pairs.

# ---- plain products ----

query I nosort
SELECT COUNT(*) FROM cities, tariffs
----
BIGINT
54

query I nosort
SELECT COUNT(*) FROM cities CROSS JOIN tariffs CROSS JOIN zones
----
BIGINT
2160

query IT rowsort
SELECT ct_id, tf_code FROM cities, tariffs WHERE ct_pop > 40000 AND tf_rate > 2
----
SMALLINT	VARCHAR
1	(empty)
1	XL\x20
2	(empty)
2	XL\x20

# An empty input empties the product, on either side.
query I nosort
SELECT COUNT(*) FROM trips, promos
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM promos, trips
----
BIGINT
0

# ---- conditions between the two sides ----

# Each pair of zones once.
query I nosort
SELECT COUNT(*) FROM zones AS a, zones AS b WHERE a.zn_id < b.zn_id
----
BIGINT
780

# A NULL population never compares: city 4 is in no pair.
query II rowsort
SELECT a.ct_id, COUNT(*) FROM cities AS a JOIN cities AS b ON a.ct_pop < b.ct_pop GROUP BY a.ct_id
----
SMALLINT	BIGINT
2	1
3	2
5	3
6	4

query I nosort
SELECT COUNT(*) FROM zones JOIN cities ON zn_city <> ct_id
----
BIGINT
196

query I nosort
SELECT COUNT(*) FROM zones, cities WHERE zn_city = ct_id OR zn_radius > ct_id
----
BIGINT
75

query I nosort
SELECT COUNT(*) FROM drivers, cities WHERE dv_city BETWEEN ct_id - 1 AND ct_id + 1
----
BIGINT
244

# Two conditions, one of them over a DECIMAL and a DOUBLE.
query I nosort
SELECT COUNT(*) FROM tariffs, zones WHERE tf_rate < zn_radius AND tf_label <> label
----
BIGINT
128

# ---- parts that keys join inside, crossed ----

# Trips with their zones, crossed with cities: the condition across the parts decides the pairs.
query II nosort
SELECT COUNT(*), COUNT(DISTINCT ct_id) FROM trips JOIN zones ON tr_pickup = zn_id, cities WHERE zn_radius > ct_id
----
BIGINT	BIGINT
3212	3

query I nosort
SELECT COUNT(*) FROM trips JOIN zones ON tr_pickup = zn_id, drivers JOIN cities ON dv_city = ct_id WHERE tr_driver < dv_id AND zn_city = 1
----
BIGINT
22731

# Two grouped derived tables: one row per city on each side.
query III rowsort
SELECT a.zn_city, b.dv_city, a.n * b.m FROM (SELECT zn_city, COUNT(*) AS n FROM zones GROUP BY zn_city) AS a, (SELECT dv_city, COUNT(*) AS m FROM drivers GROUP BY dv_city) AS b WHERE a.zn_city IS NOT NULL AND b.dv_city IS NOT NULL AND a.zn_city <= 2
----
SMALLINT	SMALLINT	BIGINT
1	1	184
1	2	176
1	3	176
1	4	176
2	1	184
2	2	176
2	3	176
2	4	176

query II rowsort
WITH a AS (SELECT ct_id, ct_pop FROM cities WHERE ct_pop IS NOT NULL) SELECT x.ct_id, COUNT(*) FROM a AS x, a AS y WHERE x.ct_pop >= y.ct_pop GROUP BY x.ct_id
----
SMALLINT	BIGINT
1	5
2	4
3	3
5	2
6	1

query I nosort
SELECT SUM(n) FROM (SELECT COUNT(*) AS n FROM zones, cities WHERE zn_city < ct_id GROUP BY zn_id) AS g
----
HUGEINT
115

# ---- products under outer joins ----

query III nosort
SELECT COUNT(*), COUNT(dv_row), COUNT(DISTINCT ct_id) FROM zones CROSS JOIN cities LEFT JOIN drivers ON dv_city = ct_id AND dv_id < 1200 WHERE zn_id <= 3
----
BIGINT	BIGINT	BIGINT
24	18	6

query III nosort
SELECT COUNT(*), COUNT(zn_row), COUNT(ct_row) FROM zones CROSS JOIN tariffs FULL JOIN cities ON zn_city = ct_id WHERE tf_rate > 2 OR tf_rate IS NULL
----
BIGINT	BIGINT	BIGINT
121	120	115

# ---- subqueries over a cross product ----

# A correlated block whose relations only the outer columns connect: a cross product of them, keyed on the outer
# columns by the semi join or the join above it. Two inner columns equal to one outer column must also equal each
# other (ADR 0023's Path 2).
query I nosort
SELECT COUNT(*) FROM cities AS c WHERE EXISTS (SELECT * FROM zones, drivers WHERE zn_city = c.ct_id AND dv_city = c.ct_id AND dv_id < 1100)
----
BIGINT
3

query I nosort
SELECT COUNT(*) FROM cities AS c WHERE NOT EXISTS (SELECT * FROM zones, drivers WHERE zn_city = c.ct_id AND dv_city = c.ct_id AND dv_id < 1100)
----
BIGINT
3

query I nosort
SELECT COUNT(*) FROM cities AS c WHERE ct_id < (SELECT SUM(zn_id) FROM zones, drivers WHERE zn_city = c.ct_id AND dv_city = c.ct_id AND dv_id < 1100)
----
BIGINT
3

# An uncorrelated IN and NOT IN over a cross product with a condition between its sides.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_pickup IN (SELECT zn_id FROM zones, cities WHERE zn_city < ct_id AND ct_pop > 40000)
----
BIGINT
559

query I nosort
SELECT COUNT(*) FROM trips WHERE tr_pickup NOT IN (SELECT zn_id FROM zones, cities WHERE zn_city < ct_id AND ct_pop > 40000)
----
BIGINT
2441

# ---- LEFT and FULL JOINs without an equality key (ADR 0040's OJ4c) ----

# Each zone with every city of a larger id, or once padded: the zones of the last city and of a NULL city match none.
query III nosort
SELECT COUNT(*), COUNT(ct_id), COUNT(DISTINCT zn_id) FROM zones LEFT JOIN cities ON zn_city < ct_id
----
BIGINT	BIGINT	BIGINT
117	115	40

# A conjunct over the right input alone filters it (rule 11); one over the left input pads the rows that fail it.
query III nosort
SELECT COUNT(*), COUNT(ct_id), COUNT(DISTINCT zn_id) FROM zones LEFT JOIN cities ON zn_city < ct_id AND ct_pop > 40000
----
BIGINT	BIGINT	BIGINT
40	8	40

query III nosort
SELECT COUNT(*), COUNT(ct_id), COUNT(DISTINCT zn_id) FROM zones LEFT JOIN cities ON zn_city < ct_id AND zn_radius > 2
----
BIGINT	BIGINT	BIGINT
70	45	40

# An empty right input pads every left row.
query II nosort
SELECT COUNT(*), COUNT(pm_id) FROM cities LEFT JOIN promos ON ct_id <> pm_id
----
BIGINT	BIGINT
6	0

# A FULL JOIN pads both sides: the cities no zone is below, and the zones no city is above.
query III nosort
SELECT COUNT(*), COUNT(zn_id), COUNT(ct_id) FROM zones FULL JOIN cities ON zn_city > ct_id AND zn_radius > 2
----
BIGINT	BIGINT	BIGINT
60	58	32

query II rowsort
SELECT ct_id, COUNT(zn_id) FROM zones FULL JOIN cities ON zn_city > ct_id GROUP BY ct_id
----
SMALLINT	BIGINT
1	31
2	23
3	16
4	9
5	1
6	1
NULL	9

# OR and <> conditions, and a keyless LEFT JOIN of a keyed pair.
query II nosort
SELECT COUNT(*), COUNT(tf_code) FROM cities LEFT JOIN tariffs ON ct_pop > 40000 OR tf_rate > 2
----
BIGINT	BIGINT
26	24

query II nosort
SELECT COUNT(*), COUNT(ct_id) FROM trips JOIN zones ON tr_pickup = zn_id LEFT JOIN cities ON zn_city <> ct_id AND ct_pop > 40000 WHERE tr_row < 100
----
BIGINT	BIGINT
148	146

# ---- ordered and limited ----

query II nosort
SELECT a.ct_id, b.ct_id FROM cities AS a, cities AS b WHERE a.ct_id < b.ct_id ORDER BY a.ct_id DESC, b.ct_id LIMIT 4
----
SMALLINT	SMALLINT
5	6
4	5
4	6
3	4
