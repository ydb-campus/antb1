pending CT5
query I nosort
SELECT COUNT(*) FROM bookings WHERE bk_pickup >= bk_day + 7
----
BIGINT
585

# The bookings no promotion matches (IS NULL, NL4).
pending NL4
query I nosort
SELECT COUNT(*) FROM bookings LEFT JOIN promos ON bk_promo = pm_id WHERE pm_id IS NULL
----
BIGINT
1800
