# Cross products of one-row inputs (ADR 0022's connectivity rule, relaxed): a derived table or a CTE reference of
# exactly one row -- an aggregate without GROUP BY, HAVING, LIMIT or OFFSET -- that no key and no condition but a
# subquery conjunct reads joins the other inputs as one row, appending its row to each of theirs, over the star schema.

# ---- the inputs ----

query II nosort
SELECT COUNT(*), MAX(ct_pop) FROM cities
----
6	120000

query I nosort
SELECT COUNT(*) FROM zones
----
40

# ---- one-row inputs only ----

query II nosort
SELECT a.n, b.m FROM (SELECT COUNT(*) AS n FROM trips) AS a, (SELECT MAX(ct_pop) AS m FROM cities) AS b
----
3000	120000

query IIID nosort
SELECT a.n, b.z, c.p, d.f FROM (SELECT COUNT(*) AS n FROM trips WHERE tr_row < 100) AS a CROSS JOIN (SELECT COUNT(*) AS z FROM zones) AS b CROSS JOIN (SELECT SUM(ct_pop) AS p FROM cities) AS c CROSS JOIN (SELECT SUM(tr_fare) AS f FROM trips) AS d
----
100	40	205500	44992.50

# Arithmetic over two one-row inputs: a share of the trips, in percent.
query I nosort
SELECT a.n * 100 // b.n FROM (SELECT COUNT(*) AS n FROM trips WHERE tr_row < 1350) AS a, (SELECT COUNT(*) AS n FROM trips) AS b
----
45

# ---- one-row inputs next to tables ----

query IIII rowsort
SELECT z.zn_id, z.zn_city, a.n, a.m FROM zones AS z, (SELECT COUNT(*) AS n, MAX(ct_pop) AS m FROM cities) AS a WHERE z.zn_id <= 3
----
1	1	6	120000
2	2	6	120000
3	3	6	120000

# First in FROM: the tables are the core, and the one-row input joins above them.
query II rowsort
SELECT z.zn_id, a.m FROM (SELECT MAX(ct_pop) AS m FROM cities) AS a, zones AS z WHERE z.zn_id <= 2
----
1	120000
2	120000

# In the middle of FROM: the tables around it are the core.
query III rowsort
SELECT z.zn_id, a.m, c.ct_pop FROM zones AS z, (SELECT MAX(ct_pop) AS m FROM cities) AS a, cities AS c WHERE z.zn_city = c.ct_id AND z.zn_id <= 3
----
1	120000	120000
2	120000	45000
3	120000	30000

# First in FROM, before a core of three with a condition over two of them that is no key.
query II nosort
SELECT COUNT(*), MAX(a.total) FROM (SELECT COUNT(*) AS total FROM trips) AS a, zones AS z, cities AS c, trips AS t WHERE z.zn_city = c.ct_id AND t.tr_pickup = z.zn_id AND t.tr_driver > c.ct_pop / 100
----
2057	3000

# Next to a join, with GROUP BY and ORDER BY above.
query TII nosort
SELECT c.label, COUNT(*), MAX(a.total) FROM zones AS z JOIN cities AS c ON z.zn_city = c.ct_id, (SELECT COUNT(*) AS total FROM trips) AS a GROUP BY c.label ORDER BY c.label
----
airport	7	3000
center	8	3000
harbor	8	3000
hills	7	3000
old town	8	3000

# A CTE reference.
query II nosort
WITH n AS (SELECT COUNT(*) AS c FROM trips) SELECT COUNT(*), MAX(n.c) FROM zones, n
----
40	3000

# Inside the left input of a LEFT JOIN, and next to one.
query III nosort
SELECT COUNT(*), COUNT(c.ct_id), MAX(a.n) FROM zones AS z CROSS JOIN (SELECT COUNT(*) AS n FROM trips) AS a LEFT JOIN cities AS c ON z.zn_city = c.ct_id
----
40	38	3000

query III nosort
SELECT COUNT(*), COUNT(c.ct_id), MAX(a.n) FROM (SELECT COUNT(*) AS n FROM trips) AS a, zones AS z LEFT JOIN cities AS c ON z.zn_city = c.ct_id
----
40	38	3000

# A subquery conjunct may read it: its join stands above the one-row join and filters the joined rows.
query I nosort
SELECT COUNT(*) FROM zones AS z, (SELECT MAX(ct_pop) AS m FROM cities) AS b WHERE b.m > (SELECT AVG(ct_pop) FROM cities)
----
40

query I nosort
SELECT COUNT(*) FROM zones AS z, (SELECT MAX(ct_pop) AS m FROM cities) AS b WHERE b.m IN (SELECT ct_pop FROM cities)
----
40

query I nosort
SELECT COUNT(*) FROM zones AS z, (SELECT MAX(zn_id) AS m FROM zones) AS b WHERE b.m NOT IN (SELECT ct_id FROM cities)
----
40

# In the blocks of a UNION ALL, and over one: the aggregate of a union is one row.
query II rowsort
SELECT z.zn_id, a.n FROM zones AS z, (SELECT COUNT(*) AS n FROM cities) AS a WHERE z.zn_id <= 2 UNION ALL SELECT a.n, b.n FROM (SELECT COUNT(*) AS n FROM zones) AS a, (SELECT COUNT(*) AS n FROM (SELECT ct_id FROM cities UNION ALL SELECT zn_id FROM zones) AS u) AS b
----
1	6
2	6
40	46

# ---- no rows ----

# An aggregate over no row still has its one row; a core of no row keeps none.
query I nosort
SELECT COUNT(*) FROM zones AS z, (SELECT COUNT(*) AS n FROM trips WHERE tr_row < 0) AS a
----
40

query II nosort
SELECT a.n, b.m FROM (SELECT COUNT(*) AS n FROM trips WHERE tr_row < 0) AS a, (SELECT MAX(ct_pop) AS m FROM cities WHERE ct_id > 100) AS b
----
0	NULL

query I nosort
SELECT COUNT(*) FROM (SELECT * FROM zones WHERE zn_id < 0) AS z, (SELECT COUNT(*) AS n FROM trips) AS a
----
0

# ---- DuckDB only until general cross products get a PR (ADR 0022) ----
# A one-row input that a condition reads, or that may have no row, a union of one-row blocks, and a cross
# product of tables.

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM zones, (SELECT MAX(ct_pop) AS m FROM cities) AS a WHERE a.m > 5
----
40

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM zones AS z, (SELECT MAX(zn_id) AS m FROM zones) AS a WHERE z.zn_id < a.m
----
39

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM zones, (SELECT MAX(ct_pop) AS m FROM cities HAVING MAX(ct_pop) > 0) AS a
----
40

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM zones, (SELECT MAX(ct_pop) AS m FROM cities UNION ALL SELECT MIN(ct_pop) FROM cities) AS a
----
80

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM zones, cities
----
240
