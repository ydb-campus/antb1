# DATE and TIMESTAMP key types.
query III nosort
SELECT tr_row, RANK() OVER (PARTITION BY tr_day ORDER BY toDateTime(tr_row)), RANK() OVER (ORDER BY tr_day DESC) FROM trips ORDER BY tr_row LIMIT 12
----
