# W3: expectations are generated by DuckDB through slt-complete.

# Peers, gaps, NULL direction, multiple keys and multiple specifications.
query IIII nosort
SELECT id, RANK() OVER (PARTITION BY id % 3 ORDER BY i32 DESC NULLS FIRST), RANK() OVER (ORDER BY i16 ASC NULLS LAST, i32 DESC), RANK() OVER (ORDER BY CASE WHEN id < 7 THEN 1 ELSE 2 END) FROM edge ORDER BY id
----
INTEGER	BIGINT	BIGINT	BIGINT
0	4	1	1
1	1	10	1
2	3	5	1
3	3	4	1
4	3	6	1
5	1	12	1
6	2	8	1
7	4	3	8
8	2	11	8
9	1	9	8
10	2	2	8
11	4	7	8

# Window key literals are values, not select-list positions; no ordering means rank 1.
query IIII nosort
SELECT id, RANK() OVER (ORDER BY 1), RANK() OVER (), RANK() OVER (PARTITION BY i16) FROM edge ORDER BY id
----
INTEGER	BIGINT	BIGINT	BIGINT
0	1	1	1
1	1	1	1
2	1	1	1
3	1	1	1
4	1	1	1
5	1	1	1
6	1	1	1
7	1	1	1
8	1	1	1
9	1	1	1
10	1	1	1
11	1	1	1

# A repeated rank, a consuming CASE and a whole-partition aggregate share input rows.
query IIII nosort
SELECT id, RANK() OVER (ORDER BY i32), COUNT(*) OVER (PARTITION BY i16), CASE WHEN RANK() OVER (ORDER BY i32) > 2 THEN RANK() OVER (ORDER BY i32) ELSE 0 END FROM edge WHERE id > 1 ORDER BY id
----
INTEGER	BIGINT	BIGINT	BIGINT
2	4	1	4
3	3	1	3
4	5	1	5
5	9	2	9
6	8	1	8
7	1	1	0
8	6	2	6
9	9	1	9
10	7	1	7
11	2	1	0

# Raw GROUPING() values and ordinary aggregates feed the window stage after HAVING.
query IIII rowsort
SELECT i16, COUNT(*), RANK() OVER (PARTITION BY GROUPING(i16) ORDER BY SUM(i32) DESC), RANK() OVER (ORDER BY CASE WHEN GROUPING(i16) = 1 THEN 0 ELSE COUNT(*) END) FROM edge GROUP BY ROLLUP(i16) HAVING COUNT(*) > 0
----
SMALLINT	BIGINT	BIGINT	BIGINT
-1	1	7	2
-100	1	9	2
-12345	1	3	2
-32768	1	10	2
0	1	6	2
1	1	5	2
100	1	2	2
12345	1	11	2
32767	1	1	2
7	1	8	2
NULL	12	1	1
NULL	2	4	12

query IIR rowsort
SELECT i16, RANK() OVER (PARTITION BY GROUPING(i16) ORDER BY SUM(i32)), AVG(SUM(i32)) OVER (PARTITION BY GROUPING(i16)) FROM edge GROUP BY ROLLUP(i16)
----
SMALLINT	BIGINT	DOUBLE
-1	4	5432
-100	2	5432
-12345	8	5432
-32768	1	5432
0	5	5432
1	6	5432
100	9	5432
12345	11	5432
32767	10	5432
7	3	5432
NULL	1	54320
NULL	7	5432

# Hidden final-order windows preserve the selected global-aggregate projection.
query I nosort
SELECT COUNT(*) FROM edge ORDER BY RANK() OVER ()
----
BIGINT
12

query II nosort
SELECT id, i32 FROM edge ORDER BY RANK() OVER (ORDER BY i32 DESC), id LIMIT 5 OFFSET 2
----
INTEGER	INTEGER
10	54321
8	7
4	1
2	0
3	-1

query I nosort
SELECT DISTINCT RANK() OVER () FROM edge
----
BIGINT
1

