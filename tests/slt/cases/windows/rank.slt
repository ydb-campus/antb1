# Independent query blocks and set-operation branches.
query II rowsort
WITH w AS (SELECT id, RANK() OVER (ORDER BY i32) AS r FROM edge) SELECT id, RANK() OVER (ORDER BY r DESC) FROM w
----
INTEGER	BIGINT
0	12
1	3
10	5
11	10
2	8
3	9
4	7
5	1
6	4
7	11
8	6
9	1

