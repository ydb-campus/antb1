# Existing scalar subquery compositions use their respective binding stages.
query II nosort
SELECT id, RANK() OVER (ORDER BY i32) + (SELECT COUNT(*) FROM empty) FROM edge ORDER BY id
----
INTEGER	BIGINT
0	1
1	10
2	5
3	4
4	6
5	11
6	9
7	2
8	7
9	11
10	8
11	3

query II rowsort
SELECT i16, RANK() OVER (ORDER BY SUM(i32 + (SELECT COUNT(*) FROM empty))) FROM edge GROUP BY i16
----
SMALLINT	BIGINT
-1	4
-100	2
-12345	8
-32768	1
0	5
1	6
100	9
12345	11
32767	10
7	3
NULL	7

# The empty input stays empty; a global aggregate over it still contributes its one group.
query I nosort
SELECT RANK() OVER () FROM empty
----
BIGINT

query II nosort
SELECT COUNT(*), RANK() OVER (ORDER BY COUNT(*)) FROM empty
----
BIGINT	BIGINT
0	1

query I nosort
SELECT RANK() OVER (ORDER BY i32) FROM edge LIMIT 0
----
BIGINT
