# W2: expected results are generated by DuckDB through slt-complete.

# FLOAT MIN/MAX retain FLOAT comparisons, including memoized calls and derived output.
query III nosort
SELECT CASE WHEN MIN(f) OVER () = 0.1 THEN 1 ELSE 0 END, CASE WHEN MIN(f) OVER () = 0.1 THEN 2 ELSE 0 END, CASE WHEN MAX(f) OVER () = 0.1 THEN 3 ELSE 0 END FROM floats WHERE id = 0
----
INTEGER	INTEGER	INTEGER
1	2	3

query I nosort
SELECT COUNT(*) FROM (SELECT MIN(f) OVER () AS m FROM floats WHERE id = 0) AS w WHERE m = 0.1
----
BIGINT
1

# Date and timestamp averages keep their ordinary result types.
query TTT nosort
SELECT DISTINCT MIN(tr_day) OVER (), MAX(tr_day) OVER (), AVG(tr_day) OVER () FROM trips
----
DATE	DATE	TIMESTAMP
2026-03-01	2026-03-31	2026-03-15 23:16:05.673176

