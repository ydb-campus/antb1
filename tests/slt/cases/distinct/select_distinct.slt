# SELECT DISTINCT (ADR 0037's AG3, docs/sql-subset.md): the distinct rows of the select list, NULLs one value, DOUBLE
# -0.0 and 0.0 one value and every NaN one value, in any block.

query I rowsort
SELECT DISTINCT zn_parent FROM zones
----
INTEGER
1
2
3
4
5
77
NULL

query II rowsort
SELECT DISTINCT zn_parent % 3, zn_city FROM zones
----
INTEGER	SMALLINT
0	3
0	NULL
1	1
1	4
1	9
2	2
2	5
NULL	1
NULL	2
NULL	3
NULL	4
NULL	5

query TII rowsort
SELECT DISTINCT label, tr_rider % 4, tr_rider % 4 FROM trips JOIN cities ON tr_rider % 6 + 1 = ct_id
