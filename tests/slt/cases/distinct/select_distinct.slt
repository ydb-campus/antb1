query IT nosort
SELECT DISTINCT tr_rider % 5 AS r, 'x' FROM trips ORDER BY r DESC NULLS FIRST LIMIT 3 OFFSET 1
----
BIGINT	VARCHAR
4	x
3	x
2	x

query II nosort
SELECT DISTINCT tr_rider % 3, COUNT(*) // 50 AS band FROM trips GROUP BY tr_rider % 7, tr_rider % 3 HAVING COUNT(*) > 10 ORDER BY 1, 2
----
BIGINT	BIGINT
0	2
0	3
1	2
1	3
2	2
2	3
NULL	2

query I nosort
SELECT COUNT(*) FROM (SELECT DISTINCT tr_rider % 11, tr_driver % 2 FROM trips) AS d
----
BIGINT
36

query I nosort
WITH c AS (SELECT DISTINCT zn_city FROM zones) SELECT COUNT(*) FROM c
