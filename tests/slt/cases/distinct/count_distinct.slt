# COUNT(DISTINCT col) (docs/sql-subset.md): the number of distinct non-NULL values, BIGINT, 0 over no
# values. A DOUBLE -0.0 is 0.0 (and every NaN one value); VARCHAR compares by bytes.

query IIIIIIII nosort
SELECT COUNT(DISTINCT id), COUNT(DISTINCT i16), COUNT(DISTINCT i32), COUNT(DISTINCT i64), COUNT(DISTINCT u16), COUNT(DISTINCT d), COUNT(DISTINCT s), COUNT(DISTINCT u) FROM edge
----
12	10	10	10	10	10	10	10

# -0.0 and 0.0 are one value (a FLOAT column is read as DOUBLE; the count is BIGINT either way).

query II nosort
SELECT COUNT(DISTINCT f), COUNT(f) FROM floats
----
16	17

query I nosort
SELECT COUNT(DISTINCT f) FROM floats WHERE f < 1
----
7

query IIII nosort
SELECT COUNT(DISTINCT RegionID), COUNT(DISTINCT SearchPhrase), COUNT(DISTINCT EventDate), COUNT(DISTINCT UserID) FROM hits_like WHERE IsMobile = 0
----
4247	595	31	4936

# Over several files, and with NULLs.

query II nosort
SELECT count(distinct UserID), COUNT(DISTINCT "searchphrase") AS phrases FROM hits_like_split
----
9999	1103

query II nosort
SELECT COUNT(DISTINCT RegionID), COUNT(RegionID) FROM hits_like_nulls
----
7226	9215

# No rows, no values.

query II nosort
SELECT COUNT(DISTINCT RegionID), COUNT(DISTINCT Title) FROM hits_like WHERE RegionID < -1
----
0	0

query II nosort
SELECT COUNT(DISTINCT i32), COUNT(DISTINCT s) FROM edge WHERE id = 5
----
0	0

# Grouped: per group; a key with only NULL values counts 0.

query II rowsort
SELECT i16, COUNT(DISTINCT i32) FROM edge GROUP BY i16
----
-1	1
-100	1
-12345	1
-32768	1
0	1
1	1
100	1
12345	0
32767	1
7	1
NULL	1

