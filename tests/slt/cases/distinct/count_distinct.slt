query TI nosort
SELECT EventDate, COUNT(DISTINCT URL) FROM hits_like GROUP BY EventDate ORDER BY COUNT(DISTINCT URL) DESC, EventDate LIMIT 5
----
2013-07-02	351
2013-07-01	348
2013-07-03	345
2013-07-11	341
2013-07-18	338

# ORDER BY a COUNT(DISTINCT) the select list does not have.

query I nosort
SELECT OS FROM hits_like GROUP BY OS ORDER BY COUNT(DISTINCT RegionID) DESC, OS LIMIT 5
----
10
116
55
26
118

# Two levels (docs/adr/0014-two-level-aggregation.md): several distinct columns, other calls, a
# key with few values (each value's groups spread over the partitions), several keys, a DATE key.

query IIIIII rowsort
SELECT IsMobile, COUNT(DISTINCT UserID), COUNT(DISTINCT SearchPhrase), COUNT(*), MAX(RegionID), COUNT(DISTINCT UserID) FROM hits_like_split GROUP BY IsMobile
----
0	4936	595	4936	19994	4936
1	5064	640	5064	19998	5064

query TIIIT rowsort
SELECT EventDate, IsMobile, COUNT(DISTINCT RegionID), SUM(RegionID), MIN(SearchPhrase) FROM hits_like_nulls WHERE EventDate < DATE '2013-07-05' GROUP BY EventDate, IsMobile
