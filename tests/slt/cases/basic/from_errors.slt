# antb1's messages.

onlyif antb1
statement error ^parse: expected ON after the JOIN at offset 26, found end of input$
SELECT COUNT(*) FROM edge JOIN floats

onlyif antb1
statement error ^parse: a table alias cannot be the keyword SEMI; write it as a quoted identifier$
SELECT COUNT(*) FROM edge AS semi
