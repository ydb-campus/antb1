# After an ON condition, time travel and TABLESAMPLE have no meaning.

statement error
SELECT COUNT(*) FROM edge JOIN floats ON edge.id = floats.id TABLESAMPLE 10%

onlyif duckdb
statement error ^Parser Error:
SELECT COUNT(*) FROM edge JOIN floats ON edge.id = floats.id TABLESAMPLE 10%

statement error
SELECT COUNT(*) FROM edge JOIN floats ON edge.id = floats.id AT (VERSION => 1)

onlyif duckdb
statement error ^Parser Error:
