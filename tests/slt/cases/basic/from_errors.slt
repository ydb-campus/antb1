# An aggregate in ON: a syntax error in antb1, a binder error in DuckDB.

statement error
SELECT COUNT(*) FROM edge JOIN floats ON SUM(edge.id) = floats.id

onlyif duckdb
statement error ^Binder Error:
SELECT COUNT(*) FROM edge JOIN floats ON SUM(edge.id) = floats.id

# Aliases: one per item, a string only after AS, no reserved word.

statement error
SELECT COUNT(*) FROM edge e f

