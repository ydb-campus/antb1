# FROM lists, joins and aliases that both engines reject as malformed. antb1 must fail with a
# syntax error, never Unsupported, and each record's `onlyif duckdb` twin checks that DuckDB fails
# in its parser too (or its binder, for an aggregate in ON): a statement that antb1 wrongly calls a
# syntax error would parse in DuckDB and fail the twin. The tables are registered and the columns
# real, so no record fails on a missing name instead.

# JOIN without its ON, ON without its JOIN, and join keywords without the rest.

statement error
SELECT COUNT(*) FROM edge JOIN floats

onlyif duckdb
statement error ^Parser Error:
SELECT COUNT(*) FROM edge JOIN floats

statement error
SELECT COUNT(*) FROM edge JOIN floats, decimals ON edge.id = floats.id

onlyif duckdb
statement error ^Parser Error:
SELECT COUNT(*) FROM edge JOIN floats, decimals ON edge.id = floats.id

statement error
SELECT COUNT(*) FROM edge CROSS JOIN floats ON edge.id = floats.id

onlyif duckdb
statement error ^Parser Error:
SELECT COUNT(*) FROM edge CROSS JOIN floats ON edge.id = floats.id

statement error
SELECT COUNT(*) FROM edge, floats ON edge.id = floats.id

onlyif duckdb
statement error ^Parser Error:
SELECT COUNT(*) FROM edge, floats ON edge.id = floats.id

statement error
