# FROM '<path>': a file, a glob (sorted matches) or a single part of a split table.

query I nosort
SELECT COUNT(*) FROM '${FIXTURES}/hits_like.parquet'
----
BIGINT
10000

query I nosort
SELECT COUNT(*) FROM '${FIXTURES}/hits_like_split/part-*.parquet'
----
BIGINT
10000

query I nosort
SELECT COUNT(*) FROM '${FIXTURES}/hits_like_split/part-2.parquet'
----
BIGINT
2500

query I nosort
SELECT COUNT(*) FROM '${FIXTURES}/hits_like_split/part-[01].parquet'
----
BIGINT
4000

query I nosort
SELECT COUNT(*) FROM '${FIXTURES}/edge.parquet'
----
BIGINT
12

query I nosort
SELECT COUNT(*) FROM '${FIXTURES}/empty.parquet'
----
BIGINT
0
