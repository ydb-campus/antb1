# String functions (docs/sql-subset.md): strlen(varchar) is its length in bytes (BIGINT);
# regexp_replace(varchar, pattern, replacement) replaces the first match (RE2, as in DuckDB: `.` is
# one UTF-8 character and does not match a newline; \0 and \1 in the replacement).

query TII rowsort
SELECT u, strlen(u), STRLEN(u) * 2 FROM edge
----
(empty)	0	0
NULL	NULL	NULL
NULL	NULL	NULL
\x28empty)	7	14
a	1	2
back\\slash	10	20
line\nbreak	10	20
tab\there	8	16
trailing space\x20	15	30
x\x7fy	3	6
Привет, мир	20	40
日本語	9	18

