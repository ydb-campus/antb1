query I nosort
SELECT COUNT(*) FROM edge WHERE strlen(u) > 5 AND regexp_replace(u, ' ', '') LIKE '%a%'
----
4

query IR nosort
SELECT COUNT(*), AVG(strlen(URL)) FROM hits_like WHERE URL <> ''
----
9805	39.106068332483424

# Grouping by string function results, with aggregates of them and HAVING, over the fixture data.
query III nosort
SELECT OS, MAX(strlen(Title)) AS m, SUM(strlen(URL)) AS total FROM hits_like WHERE strlen(URL) > 30 GROUP BY OS ORDER BY total DESC, OS LIMIT 4
----
10	49	4113
116	48	3983
118	51	3924
26	45	3920

query TII nosort
SELECT regexp_replace(URL, '^([a-z]+)://.*$', '\1') AS scheme, COUNT(*), MIN(strlen(URL)) FROM hits_like GROUP BY scheme HAVING COUNT(*) > 5 ORDER BY scheme
----
(empty)	195	0
https	9805	31

query TIT nosort
SELECT regexp_replace(Referer, '^[^/]*//[^/]*/([^/?]*).*$', 'seg:\1') AS seg, COUNT(*) AS n, MAX(Referer) FROM hits_like WHERE Referer LIKE 'http%' GROUP BY 1 ORDER BY n DESC, seg LIMIT 5
----
seg:дорога	269	https://ref.example.org/дорога/99884?q=orbit
seg:cloud	268	https://ref.example.org/cloud/99935
seg:stone	265	https://ref.example.org/stone/99758
seg:naïve	262	https://ref.example.org/naïve/99791
seg:pixel	260	https://ref.example.org/pixel/99525

# Assertions see the whole value, not the match alone (\b, \B, ^ and $ inside alternatives).
query TTTTTT rowsort
SELECT u, regexp_replace(u, 'a\B', 'Z'), regexp_replace(u, '(a)$|(a)', '[\1]'), regexp_replace(u, '\B(e)|(e)', '[\1]'), regexp_replace(u, '\b', '|'), regexp_replace(u, '(?m)^t|k$', '#') FROM edge
----
(empty)	(empty)	(empty)	(empty)	(empty)	(empty)
NULL	NULL	NULL	NULL	NULL	NULL
NULL	NULL	NULL	NULL	NULL	NULL
\x28empty)	\x28empty)	\x28empty)	([]mpty)	(|empty)	\x28empty)
a	a	[a]	a	|a	a
back\\slash	bZck\\slash	b[]ck\\slash	back\\slash	|back\\slash	back\\slash
line\nbreak	line\nbreZk	line\nbre[]k	lin[e]\nbreak	|line\nbreak	line\nbrea#
tab\there	tZb\there	t[]b\there	tab\th[e]re	|tab\there	#ab\there
trailing space\x20	trZiling space\x20	tr[]iling space\x20	trailing spac[e]\x20	|trailing space\x20	#railing space\x20
x\x7fy	x\x7fy	x\x7fy	x\x7fy	|x\x7fy	x\x7fy
Привет, мир	Привет, мир	Привет, мир	Привет, мир	Привет, мир	Привет, мир
日本語	日本語	日本語	日本語	日本語	日本語

# A replacement RE2 rejects (a group the pattern does not have, a lone or unknown backslash) leaves
# the text unchanged, as in DuckDB; \\ is one backslash.
query TTTTT rowsort
SELECT u, regexp_replace(u, 'a', '\1'), regexp_replace(u, '(a)', '\2'), regexp_replace(u, 'a', 'x\'), regexp_replace(u, 'a', '[\\]') FROM edge
----
(empty)	(empty)	(empty)	(empty)	(empty)
NULL	NULL	NULL	NULL	NULL
NULL	NULL	NULL	NULL	NULL
\x28empty)	\x28empty)	\x28empty)	\x28empty)	\x28empty)
a	a	a	a	[\\]
back\\slash	back\\slash	back\\slash	back\\slash	b[\\]ck\\slash
line\nbreak	line\nbreak	line\nbreak	line\nbreak	line\nbre[\\]k
tab\there	tab\there	tab\there	tab\there	t[\\]b\there
trailing space\x20	trailing space\x20	trailing space\x20	trailing space\x20	tr[\\]iling space\x20
x\x7fy	x\x7fy	x\x7fy	x\x7fy	x\x7fy
Привет, мир	Привет, мир	Привет, мир	Привет, мир	Привет, мир
日本語	日本語	日本語	日本語	日本語

statement error
SELECT regexp_replace(u, '(', 'x') FROM edge

# ---- substring (ADR 0023's S5): codepoints, as DuckDB counts them ----

# strlen counts bytes and substring counts codepoints, so a window of 3 codepoints over a multi-byte
# value is more than 3 bytes long: the two columns differ exactly where the value is not ASCII
# (divergence D15). All four spellings are the one call, so the byte counts agree.
query TIIIII rowsort
SELECT u, strlen(u), strlen(substring(u, 2, 3)), strlen(substring(u FROM 2 FOR 3)), strlen(substring(u FROM 2)), strlen(substr(u, 2, 3)) FROM edge
----
(empty)	0	0	0	0	0
NULL	NULL	NULL	NULL	NULL	NULL
NULL	NULL	NULL	NULL	NULL	NULL
\x28empty)	7	3	3	6	3
a	1	0	0	0	0
back\\slash	10	3	3	9	3
line\nbreak	10	3	3	9	3
tab\there	8	3	3	7	3
trailing space\x20	15	3	3	14	3
x\x7fy	3	2	2	2	2
Привет, мир	20	6	6	18	6
日本語	9	6	6	6	6


# The window, over literals: a negative start counts from the end, a negative length extends the
# window backwards, a zero start reaches before the first codepoint, a start past the end keeps
# nothing, and the two-argument form reaches the end.
query TTTTTTTT nosort
SELECT substring('aдb日x', 2, 3), substring('aдb日x' FROM 1 FOR 2), substring('aдb日x', -2, 2), substring('aдb日x', 2, -1), substring('aдb日x', 0, 3), substring('aдb日x', 99, 2), substring('aдb日x', 3), substring('aдb日x', -4294967296, 2) FROM edge LIMIT 1
----
дb日	aд	日x	a	aд	(empty)	b日x	(empty)


# A window that closes before it opens, and one clamped from far below: both are the empty string,
# and a negative length of any magnitude only clips.
query TTTT nosort
SELECT substring('aдb日x', 2, -99), substring('aдb日x', 3, -4294967296), substring('', 1, 2), substring('aдb日x', 4294967295, 2) FROM edge LIMIT 1
----
a	aд	(empty)	(empty)

# The positions are expressions, evaluated per row, and a NULL in either gives NULL: CASE leaves one
# NULL where the value is short.
query TII rowsort
SELECT u, strlen(substring(u, strlen(u) - 1, 2)), strlen(substring(u, CASE WHEN strlen(u) > 3 THEN 2 END, 2)) FROM edge
----
(empty)	0	NULL
NULL	NULL	NULL
NULL	NULL	NULL
\x28empty)	2	2
a	1	NULL
back\\slash	2	2
line\nbreak	2	2
tab\there	2	2
trailing space\x20	2	2
x\x7fy	2	NULL
Привет, мир	0	4
日本語	0	6

# Without a length DuckDB does not reach the end of the value: it defaults the length to 4294967295,
# which shows only at the bottom of the start's range. One codepoint short at -4294967296, the whole
# value at -4294967295, and the three-argument form with that length agrees with the two-argument one.
query TTTT rowsort
SELECT u, substring(u, -4294967296), substring(u, -4294967295), substring(u, -4294967296, 4294967295) FROM edge
----
(empty)	(empty)	(empty)	(empty)
NULL	NULL	NULL	NULL
NULL	NULL	NULL	NULL
\x28empty)	(empty	\x28empty)	(empty
a	(empty)	a	(empty)
back\\slash	back\\slas	back\\slash	back\\slas
line\nbreak	line\nbrea	line\nbreak	line\nbrea
tab\there	tab\ther	tab\there	tab\ther
trailing space\x20	trailing space	trailing space\x20	trailing space
x\x7fy	x\x7f	x\x7fy	x\x7f
Привет, мир	Привет, ми	Привет, мир	Привет, ми
日本語	日本	日本語	日本

# A start or a length outside [-4294967296, 4294967295] fails the query when it runs, one message
# per side of each bound.
statement error
SELECT substring(u, -4294967297, 2) FROM edge

statement error
SELECT substring(u, 1, -4294967297) FROM edge

# DuckDB's own bound on a position: a start or a length above 4294967295 fails the query when it
# runs, while a negative one of any magnitude only clips (above).
statement error
SELECT substring(u, 4294967296, 1) FROM edge

statement error
SELECT substring(u, 1, 4294967296) FROM edge
