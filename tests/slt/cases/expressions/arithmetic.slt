statement error Overflow in addition
SELECT i32 + 2147483647 + CAST(1 + -1 AS INTEGER) FROM edge

# A constant that overflows under a cast stays unfolded too: computed, it fails on the first row, and only there.
statement error Overflow in addition
SELECT CAST(2147483647 + 1 AS BIGINT) FROM edge

query I nosort
SELECT COUNT(*) FROM (SELECT CAST(2147483647 + 1 AS BIGINT) AS c FROM empty) AS e
----
BIGINT
0

query II rowsort
SELECT id, CASE WHEN id > 100 THEN CAST(2147483647 + 1 AS INTEGER) ELSE 0 END FROM edge WHERE id < 3
----
INTEGER	INTEGER
0	0
1	0
2	0

# IS DISTINCT FROM moves as <> does, and tests the operand the moves leave for NULL.
query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + 2147483647 + 1 IS DISTINCT FROM 2147483648 - 1
----
BIGINT
11

# Where an = would be decided FALSE (the moved constant leaves the type) or a <> TRUE (the constant does not divide),
# IS [NOT] DISTINCT FROM is not: the operand is computed.
statement error Overflow in addition
SELECT COUNT(*) FROM edge WHERE i32 + 1 IS NOT DISTINCT FROM -2147483648

statement error Overflow in multiplication
SELECT COUNT(*) FROM edge WHERE i32 * 2 IS DISTINCT FROM 3

# Inside an expression IS NOT DISTINCT FROM tests the operand the moves leave for NULL, under a NOT.
query I nosort
SELECT SUM(CASE WHEN i32 + 2147483647 + 1 IS NOT DISTINCT FROM 2147483648 - 1 THEN 1 ELSE 0 END) FROM edge
----
HUGEINT
1

# NOT over a comparison is the comparison it flips, as DuckDB's parser writes it: NOT (x = k) is x <> k, which a moved
# constant that leaves the type never decides. So 30000 + i16 is computed here, and in the CASE the chain regroups to
# i32, where the = alone computes i32 + 1.
statement error Overflow in addition
SELECT COUNT(*) FROM edge WHERE NOT (2 + (30000 + i16) = 2999997233 - 3000000000)

query I nosort
SELECT SUM(CASE WHEN NOT (i32 + 1 + -1 - 0 = 2147483648 - 1) THEN 1 ELSE 0 END) FROM edge
----
HUGEINT
9

# An ordered comparison keeps its NOT: NaN (d % 0) makes d < 1 false, and so NOT (d < 1) true, in both engines.
query I nosort
SELECT COUNT(*) FROM edge WHERE NOT (d % 0 < 1)
----
BIGINT
10

# A widening cast is moved through where the constant fits its operand's type; and a SMALLINT operand widened by a
# constant that is no literal, (1 - 1), moves on into it.
query I nosort
SELECT COUNT(*) FROM edge WHERE CAST(i16 AS INTEGER) + 1 > 5
----
BIGINT
4

query I nosort
SELECT COUNT(*) FROM edge WHERE (i16 + 30000) + (1 - 1) > 5
----
BIGINT
9

# Where the moved constant does not fit the narrower type, the operand is compared behind its cast, and computed.
statement error Overflow in addition
SELECT COUNT(*) FROM edge WHERE i16 + 30000 + 70000 < 5

# Every integer type moves, USMALLINT too, and constants of // and % fold first.
query I nosort
SELECT COUNT(*) FROM edge WHERE u16 + 1 > 5
----
BIGINT
7

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + (4 // 2) + 1 > 5
----
BIGINT
4

query I nosort
SELECT SUM(i32 + (4 // 2) + 1) FROM edge
----
HUGEINT
54350

# The sum rewrite reads a USMALLINT operand of an INTEGER sum through a cast, as DuckDB does: u16 + 2147483647 is never
# computed.
query I nosort
SELECT SUM(u16 + 2147483647) FROM edge
----
HUGEINT
21475006599

# GROUP BY () and empty grouping sets group by no key, so the sum rewrite applies there too.
query I nosort
SELECT SUM(i32 + 1) FROM edge GROUP BY ()
----
