# Constants move in HAVING and in conditions over the aggregation too (DuckDB's optimizer), so the
# arithmetic over a key or an aggregate is never computed and 32767 + 30000 never overflows.
query II rowsort
SELECT i16, COUNT(*) FROM edge GROUP BY i16 HAVING i16 + 30000 > 5
----
SMALLINT	BIGINT
-1	1
-100	1
-12345	1
0	1
1	1
100	1
12345	1
32767	1
7	1

