# The sum rewrite and constant moving read the chain as DuckDB's optimizer leaves it: SUM(x + 1 + 2) is one rewrite,
# with 3; x + 2147483647 + 1 is computed; constants that lead a chain stay apart, so SUM(1 + (2 + x)) counts 2 + x.
query I nosort
SELECT SUM(i32 + 1 + 2) FROM edge
----
HUGEINT
54350

statement error Overflow in addition
SELECT SUM(i32 + 2147483647 + 1) FROM edge

statement error Overflow in addition
SELECT SUM(1 + (2 + i32)) FROM edge

query I nosort
SELECT SUM(1 + (2 + i32)) FROM edge WHERE id <> 1
----
HUGEINT
-2147429300

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + 1 + 2 > 5
----
BIGINT
4

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + 1 + -1 >= 2147483647
----
BIGINT
1

statement error Overflow in addition
SELECT COUNT(*) FROM edge WHERE i32 + 2147483647 + 1 > 5

statement error Overflow in addition
SELECT COUNT(*) FROM edge WHERE i32 + 1 + 2 IN (4, 13)

# Against a constant expression of a wider type (2147483648 - 1 is a BIGINT) DuckDB moves the constants off the chain
# as written first, as long as each is of the chain's own type: an INTEGER literal in an INTEGER chain, but not in a
# SMALLINT one.
query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + 2147483647 + 1 > 2147483648 - 1
----
BIGINT
6

statement error Overflow in addition
SELECT COUNT(*) FROM edge WHERE i16 + 32767 + 1 > 2147483648 - 2147483643

query II rowsort
SELECT i16, COUNT(*) FROM edge GROUP BY i16 HAVING i16 + 1 + 2 > 5
----
SMALLINT	BIGINT
100	1
12345	1
32767	1
7	1

statement error Overflow in addition
SELECT i16 FROM edge GROUP BY i16 HAVING i16 + 30000 + 30000 > 5

# Over no rows nothing is computed, except the one row an aggregate without GROUP BY makes.
query I nosort
SELECT SUM(RegionID + 2147483647 + 1) FROM empty
----
HUGEINT
NULL

statement error Overflow in addition
SELECT MAX(RegionID) + 2147483647 + 1 FROM empty

# Constants move in the order DuckDB's rewriter gives them: one pass over the operand, then the moves it allows, then
# another pass. The * 1 the first pass removes lets 2147483647 move before a pass could regroup it with the 1.
query I nosort
SELECT COUNT(*) FROM edge WHERE (i32 + 2147483647) * 1 + 1 > 5
----
BIGINT
9

query I nosort
SELECT SUM(CASE WHEN (i32 + 2147483647) * 1 + 1 > 5 THEN 1 ELSE 0 END) FROM edge
----
HUGEINT
9

query I nosort
SELECT COUNT(*) FROM edge WHERE (i64 + 3) * 1 + 9223372036854775807 <= 5
----
BIGINT
1

# An = whose moved constant leaves the type is FALSE, NULL for a NULL operand, which is still computed: in CASE WHEN
# that computes i32 + 1, and fails at the maximum.
query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + 1 + -1 - 0 = 2147483648 - 1
----
BIGINT
0

statement error Overflow in addition
SELECT SUM(CASE WHEN i32 + 1 + -1 - 0 = 2147483648 - 1 THEN 1 ELSE 0 END) FROM edge

# Against a BETWEEN bound of a wider type both comparisons move as written: NOT BETWEEN too, over a join and in HAVING.
query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + 2147483647 + 1 BETWEEN 4 AND 2147483648 - 1
----
BIGINT
3

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + 2147483647 + 1 NOT BETWEEN 4 AND 2147483648 - 1
----
BIGINT
7

query I nosort
SELECT COUNT(*) FROM edge AS a JOIN edge AS b ON a.id = b.id WHERE a.i32 - b.i32 + 2147483647 + 1 BETWEEN 4 AND 2147483648 - 1
----
BIGINT
0

# A BETWEEN over two relations whose one comparison reads one of them still compares both in the type of all three.
query I nosort
SELECT COUNT(*) FROM edge AS a JOIN edge AS b ON a.id = b.id WHERE a.i32 <> -2147483648 AND a.i32 + 2147483647 + 1 BETWEEN b.i64 AND 5
----
BIGINT
0

query I rowsort
SELECT i32 FROM edge GROUP BY i32 HAVING i32 + 2147483647 + 1 BETWEEN 4 AND 2147483648 - 1
----
INTEGER
-1
-100000
-7

# DuckDB compares a BETWEEN in the type of all three values: a literal or a column bound the operand's type does not
# hold widens it for both comparisons, and a decimal literal such as 3.5 moves nothing, so i32 - 1 is computed.
query I nosort
SELECT COUNT(*) FROM edge WHERE i32 <> -2147483648 AND i32 + 2147483647 + 1 BETWEEN -3000000000 AND 5
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 <> -2147483648 AND i32 + 2147483647 + 1 BETWEEN i64 AND 5
----
BIGINT
0

statement error Overflow in subtraction
SELECT COUNT(*) FROM edge WHERE i32 - 1 BETWEEN 0 AND 3.5

# Behind such a cast the operand is still computed as its rewrite leaves it: i32 + 1 + -1 is i32.
query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + 1 + -1 BETWEEN 0 AND 3e0
----
BIGINT
2

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + 1 + -1 BETWEEN 0 AND 3.5
----
BIGINT
2

# A cast at the top of the operand is dropped before the operand's first pass, so its constants move as written; a
# USMALLINT chain against a wider constant expression stays computed behind its cast, which DuckDB never drops.
query I nosort
SELECT COUNT(*) FROM edge WHERE CAST(i32 + 2147483647 + 1 AS BIGINT) > 2147483647
----
BIGINT
6

statement error Overflow in addition
SELECT SUM(CASE WHEN u16 + 0 + 1 = 1 + 1 THEN 1 ELSE 0 END) FROM edge

# A cast to a value's own type is none, as DuckDB's binder writes none: the chain regroups in the first pass and
# overflows. DuckDB drops a narrowing cast and one to a DECIMAL of scale 0 too, so their constants move.
statement error Overflow in addition
SELECT COUNT(*) FROM edge WHERE CAST(i32 + 2147483647 + 1 AS INTEGER) > 5

query I nosort
SELECT COUNT(*) FROM edge WHERE CAST(i64 + 1 AS INTEGER) > 5
----
BIGINT
4

query I nosort
SELECT COUNT(*) FROM edge WHERE CAST(i32 + 1 AS SMALLINT) > 5
----
BIGINT
4

query I nosort
SELECT COUNT(*) FROM edge WHERE CAST(i32 + 1 AS DECIMAL(12,0)) > 5
----
BIGINT
4

# A cast is dropped only where k fits the cast's own type too: otherwise DuckDB compares in a wider type, behind a
# cast it cannot drop, and computes the cast. A DECIMAL of scale 0 casts as an integer type does; under a cast to a
# value's own type the cast below is still the one at the top.
statement error can't be cast
SELECT COUNT(*) FROM edge WHERE CAST(i32 AS SMALLINT) <> 50000

statement error Overflow in addition
SELECT COUNT(*) FROM edge WHERE CAST(i32 + 1 AS SMALLINT) + 0 < 40000

query I nosort
SELECT COUNT(*) FROM edge WHERE CAST(CAST(i32 + 2147483647 + 1 AS BIGINT) AS BIGINT) > 5
----
BIGINT
9

query I nosort
SELECT COUNT(*) FROM decimals WHERE CAST(d38_0 AS BIGINT) > 5
----
BIGINT
14

query I nosort
SELECT COUNT(*) FROM decimals WHERE CAST(d9_2 AS DECIMAL(5,2)) > 2
----
BIGINT
11

statement error Failed to cast decimal value
SELECT COUNT(*) FROM decimals WHERE CAST(d38_0 AS SMALLINT) <> 40000

query I nosort
SELECT COUNT(*) FROM decimals WHERE CAST(b + 1 AS DECIMAL(19,0)) > 5
----
BIGINT
15

# A decimal k of scale 0 (5.) is an integer compared in a DECIMAL, so its constants move as written first; one of
# another scale (5.0) moves nothing. A literal operand of a BETWEEN takes the type of a bound it fits.
query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + 2147483647 + 1 <= 5.
----
BIGINT
1

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + 2147483647 + 1 BETWEEN 0 AND 5.
----
BIGINT
1

statement error Overflow in addition
SELECT COUNT(*) FROM edge WHERE i32 + 2147483647 + 1 <= 5.0

query I nosort
SELECT COUNT(*) FROM edge WHERE 5 BETWEEN u16 + 1 AND u16 + 10
----
BIGINT
3

