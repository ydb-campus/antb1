# Mixed types take the wider one, with a literal that fits the other operand's type.
query II rowsort
SELECT i16 + i32, u16 + i16 FROM edge WHERE id IN (1, 2, 3) AND i32 < 100000 AND i32 > -100000
----
INTEGER	BIGINT
-2	32767
0	1

# Overflows are errors in both engines.
statement error
SELECT i16 + 1 FROM edge

statement error
SELECT i64 * 2 FROM edge

statement error
SELECT -i32 FROM edge

# SUM(x + constant) never computes x + constant (DuckDB's sum rewriter): no overflow.
query IIII nosort
SELECT SUM(i16 + 1), SUM(1 + (i16 + 1)), SUM(i64 + 1), COUNT(i16) FROM edge
----
HUGEINT	HUGEINT	HUGEINT	BIGINT
16	26	16	10

query I nosort
SELECT SUM(i32 + 2147483647) FROM edge
----
HUGEINT
21474890790

# The constant is folded in DuckDB's types: 2147483646 + 1 fits INTEGER, so the SUM is rewritten as above, while
# 2147483647 + 1 and 65536 * 32768 overflow it and are left unfolded, so they are computed and fail, as in DuckDB,
# and the rewrites of SUM and of a comparison do not apply. Over no rows nothing is computed.
query I nosort
SELECT SUM(i32 + (2147483646 + 1)) FROM edge
----
HUGEINT
21474890790

statement error Overflow in addition
SELECT SUM(i32 + (2147483647 + 1)) FROM edge

statement error Overflow in multiplication
SELECT SUM(i32 + 65536 * 32768) FROM edge

query I nosort
SELECT COUNT(*) FROM edge WHERE i32 + (2147483646 + 1) > 5
----
BIGINT
9

statement error Overflow in addition
SELECT COUNT(*) FROM edge WHERE i32 + (2147483647 + 1) > 5

statement error Overflow in addition
SELECT SUM(CASE WHEN i32 + (2147483647 + 1) > 5 THEN 1 ELSE 0 END) FROM edge

statement error Overflow in addition
SELECT i16, COUNT(*) FROM edge GROUP BY i16 HAVING i16 + (2147483647 + 1) > 5

statement error Overflow in addition
SELECT i16 FROM edge GROUP BY i16 HAVING MIN(i32) + (2147483647 + 1) > 5

statement error Overflow in addition
SELECT COUNT(*) FROM edge WHERE i64 + (9223372036854775807 + 1) > 5

statement error Overflow in subtraction
SELECT SUM(i32 + (-2147483647 - 2)) FROM edge

statement error Overflow in addition
SELECT COUNT(*) FROM edge WHERE (2147483647 + 1) - i32 > 5

query I nosort
SELECT COUNT(*) FROM empty WHERE RegionID + (2147483647 + 1) > 5
----
BIGINT
0

# DuckDB's optimizer moves the constants of a + or * chain of one integer type to its front and folds them, in that
# type, before anything else reads the chain: x + 1 + -1 computes nothing and x * 2 * 0 is 0, so neither overflows at
# INT_MAX, while i16 + 30000 + 30000 and x + 2147483647 + 1 add their constants first, which fails on every row.
query I rowsort
SELECT i32 + 1 + -1 FROM edge
----
INTEGER
-1
-100000
-2147483648
-7
0
1
100000
2147483647
54321
7
NULL
NULL

