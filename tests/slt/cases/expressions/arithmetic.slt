query II nosort
SELECT RegionID, SUM(ResolutionWidth) * 2 - 1 AS s FROM hits_like GROUP BY RegionID HAVING SUM(ResolutionWidth) + 1 > 30000 AND COUNT(*) > 1 ORDER BY s DESC, RegionID LIMIT 5
----
0	833075

