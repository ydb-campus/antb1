# DuckDB's optimizer moves the constant of x + c <op> k (and x - c, c - x, x * c when c divides k)
# to the literal for a signed integer x: the arithmetic is never computed, so it never overflows.
query II nosort
SELECT COUNT(*), SUM(i32 // 1000) FROM edge WHERE i16 + 1 > 0
----
BIGINT	HUGEINT
6	2147583

