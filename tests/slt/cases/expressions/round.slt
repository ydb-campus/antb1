# round of a DOUBLE (ADR 0037's FN2, docs/sql-subset.md): half away from zero, and at n digits round(x * 10^n) / 10^n
# computed in double, so a halfway case is decided on the binary product; the value itself where that is not finite.

query RRRR nosort
SELECT tr_row / 8, round(tr_row / 8), round(tr_row / 8, 1), round(-(tr_row / 8)) FROM trips WHERE tr_row < 12 ORDER BY tr_row
----
DOUBLE	DOUBLE	DOUBLE	DOUBLE
0	0	0	-0
0.125	0	0.1	-0
0.25	0	0.3	-0
0.375	0	0.4	-0
0.5	1	0.5	-1
0.625	1	0.6	-1
0.75	1	0.8	-1
0.875	1	0.9	-1
1	1	1	-1
1.125	1	1.1	-1
1.25	1	1.3	-1
1.375	1	1.4	-1

query RR nosort
SELECT round(tr_fare / 3, 2), round(tr_fare / 7, 4) FROM trips WHERE tr_row < 6 ORDER BY tr_row
----
DOUBLE	DOUBLE
1.17	0.5
3.58	1.5357
6	2.5714
8.42	3.6071
2.75	1.1786
5.17	2.2143

query R nosort
SELECT round(SUM(tr_fare) / COUNT(*), 3) FROM trips
----
DOUBLE
14.998

query IR nosort
SELECT ct_id, round(AVG(zn_id) / 3, 2) AS r FROM cities JOIN zones ON ct_id = zn_city GROUP BY ct_id ORDER BY r DESC, ct_id
----
SMALLINT	DOUBLE
5	7.5
2	6.5
4	6.33
1	6.17
3	6

query I nosort
SELECT COUNT(*) FROM trips WHERE round(tr_fare / 4, 1) > 5
----
BIGINT
897
