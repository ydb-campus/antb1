INTEGER	SMALLINT
7	3
7	2
7	1
7	0
7	1
7	2

statement error
SELECT abs(i16) FROM edge

query I nosort
SELECT abs(SUM(i64) - 1) FROM edge
----
HUGEINT
5

query D nosort
SELECT abs(SUM(d38_10)) FROM decimals
----
DECIMAL(38,10)
9019544933642220.0677999994

query RRR nosort
SELECT abs(-(tr_fare / 4 * 0)), abs(tr_fare / 0 - tr_fare / 0), abs(-(tr_fare / 4)) FROM trips WHERE tr_row = 3
----
DOUBLE	DOUBLE	DOUBLE
0	nan	6.3125
