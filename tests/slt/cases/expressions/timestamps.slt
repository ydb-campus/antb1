query IIII nosort
SELECT COUNT(DISTINCT date_trunc('hour', toDateTime(EventTime))), MIN(extract(minute FROM toDateTime(EventTime))), MAX(extract(SECOND FROM toDateTime(EventTime))), SUM(extract(day FROM EventDate)) FROM hits_like
----
744	0	59	159009

query IT nosort
SELECT extract(year FROM EventDate) + extract(month FROM EventDate) AS ym, date_trunc('quarter', EventDate) FROM hits_like GROUP BY ym, 2 ORDER BY ym
----
2020	2013-07-01 00:00:00

# SMALLINT seconds: t * 1000 is SMALLINT, so only |t| <= 32 fits; before 1970 the fields and the
# floors count forward from the earlier minute.
query IITTI rowsort
SELECT id, i16, toDateTime(i16), date_trunc('minute', toDateTime(i16)), extract(second FROM toDateTime(i16)) FROM edge WHERE i16 > -30 AND i16 < 30
----
11	7	1970-01-01 00:00:07	1970-01-01 00:00:00	7
2	0	1970-01-01 00:00:00	1970-01-01 00:00:00	0
3	-1	1969-12-31 23:59:59	1969-12-31 23:59:00	59
4	1	1970-01-01 00:00:01	1970-01-01 00:00:00	1

statement error
SELECT toDateTime(i16) FROM edge

query TI nosort
SELECT date_trunc('minute', toDateTime(EventTime)) AS m, COUNT(*) AS n FROM hits_like WHERE IsMobile = 1 GROUP BY date_trunc('minute', toDateTime(EventTime)) ORDER BY n DESC, m LIMIT 3
----
2013-07-01 07:07:00	3
2013-07-02 02:10:00	3
2013-07-04 16:09:00	3
