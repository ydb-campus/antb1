# Timestamps (docs/sql-subset.md): toDateTime(t) is ClickBench's DuckDB macro epoch_ms(t * 1000),
# which the oracle defines too; EXTRACT gives a civil field (BIGINT) and date_trunc floors to a
# unit (TIMESTAMP), of a TIMESTAMP or a DATE.

query IT nosort
SELECT WatchID, toDateTime(EventTime) FROM hits_like ORDER BY toDateTime(EventTime), WatchID LIMIT 5
----
-5710738549102838321	2013-07-01 00:00:12
4549861687281455148	2013-07-01 00:04:39
4633950225288126837	2013-07-01 00:08:26
-3257945427840127124	2013-07-01 00:14:49
-6037482844893101369	2013-07-01 00:16:03

