# Derived tables and common table expressions (ADR 0022, rules 1, 7 and 8) over the star schema: column alias lists,
# names of derived tables without an alias, de-duplicated output names, ORDER BY with LIMIT inside, aggregates over
# aggregates, a CTE that hides a table, an unused CTE and a CTE referenced twice.

# ---- the inputs, one table at a time ----

query II rowsort
SELECT tr_pickup, COUNT(*) FROM trips WHERE tr_pickup > 38 GROUP BY tr_pickup
----
39	69
40	69
41	69
42	69
43	69

query II nosort
SELECT COUNT(*), MAX(ct_id) FROM cities
----
6	6

# ---- pending: derived tables and CTEs (ADR 0022; roadmap PR J4 removes these guards) ----

# A column alias list shorter than the select list renames the first columns.
pending J4
query II rowsort
SELECT d, n FROM (SELECT tr_pickup, COUNT(*) AS n FROM trips GROUP BY tr_pickup) AS g(d) WHERE d > 38
----
39	69
40	69
41	69
42	69
43	69

# A derived table without an alias is unnamed_subquery, the next unnamed_subquery2.
pending J4
query I nosort unnamed
SELECT unnamed_subquery.n FROM (SELECT COUNT(*) AS n FROM trips)
----
3000

pending J4
query I nosort unnamed
SELECT n FROM (SELECT COUNT(*) AS n FROM trips)
----
3000

pending J4
query II rowsort
SELECT unnamed_subquery.z, unnamed_subquery2.c FROM (SELECT zn_id AS z, zn_city AS zc FROM zones), (SELECT ct_id AS c FROM cities)
WHERE zc = c AND z <= 3
----
1	1
2	2
3	3

# Output names are de-duplicated: the second tr_driver is tr_driver_1.
pending J4
query III nosort
SELECT COUNT(*), MIN(tr_driver_1), MAX(tr_driver_1) FROM (SELECT tr_driver, tr_driver + 1 AS tr_driver FROM trips)
----
3000	1001	4886

# ORDER BY with LIMIT inside a derived table picks the rows.
pending J4
query IDI nosort
SELECT COUNT(*), SUM(tr_fare), MIN(tr_row) FROM (SELECT tr_row, tr_fare FROM trips ORDER BY tr_fare DESC NULLS LAST, tr_row LIMIT 10)
----
10	275.00	10

# Aggregates over aggregates, and a filter on the grouped rows.
pending J4
query III nosort
SELECT MAX(n), MIN(n), SUM(n) FROM (SELECT tr_rider, COUNT(*) AS n FROM trips GROUP BY tr_rider)
----
131	3	3000

pending J4
query I nosort
SELECT COUNT(*) FROM (SELECT tr_rider, COUNT(*) AS n FROM trips GROUP BY tr_rider) WHERE n >= 13
----
63

# A CTE hides the table of the same name.
pending J4
query II nosort
WITH zones AS (SELECT ct_id AS zn_id FROM cities) SELECT COUNT(*), MAX(zn_id) FROM zones
----
6	6

# An unused CTE is never bound.
pending J4
query I nosort
WITH unused AS (SELECT nope FROM no_such_table) SELECT COUNT(*) FROM trips
----
3000

# A CTE that reads the CTE before it.
pending J4
query I nosort
WITH per_rider AS (SELECT tr_rider AS rider, COUNT(*) AS n FROM trips GROUP BY tr_rider),
  busy AS (SELECT rider FROM per_rider WHERE n >= 13)
SELECT COUNT(*) FROM busy
----
63

# A derived table joined with a table (roadmap PR J2b).
pending J4
query II rowsort
SELECT zn_city, SUM(n) FROM (SELECT tr_pickup, COUNT(*) AS n FROM trips GROUP BY tr_pickup) AS p JOIN zones ON p.tr_pickup = zn_id
GROUP BY zn_city
----
1	559
2	559
3	490
4	489
5	558
9	69
NULL	69

# A CTE referenced twice, joined with itself on an expression key (roadmap PR J2b).
pending J4
query III nosort
WITH per_zone AS (SELECT tr_pickup AS zone, COUNT(*) AS n FROM trips GROUP BY tr_pickup)
SELECT COUNT(*), SUM(a.n), SUM(b.n) FROM per_zone AS a, per_zone AS b WHERE a.zone + 1 = b.zone
----
42	2931	2930

# A CTE inside a scalar subquery (roadmap PR J5).
pending J5
query ID nosort
WITH per_zone AS (SELECT tr_pickup AS zone, SUM(tr_fare) AS fares FROM trips GROUP BY tr_pickup)
SELECT zone, fares FROM per_zone WHERE fares = (SELECT MAX(fares) FROM per_zone)
----
33	1093.25

# A column alias list longer than the select list.
pending J4
statement error
SELECT COUNT(*) FROM (SELECT tr_pickup FROM trips) AS g(a, b)

# ---- DuckDB only until lateral references get a PR (ADR 0022: a lateral reference exits 4) ----

# DuckDB reads a derived table that names a column of an earlier FROM item as LATERAL.
onlyif duckdb
query I nosort
SELECT COUNT(*) FROM zones, (SELECT COUNT(*) AS n FROM trips WHERE tr_pickup = zn_id) AS t WHERE n > 69
----
33

# ---- DuckDB only until column alias lists after a table get a PR (ADR 0022, rule 7) ----

onlyif duckdb
query II rowsort
SELECT a, b FROM cities AS c(a, b) WHERE a <= 2
----
0	1
1	2
2	3

# ---- DuckDB only, for good: DuckDB's error texts ----

onlyif duckdb
statement error ^Binder Error: table "g" has 1 columns available but 2 columns specified
SELECT COUNT(*) FROM (SELECT tr_pickup FROM trips) AS g(a, b)
