# SQ10. The inner EXISTS filters set rows before IN / NOT IN examines their values.
# Binding 2 contains a match and a NULL. The empty binding keeps even a NULL probe under NOT IN.
query I nosort
WITH vals AS (SELECT id, id % 3 AS k, i16 AS v FROM edge)
SELECT g.id FROM vals g WHERE g.v IN (SELECT m.v FROM vals m WHERE m.k = g.k AND m.id IN (2, 5, 6)
AND EXISTS (SELECT 1 FROM vals i WHERE i.k = g.k AND i.id = 2)) ORDER BY 1
----
INTEGER
2

