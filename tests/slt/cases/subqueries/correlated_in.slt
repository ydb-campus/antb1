# A later equality still proves the key. Keep all duplicate outer rows.
query II nosort
SELECT z.zn_city, COUNT(*) FROM zones z WHERE z.zn_city IN (SELECT r.rd_city FROM riders r
WHERE EXISTS (SELECT 1 FROM cities c WHERE c.ct_id = z.zn_city AND c.ct_id > 1) AND r.rd_city = z.zn_city)
GROUP BY z.zn_city ORDER BY 1
----
SMALLINT	BIGINT
2	8
3	7

# A NULL correlation key admits no set rows. A NULL probe belongs to NOT IN of that empty set.
query I nosort
SELECT z.zn_id FROM zones z WHERE z.zn_city IS NULL AND z.zn_city NOT IN (SELECT r.rd_city FROM riders r
WHERE r.rd_city = z.zn_city AND EXISTS (SELECT 1 FROM cities c WHERE c.ct_id = z.zn_city)) ORDER BY 1
----
INTEGER
38

# A static COUNT still supplies a set item for an empty filtered binding.
query I nosort
SELECT g.id FROM edge g WHERE 0 IN (SELECT COUNT(*) FROM edge m WHERE m.id = g.id
AND EXISTS (SELECT 1 FROM edge i WHERE i.id = g.id AND i.id = 2)) ORDER BY 1
----
INTEGER
0
1
3
4
5
6
7
8
9
10
11

# The membership guard ends at the probe input. Its cast sees only the selected outer row.
query I nosort
SELECT g.id FROM (SELECT id, i64 FROM edge WHERE id = 2) g WHERE CAST(g.i64 AS SMALLINT) IN
(SELECT m.i16 FROM edge m WHERE m.id = g.id AND EXISTS (SELECT 1 FROM edge i WHERE i.id = g.id))
----
INTEGER
2

# DuckDB restricts the checked middle filter to its binding. antb1 refuses this shape during planning.
onlyif duckdb
query I nosort
SELECT g.id FROM edge g WHERE g.i16 IN (SELECT m.i16 FROM edge m WHERE m.id = g.id AND g.id = 2
AND EXISTS (SELECT 1 FROM edge i WHERE i.id = g.id) AND CAST(m.i64 AS SMALLINT) >= 0) ORDER BY 1
----
INTEGER
2

# The checked item runs after the correlation, including before NOT IN tests its NULLs.
query I nosort
SELECT g.id FROM edge g WHERE g.id = 2 AND g.i16 IN (SELECT CAST(m.i64 AS SMALLINT) FROM edge m
WHERE m.id = g.id AND EXISTS (SELECT 1 FROM edge i WHERE i.id = g.id)) ORDER BY 1
----
INTEGER
2

