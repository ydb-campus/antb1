SELECT g.id FROM vals g WHERE g.v NOT IN (SELECT m.v FROM vals m WHERE m.k = g.k AND m.id IN (2, 5, 6)
AND EXISTS (SELECT 1 FROM vals i WHERE i.k = g.k AND i.id = 2)) ORDER BY 1
