----
BIGINT	HUGEINT
3000	4498500

query II rowsort
SELECT COUNT(*), SUM(tr_row) FROM trips WHERE 99 IN (SELECT zn_parent FROM zones)
----
BIGINT	HUGEINT
0	NULL

query II rowsort
SELECT COUNT(*), SUM(tr_row) FROM trips WHERE 99 NOT IN (SELECT zn_parent FROM zones)
----
BIGINT	HUGEINT
0	NULL

query II rowsort
SELECT COUNT(*), SUM(tr_row) FROM trips WHERE 77 IN (SELECT zn_parent FROM zones)
----
BIGINT	HUGEINT
