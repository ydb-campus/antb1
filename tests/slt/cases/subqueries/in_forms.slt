# Three-valued constant marks in the CASE WHEN of select items: IN is TRUE on a match despite a NULL in the set, NULL
# without a match over a set with a NULL, FALSE over the empty set; NOT IN is TRUE without a match over a set without a
# NULL and NULL over a set with one or of NULLs only. A constant mark also picks a branch of an ORDER BY CASE.

query ITTT nosort
SELECT ct_id, CASE WHEN 77 IN (SELECT zn_parent FROM zones) THEN 'T' WHEN NOT (77 IN (SELECT zn_parent FROM zones)) THEN 'F' ELSE 'N' END AS a, CASE WHEN 99 IN (SELECT zn_parent FROM zones) THEN 'T' WHEN NOT (99 IN (SELECT zn_parent FROM zones)) THEN 'F' ELSE 'N' END AS b, CASE WHEN 2 IN (SELECT pm_id FROM promos) THEN 'T' WHEN NOT (2 IN (SELECT pm_id FROM promos)) THEN 'F' ELSE 'N' END AS c FROM cities WHERE ct_id < 3 ORDER BY ct_id
----
SMALLINT	VARCHAR	VARCHAR	VARCHAR
1	T	N	F
2	T	N	F

query ITTT nosort
SELECT ct_id, CASE WHEN 99 NOT IN (SELECT zn_id FROM zones WHERE zn_city = 1) THEN 'T' WHEN NOT (99 NOT IN (SELECT zn_id FROM zones WHERE zn_city = 1)) THEN 'F' ELSE 'N' END AS a, CASE WHEN 99 NOT IN (SELECT zn_parent FROM zones) THEN 'T' WHEN NOT (99 NOT IN (SELECT zn_parent FROM zones)) THEN 'F' ELSE 'N' END AS b, CASE WHEN 2 NOT IN (SELECT zn_parent FROM zones WHERE zn_parent IS NULL) THEN 'T' WHEN NOT (2 NOT IN (SELECT zn_parent FROM zones WHERE zn_parent IS NULL)) THEN 'F' ELSE 'N' END AS c FROM cities WHERE ct_id < 3 ORDER BY ct_id
----
SMALLINT	VARCHAR	VARCHAR	VARCHAR
1	T	N	N
2	T	N	N

query T rowsort
SELECT CASE WHEN 2 IN (SELECT zn_id FROM zones WHERE zn_city = 2) THEN 'y' ELSE 'n' END AS m FROM cities WHERE ct_id = 1
----
VARCHAR
y

