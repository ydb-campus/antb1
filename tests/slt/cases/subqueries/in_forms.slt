query TI nosort
SELECT dy_day, CASE WHEN date_trunc('month', dy_day) = ANY (SELECT date_trunc('month', dy_day) FROM days WHERE dy_day > '2026-06-01') THEN 1 ELSE 0 END AS m FROM days ORDER BY dy_day LIMIT 5
----
DATE	INTEGER
2025-12-29	0
2025-12-30	0
2025-12-31	0
2026-01-01	0
2026-01-02	0

# ---- DuckDB only until DATE and TIMESTAMP keys get a PR (a join key of DATE and TIMESTAMP) ----

onlyif duckdb
query I rowsort
SELECT COUNT(*) FROM days WHERE dy_day IN (SELECT date_trunc('month', dy_day) FROM days)
----
BIGINT
48

# ---- divergence D3: a string literal probe over a number set ----

# antb1 refuses to compare a string with numbers, as it does in a comparison; DuckDB casts the string to the set's type.
# Over a VARCHAR set both answer.
onlyif antb1
statement error cannot compare the INTEGER values of an IN subquery with a string
SELECT COUNT(*) FROM zones WHERE '7' IN (SELECT zn_id FROM zones WHERE zn_city = 1)

onlyif duckdb
query I rowsort
SELECT COUNT(*) FROM zones WHERE '7' IN (SELECT zn_id FROM zones WHERE zn_city = 1)
----
BIGINT
0

onlyif antb1
statement error cannot compare the SMALLINT values of an IN subquery with a string
SELECT COUNT(*) FROM zones WHERE zn_id < 3 OR '2' NOT IN (SELECT zn_city FROM zones)

onlyif duckdb
query I rowsort
SELECT COUNT(*) FROM zones WHERE zn_id < 3 OR '2' NOT IN (SELECT zn_city FROM zones)
----
BIGINT
2
