# A value probe of two rows is DuckDB's row error: as a conjunct, in arithmetic with a column, under OR and in a
# select-item CASE. A sum past INTEGER's range in the probe is an overflow error.

statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*), SUM(tr_row) FROM trips WHERE (SELECT zn_id FROM zones WHERE zn_city = 2) IN (SELECT zn_id FROM zones WHERE zn_city = 1)

statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*), SUM(tr_row) FROM trips WHERE tr_pickup + (SELECT zn_id FROM zones WHERE zn_city = 2) IN (SELECT zn_id FROM zones WHERE zn_city = 1)

statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*), SUM(tr_row) FROM trips WHERE (SELECT zn_id FROM zones WHERE zn_city = 2) IN (SELECT zn_id FROM zones WHERE zn_city = 1) OR tr_row < 3

statement error More than one row returned by a subquery used as an expression
SELECT ct_id, CASE WHEN (SELECT zn_id FROM zones WHERE zn_city = 2) IN (SELECT zn_id FROM zones WHERE zn_city = 1) THEN 'y' ELSE 'n' END AS m FROM cities

statement error Overflow in (addition|subtraction|multiplication) of
SELECT COUNT(*) FROM edge WHERE i32 + (SELECT MAX(i32) FROM edge) IN (SELECT i32 FROM edge WHERE id = 2)

# ---- quantified comparisons ----

# Spellings as a top-level WHERE conjunct: = ANY and = SOME are IN, <> ALL and != ALL are NOT IN, also written
# without spaces and in lower case; NOT over = ANY and over <> ALL; <> ALL over a set holding a NULL keeps no row and
# over the empty promos every row, NULL dropoffs too; = ANY over a set holding a NULL keeps the matches; an expression
# probe; a BIGINT probe against an INTEGER set, a DECIMAL and a VARCHAR pair; two quantified conjuncts; = ANY over a
# UNION.

