# Under HAVING, an aggregate the subquery owns (its own columns, an unqualified name it shadows, COUNT(*), in its
# WHERE or inner ON) or one a middle block owns through its WHERE is a bind error in both engines; DuckDB's text
# differs ("Aggregate with only constant parameters ...").
statement error
SELECT ct_id FROM cities GROUP BY ct_id HAVING (SELECT COUNT(*) FROM zones WHERE zn_id < SUM(zones.zn_city)) > 3

statement error
SELECT zn_city FROM zones GROUP BY zn_city HAVING (SELECT COUNT(*) FROM cities WHERE ct_id < SUM(cities.ct_id)) > 1

statement error
SELECT zn_city FROM zones GROUP BY zn_city HAVING (SELECT COUNT(*) FROM cities WHERE ct_id < SUM(ct_pop)) > 1

statement error
SELECT zn_city FROM zones GROUP BY zn_city HAVING (SELECT COUNT(*) FROM cities WHERE ct_id < COUNT(label)) > 1

statement error
SELECT zn_city FROM zones GROUP BY zn_city HAVING (SELECT COUNT(*) FROM cities WHERE ct_id < COUNT(*)) > 1

# A literal argument: an aggregate in a WHERE is the binder's, so the same bind error, whatever its argument (SQ2b).
statement error
SELECT zn_city FROM zones GROUP BY zn_city HAVING (SELECT COUNT(*) FROM cities WHERE ct_id < SUM(1)) > 1

statement error
SELECT zn_city FROM zones GROUP BY zn_city HAVING (SELECT COUNT(*) FROM cities JOIN drivers ON dv_city = ct_id AND dv_city < SUM(drivers.dv_city)) > 0

statement error
SELECT ct_id FROM cities GROUP BY ct_id HAVING SUM(ct_id) > 1 AND ct_id IN (SELECT zn_city FROM zones WHERE SUM(zn_id) > 0) ORDER BY ct_id

statement error
SELECT zn_city FROM zones GROUP BY zn_city HAVING (SELECT COUNT(*) FROM cities WHERE ct_id < (SELECT COUNT(*) FROM drivers WHERE dv_city < SUM(cities.ct_id))) > 0 ORDER BY zn_city

statement error
SELECT zn_city FROM zones GROUP BY zn_city HAVING (SELECT COUNT(*) FROM cities WHERE ct_id < (SELECT COUNT(*) FROM drivers WHERE dv_city < SUM(drivers.dv_city))) > 0 ORDER BY zn_city

# In the WHERE of a derived table or a CTE body inside a HAVING subquery, the outer group's aggregate is answered by
# DuckDB and refused by antb1 (exit code 4): no binder path reads it there.
