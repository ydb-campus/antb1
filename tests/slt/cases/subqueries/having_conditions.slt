# Uncorrelated subqueries as values in HAVING conditions (ADR 0041's SQ1, its second PR): a scalar subquery or an
# EXISTS anywhere inside a HAVING condition -- under AND, OR, NOT and CASE, in arithmetic with aggregates and GROUP BY
# keys, functions, COALESCE, casts, IS [NOT] NULL, IS [NOT] DISTINCT FROM, IN lists, LIKE's operand and BETWEEN --
# through its single value, computed before any group is read; a HAVING conjunct with one is filtered after the
# conjuncts without one and before the select list is computed. Then decision 23's SQ1 row: an aggregate inside a
# subquery's WHERE or ON, judged by the block it belongs to.

# ---- HAVING: a value under OR ----

# A value under OR, decided per group: in arithmetic with an aggregate, in either branch, compared with a GROUP BY
# key; a value of no row and of a NULL row is NULL, so only the other branch keeps a group.

query II nosort
SELECT zn_city, COUNT(*) FROM zones GROUP BY zn_city HAVING COUNT(*) > (SELECT COUNT(*) FROM cities) + 1 OR zn_city = 9 ORDER BY zn_city
----
SMALLINT	BIGINT
1	8
2	8
5	8
9	1

query II nosort
SELECT zn_city, COUNT(*) FROM zones GROUP BY zn_city HAVING zn_city = 9 OR COUNT(*) < (SELECT MIN(ct_id) FROM cities) + 7 ORDER BY zn_city
----
SMALLINT	BIGINT
3	7
4	7
9	1
NULL	1

query II nosort
SELECT dv_city, COUNT(*) FROM drivers GROUP BY dv_city HAVING dv_city > (SELECT ct_id FROM cities WHERE label = 'harbor') + 1 OR COUNT(*) < 10 ORDER BY dv_city
----
SMALLINT	BIGINT
4	22
NULL	8

query II nosort
SELECT zn_city, COUNT(*) FROM zones GROUP BY zn_city HAVING COUNT(*) > (SELECT ct_pop FROM cities WHERE ct_id > 100) OR zn_city = 3 ORDER BY zn_city
----
SMALLINT	BIGINT
3	7

query II nosort
SELECT zn_city, COUNT(*) FROM zones GROUP BY zn_city HAVING COUNT(*) < (SELECT ct_pop FROM cities WHERE label = 'airport') OR zn_city = 3 ORDER BY zn_city
----
SMALLINT	BIGINT
3	7

query II nosort
SELECT zn_city, COUNT(*) FROM zones GROUP BY zn_city HAVING COUNT(*) < (SELECT ct_pop FROM cities WHERE label = 'hills') OR zn_city = 3 ORDER BY zn_city
----
SMALLINT	BIGINT
1	8
2	8
3	7
4	7
5	8
9	1
NULL	1

# A value of two rows fails even where the OR's other branch holds for every group: its join is built first.

statement error More than one row returned by a subquery used as an expression
SELECT zn_city, COUNT(*) FROM zones GROUP BY zn_city HAVING COUNT(*) > 0 OR COUNT(*) > (SELECT zn_city FROM zones) ORDER BY zn_city

# A plain conjunct is filtered before the conjuncts with a value: the group whose OR would overflow is gone first.
# Without it, the same OR overflows; in a global aggregate whose first branch holds, the overflowing branch is
# never computed.

query II nosort
SELECT zn_city, SUM(zn_id) FROM zones GROUP BY zn_city HAVING COUNT(*) > 7 AND (SUM(zn_id) > (SELECT MAX(zn_id) FROM zones) * 4 OR zn_city = 1) ORDER BY zn_city
----
SMALLINT	HUGEINT
1	148
5	180

query I nosort
SELECT id FROM edge GROUP BY id HAVING MAX(i64) < 100 AND (MAX(i64) + (SELECT MAX(i64) FROM edge WHERE id = 6) > 0 OR id = 3) ORDER BY id
----
INTEGER
2
3
4
9
10
11

statement error Overflow in (addition|subtraction|multiplication) of
SELECT id FROM edge GROUP BY id HAVING MAX(i64) + (SELECT MAX(i64) FROM edge WHERE id = 6) > 0 OR id = 3 ORDER BY id

query I rowsort
SELECT COUNT(*) FROM edge HAVING COUNT(*) > 0 OR MAX(i64) > (SELECT MAX(i64) FROM edge) + 1
----
BIGINT
12

