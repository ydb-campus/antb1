# ---- overflows over groups ----

# HAVING's plain conjunct is filtered first and keeps no group (every id is its own group), so the INTEGER product
# that would overflow at id 0 and 1 is never computed: no rows, beside a value plus 0 and beside a value under OR.
query I rowsort
SELECT id FROM edge GROUP BY id HAVING COUNT(*) > 1 AND MAX(i32) * 2 > (SELECT MIN(i32) FROM edge) + 0
----
INTEGER

query I rowsort
SELECT id FROM edge GROUP BY id HAVING COUNT(*) > 1 AND (MAX(i32) * 2 > (SELECT MIN(i32) FROM edge) OR id < 0)
----
INTEGER

# Where groups reach it, the product overflows; so does the value's side (BIGINT's maximum plus 1), and the BIGINT
# minimum minus a value at id 0.
statement error Overflow in (addition|subtraction|multiplication) of
SELECT id FROM edge GROUP BY id HAVING MAX(i32) * 2 > (SELECT MIN(i32) FROM edge) + 0 ORDER BY id

statement error Overflow in (addition|subtraction|multiplication) of
SELECT id FROM edge GROUP BY id HAVING SUM(i32) > (SELECT MAX(i64) FROM edge) + 1 ORDER BY id

statement error Overflow in (addition|subtraction|multiplication) of
SELECT id, MAX(i64) + 1 FROM edge GROUP BY id HAVING MAX(i64) - (SELECT MAX(i64) FROM edge WHERE id = 6) < 0 ORDER BY id

# The select list is computed over the groups HAVING keeps: MAX(i32) * 2 and MAX(i16) * 2 overflow only at ids 0
# and 1, which the value conjuncts drop.
query II nosort
SELECT id, MAX(i32) * 2 FROM edge GROUP BY id HAVING MAX(i32) + 0 < (SELECT MAX(i32) FROM edge WHERE id = 6) AND MAX(i32) > (SELECT MIN(i32) FROM edge) + 1 ORDER BY id
----
