# With no equality to attach an inner row, MIN reads just the rows below each city's cutoff.
query II nosort
SELECT z.zn_id, (SELECT MIN(c.ct_pop) FROM cities c WHERE c.ct_id < z.zn_city)
FROM zones z WHERE z.zn_id <= 6 ORDER BY z.zn_id
----
INTEGER	INTEGER
1	NULL
2	120000
3	45000
4	30000
5	30000
6	NULL

# Bindings repeat, can be NULL, and two inequalities use different columns and operand orders.
query IIII rowsort
SELECT o.i16, o.i32,
       (SELECT COUNT(*) FROM edge i WHERE i.i16 < o.i16 AND o.i32 >= i.i32),
       (SELECT SUM(i.id) FROM edge i WHERE i.i16 < o.i16 AND o.i32 >= i.i32)
FROM (SELECT i16, i32 FROM edge UNION ALL SELECT i16, i32 FROM edge) o
----
SMALLINT	INTEGER	BIGINT	HUGEINT
-1	-1	2	7
-1	-1	2	7
-100	-100000	1	0
-100	-100000	1	0
-12345	54321	1	0
-12345	54321	1	0
-32768	-2147483648	0	NULL
-32768	-2147483648	0	NULL
0	0	3	10
0	0	3	10
1	1	4	12
1	1	4	12
100	100000	7	37
100	100000	7	37
12345	NULL	0	NULL
12345	NULL	0	NULL
32767	2147483647	8	43
32767	2147483647	8	43
7	-7	2	7
7	-7	2	7
NULL	7	0	NULL
NULL	7	0	NULL
NULL	NULL	0	NULL
NULL	NULL	0	NULL

# An empty inner scan and HAVING exercise each scalar result for the preserved rows.
query IIII nosort
SELECT o.id, (SELECT MIN(i.id) FROM edge i WHERE i.id < 0 AND i.id < o.id),
       (SELECT COUNT(*) FROM edge i WHERE i.id < 0 AND i.id < o.id HAVING COUNT(*) = 0),
       (SELECT COUNT(*) FROM edge i WHERE i.id < 0 AND i.id < o.id HAVING COUNT(*) > 0)
FROM edge o WHERE o.id < 2 ORDER BY o.id
----
INTEGER	INTEGER	BIGINT	BIGINT
0	NULL	0	NULL
1	NULL	0	NULL

# Only a passing pair may evaluate the aggregate argument. The rejected row would overflow.
query II nosort
SELECT o.id, (SELECT SUM(i.i32 + 1) FROM edge i WHERE i.id < o.id)
FROM edge o WHERE o.id <= 1 ORDER BY o.id
----
INTEGER	HUGEINT
0	NULL
1	-2147483647

# Stacked scalar values share the original outer bindings.
query III nosort
SELECT z.zn_id, (SELECT MIN(c.ct_pop) FROM cities c WHERE c.ct_id < z.zn_city),
       (SELECT MAX(c.ct_pop) FROM cities c WHERE c.ct_pop > z.zn_parent)
FROM zones z WHERE z.zn_id <= 8 ORDER BY z.zn_id
----
INTEGER	INTEGER	INTEGER
1	NULL	NULL
2	120000	NULL
3	45000	NULL
4	30000	NULL
5	30000	NULL
6	NULL	120000
7	120000	120000
8	45000	120000

# Equality inside OR forms no hash key. A NULL first comparison can still pass the second.
query II nosort
SELECT o.id, (SELECT COUNT(*) FROM edge i WHERE i.i16 < o.i16 OR i.id = o.id)
FROM edge o ORDER BY o.id
----
INTEGER	BIGINT
0	1
1	10
2	5
3	4
4	6
5	1
6	8
7	3
8	1
9	9
10	2
11	7

# The NOT applies to both comparisons. An independent equality conjunct can still use a hash key.
query II nosort
SELECT o.id, (SELECT COUNT(*) FROM edge i WHERE i.i16 IS NOT DISTINCT FROM o.i16
              AND NOT (i.id < o.id OR i.i32 > o.i32))
FROM edge o ORDER BY o.id
----
INTEGER	BIGINT
0	1
1	1
2	1
3	1
4	1
5	0
6	1
7	1
8	1
9	0
10	1
11	1

# DISTINCT FROM is a keyless comparison. With NULL inputs it agrees with the negated NULL-safe equality.
query III nosort
SELECT o.id, (SELECT COUNT(*) FROM edge i WHERE i.i16 IS DISTINCT FROM o.i16),
       (SELECT COUNT(*) FROM edge i WHERE NOT (i.i16 IS NOT DISTINCT FROM o.i16))
FROM edge o WHERE o.id IN (2, 5, 8) ORDER BY o.id
----
INTEGER	BIGINT	BIGINT
2	11	11
5	10	10
8	10	10
