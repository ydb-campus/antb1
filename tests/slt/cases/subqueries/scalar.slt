# The same shape with AVG, and with the inner join keeping rows the restriction must not drop.
query I nosort
SELECT COUNT(*) FROM riders WHERE 15 < (SELECT AVG(tr_fare) FROM trips LEFT JOIN zones ON tr_pickup = zn_id WHERE tr_rider = rd_id)
----
152

# A residual on the inner join, which the restriction sits above: its candidate pairs are unchanged.
query I nosort
SELECT COUNT(*) FROM riders WHERE 0 < (SELECT SUM(tr_fare) FROM trips JOIN zones ON tr_pickup = zn_id AND tr_distance > zn_radius WHERE tr_rider = rd_id)
----
236
