# Scalar subqueries over the star schema: uncorrelated ungrouped aggregates (ADR 0022), zero rows among them, and
# correlated SUM, AVG, MIN and MAX under comparisons that reject NULL (ADR 0023), over empty groups, on one and two
# columns, and into a middle block.

# ---- the inputs, one table at a time ----

query DD nosort
SELECT MIN(tr_fare), MAX(tr_fare) FROM trips
----
3.50	27.50

query IDD nosort
SELECT COUNT(*), MIN(sh_hours), MAX(sh_hours) FROM shifts
----
500	4.0	12.0

query II nosort
SELECT COUNT(*), COUNT(pm_discount) FROM promos
----
0	0

# ---- pending: uncorrelated scalar subqueries (ADR 0022; roadmap PR J5 removes these guards) ----

# Over zero rows MAX is NULL, which rejects every row, and COUNT is 0.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_fare > (SELECT MAX(pm_discount) FROM promos)
----
0

query I nosort
SELECT COUNT(*) FROM trips WHERE 0 = (SELECT COUNT(*) FROM promos)
----
3000

# The subquery first, and AVG.
query I nosort
SELECT COUNT(*) FROM trips WHERE (SELECT AVG(tr_fare) FROM trips) < tr_fare
----
1466

query I nosort
SELECT COUNT(*) FROM trips WHERE tr_distance > (SELECT AVG(zn_radius) FROM zones)
----
2652

# SUM over the zero rows a filter leaves.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_fare < (SELECT SUM(sh_hours) FROM shifts WHERE sh_hours > 100)
----
0

# An aggregate subquery in a block without aggregates, and two of them.
query ID rowsort
SELECT tr_row, tr_fare FROM trips WHERE tr_fare = (SELECT MAX(tr_fare) FROM trips) AND tr_row < 300
----
10	27.50
107	27.50
204	27.50

query I nosort
SELECT COUNT(*) FROM trips WHERE tr_fare > (SELECT MIN(sh_hours) FROM shifts) AND tr_fare < (SELECT MAX(sh_hours) FROM shifts)
----
928

# In HAVING.
query ID rowsort
SELECT tr_pickup, SUM(tr_fare) FROM trips GROUP BY tr_pickup HAVING SUM(tr_fare) > (SELECT MAX(tr_fare) * 39 FROM trips)
----
1	1075.00
12	1077.25
14	1079.75
22	1091.00
3	1077.50
33	1093.25

# Over a join.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_fare > (SELECT AVG(tr_fare) FROM trips JOIN drivers ON tr_driver = dv_id WHERE dv_city = 1)
----
1436

# Two columns.
statement error
SELECT COUNT(*) FROM trips WHERE tr_fare > (SELECT MIN(pm_discount), MAX(pm_discount) FROM promos)

# ---- the shapes the generator does not write (roadmap PR J5b) ----

# A VARCHAR value from the one row, which the one-row join slices as columns every probe window
# shares (ADR 0022's E2a note on kOneRowWindowBytes).
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_tariff < (SELECT MAX(tf_code) FROM tariffs)
----
2558

# <> and != are the same operator, and NULL on either side keeps no row.
query I nosort not_equal
SELECT COUNT(*) FROM trips WHERE tr_tariff <> (SELECT MAX(tf_code) FROM tariffs)
----
2558

query I nosort not_equal
SELECT COUNT(*) FROM trips WHERE tr_tariff != (SELECT MAX(tf_code) FROM tariffs)
----
2558

# An expression on the outer side, computed in a layer of its own below the join.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_fare * 2 > (SELECT MAX(sh_hours) FROM shifts)
----
2574

# A global aggregate whose select list is exactly its aggregates: the one row the join appends is a
# column above the aggregation, so a Project has to restore the list.
query I nosort
SELECT MIN(tr_driver) FROM trips HAVING MIN(tr_driver) = (SELECT MIN(dv_id) FROM drivers)
----
1000

query I nosort
SELECT MIN(tr_driver) FROM trips HAVING MIN(tr_driver) = (SELECT MAX(dv_id) FROM drivers)
----

# In an inner join's ON, which counts as a WHERE conjunct (ADR 0022), against the same conjunct in
# WHERE.
query I nosort scalar_inner_on
SELECT COUNT(*) FROM trips JOIN zones ON tr_pickup = zn_id AND tr_fare > (SELECT AVG(tr_fare) FROM trips)
----
1365

query I nosort scalar_inner_on
SELECT COUNT(*) FROM trips JOIN zones ON tr_pickup = zn_id WHERE tr_fare > (SELECT AVG(tr_fare) FROM trips)
----
1365

# Both forms in one WHERE, stacked in the order they are written.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_rider IN (SELECT rd_id FROM riders) AND tr_fare > (SELECT AVG(tr_fare) FROM trips)
----
1349

# A DATE value from the one row.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_day > (SELECT MIN(sh_day) FROM shifts)
----
2825

# A constant integer expression on the other side, in either order: folding it copies the whole
# comparison and sql::Box deep-copies its pointee, so the subquery arrives at a new address -- the
# comparison's own side must be recognised by what it is, not by where it sits.
query I nosort
SELECT COUNT(*) FROM trips WHERE 1 + 2 = (SELECT COUNT(*) FROM promos)
----
0

query I nosort
SELECT COUNT(*) FROM trips WHERE 0 + 0 = (SELECT COUNT(*) FROM promos)
----
3000

query I nosort
SELECT COUNT(*) FROM trips WHERE (SELECT COUNT(*) FROM zones) = 20 + 20
----
3000

query I nosort
SELECT COUNT(*) FROM trips WHERE tr_fare > (SELECT AVG(tr_fare) FROM trips) AND 1 + 1 > (SELECT COUNT(*) FROM promos)
----
1466

# The same fold in HAVING and in an inner join's ON.
query I nosort
SELECT COUNT(*) FROM trips HAVING 2 + 3 > (SELECT COUNT(*) FROM promos)
----
3000

query I nosort
SELECT COUNT(*) FROM trips JOIN zones ON tr_pickup = zn_id AND 2 * 1000 > (SELECT COUNT(*) FROM trips)
----
0

# A constant expression that overflows its type is a bind error, as it is without a subquery
# (divergence D17), and not an abort.
statement error
SELECT COUNT(*) FROM trips WHERE 2147483647 + 1 = (SELECT COUNT(*) FROM promos)

# ---- pending: correlated scalar aggregates (ADR 0023; roadmap PR U3 removes these guards) ----

# Empty groups: riders 237 to 240 have no trip, so their SUM is NULL and the comparison drops them.
query I nosort
SELECT COUNT(*) FROM riders WHERE rd_id > 225 AND 0 < (SELECT SUM(tr_fare) FROM trips WHERE tr_rider = rd_id)
----
11

# SUM, MIN of a DATE and AVG.
query I nosort
SELECT COUNT(*) FROM riders WHERE (SELECT SUM(tr_fare) FROM trips WHERE tr_rider = rd_id) > 200
----
34

query I nosort
SELECT COUNT(*) FROM riders WHERE rd_joined > (SELECT MIN(tr_day) FROM trips WHERE tr_rider = rd_id)
----
12

query I nosort
SELECT COUNT(*) FROM riders WHERE (SELECT AVG(tr_fare) FROM trips WHERE tr_rider = rd_id) > 17
----
27

# An aggregate combined with literals.
query I rowsort
SELECT rd_id FROM riders WHERE rd_id < 20 AND 400 < (SELECT SUM(tr_fare) * 2 - 10 FROM trips WHERE tr_rider = rd_id)
----
12
14
17

# Two columns of the same types on both sides (the repeated keys of shifts each count).
query I nosort
SELECT COUNT(*) FROM shifts WHERE sh_hours * 4 > (SELECT SUM(tr_fare) FROM trips WHERE tr_driver = sh_driver AND tr_day = sh_day)
----
380

# A correlation into a middle block: the subquery reads the zones of the IN subquery, not the outer cities (roadmap
# PR J5 for the IN).
query I rowsort
SELECT ct_id FROM cities
WHERE ct_id IN (SELECT zn_city FROM zones WHERE zn_radius * 3 > (SELECT AVG(tr_distance) FROM trips WHERE tr_pickup = zn_id))
----
2
4

# ---- DuckDB only until correlated COUNT gets a PR (ADR 0023: the COUNT bug) ----

# COUNT over no rows is 0, so the riders without a trip pass: an inner join on the grouped trips would drop them.
onlyif duckdb
query I nosort
SELECT COUNT(*) FROM riders WHERE 0 = (SELECT COUNT(*) FROM trips WHERE tr_rider = rd_id)
----
4

# ---- DuckDB only until CASE over correlated aggregates gets a PR (ADR 0023) ----

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM riders WHERE 0 = (SELECT CASE WHEN SUM(tr_fare) > 0 THEN 1 ELSE 0 END FROM trips WHERE tr_rider = rd_id)
----
4

# ---- DuckDB only until the general domain join gets a PR (ADR 0023: a correlation of two types exits 4) ----

# Only an equality of one type feeds an equivalence class, so the INTEGER tr_driver is no inner equivalent of the
# BIGINT dv_id.
onlyif duckdb
query I nosort
SELECT COUNT(*) FROM drivers WHERE 450 < (SELECT SUM(tr_fare) FROM trips WHERE tr_driver = dv_id)
----
13

# ---- DuckDB only until single joins get a PR (ADR 0023: a scalar subquery that is no aggregate exits 4) ----

# Zero rows give NULL; several rows are an error.
onlyif duckdb
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_promo = (SELECT pm_id FROM promos)
----
0

onlyif duckdb
statement error
SELECT COUNT(*) FROM trips WHERE tr_pickup = (SELECT zn_id FROM zones)

# ---- DuckDB only, for good: DuckDB's error texts ----

onlyif duckdb
statement error ^Binder Error: Subquery returns 2 columns - expected 1
SELECT COUNT(*) FROM trips WHERE tr_fare > (SELECT MIN(pm_discount), MAX(pm_discount) FROM promos)

onlyif duckdb
statement error ^Invalid Input Error: More than one row returned by a subquery
SELECT COUNT(*) FROM trips WHERE tr_pickup = (SELECT zn_id FROM zones)

# Two outer columns in one equivalence class, both equal to the same inner column: each needs its
# own join key. One key per class would drop the second column's constraint and keep outer rows
# that SQL rejects (ADR 0023's Path 2).
query I nosort
SELECT COUNT(*) FROM zones WHERE 2 < (SELECT MIN(tr_fare) FROM trips WHERE trips.tr_pickup = zones.zn_id AND trips.tr_pickup = zones.zn_parent)
----
0

# ---- the semi-join reduction (ADR 0023): two correlated keys, where the restriction fires ----
# The aggregation's input is restricted to the key pairs the outer side binds, which only a semi
# join may do: it must not multiply the rows it groups, and shifts holds repeated (driver, day)
# pairs and NULLs in both key columns, so a restriction that duplicated a row or admitted a NULL
# pair would change a SUM rather than a row count.

# Pairs with no trip at all: SUM is NULL over them and the comparison drops the outer row, which is
# the group the restriction removes and the inner join above it would have dropped anyway.
query I nosort
SELECT COUNT(*) FROM shifts WHERE sh_hours > 0 AND 0 < (SELECT SUM(tr_fare) FROM trips WHERE tr_driver = sh_driver AND tr_day = sh_day)
----
412

# The same shape with AVG, whose value moves if the restriction changed which rows are aggregated.
query I nosort
SELECT COUNT(*) FROM shifts WHERE sh_hours * 2 < (SELECT AVG(tr_distance) FROM trips WHERE tr_driver = sh_driver AND tr_day = sh_day)
----
93

# Repeated outer keys, listed rather than counted: a restriction that multiplied the aggregation's
# input would show up here as a changed SUM, and one that multiplied the outer rows as extra rows.
query IT rowsort
SELECT sh_driver, sh_day FROM shifts WHERE sh_driver < 1010 AND sh_hours < (SELECT SUM(tr_fare) FROM trips WHERE tr_driver = sh_driver AND tr_day = sh_day)
----
1000	2026-03-12
1000	2026-03-15
1000	2026-03-23

# An outer side that still holds a dependent join of its own is not cloned: the pass is top-down, so
# cloning it would duplicate a rewrite that clones in turn, and k stacked correlated subqueries would
# cost 2^k nodes. Here the EXISTS is below the scalar aggregate, so the restriction declines and the
# answer is the same either way -- which is what this record pins.
query I nosort
SELECT COUNT(*) FROM shifts WHERE EXISTS (SELECT * FROM drivers WHERE dv_id = sh_driver) AND sh_hours > 0 AND 0 < (SELECT SUM(tr_fare) FROM trips WHERE tr_driver = sh_driver AND tr_day = sh_day)
----
408
