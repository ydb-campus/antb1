# Correlated scalar subqueries whose block is an aggregate over every row, as a direct operand of a comparison in a
# top-level conjunct of WHERE or an inner ON (ADR 0041's SQ6): every aggregate call (COUNT(*), COUNT(x),
# COUNT(DISTINCT x) and the variance family besides SUM, AVG, MIN and MAX), any select item over the calls, a HAVING
# inside the block and an uncorrelated value or EXISTS there. An outer row with no inner match reads the block's value
# over no rows (decision 19: COUNT is 0, a constant keeps its value, a HAVING that rejects the empty row gives NULL),
# so where the comparison can pass that value, the block is joined back with a LEFT join (decision 21).

# ---- the inputs, one table at a time ----

query II rowsort
SELECT rd_city, COUNT(*) FROM riders GROUP BY rd_city
----
SMALLINT	BIGINT
1	77
2	77
3	78
NULL	8

query II rowsort
SELECT dv_city, COUNT(*) FROM drivers GROUP BY dv_city
----
SMALLINT	BIGINT
1	23
2	22
3	22
4	22
NULL	8

query II rowsort
SELECT zn_city, COUNT(*) FROM zones GROUP BY zn_city
----
SMALLINT	BIGINT
1	8
2	8
3	7
4	7
5	8
9	1
NULL	1

query IIIII rowsort
SELECT id, i16, i32, i64, u16 FROM edge
----
INTEGER	SMALLINT	INTEGER	BIGINT	USMALLINT
0	-32768	-2147483648	-9223372036854775808	0
1	32767	2147483647	9223372036854775807	65535
10	-12345	54321	-42	12
11	7	-7	7	7
2	0	0	0	1
3	-1	-1	-1	32768
4	1	1	1	15887
5	NULL	NULL	NULL	NULL
6	100	100000	1000000000000000	15917
7	-100	-100000	-1000000000000000	40000
8	NULL	7	NULL	2
9	12345	NULL	42	NULL

# ---- COUNT(*) under every comparison (ADR 0041's SQ6) ----

# Cities 4 to 6 have no rider, so their COUNT(*) is 0, not NULL: a comparison that 0 passes keeps them, one that 0
# fails drops them. Several operators, the subquery on either side and the correlation written either way round.
query I nosort
SELECT c.ct_id FROM cities c WHERE (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id) > 0 ORDER BY 1
----
SMALLINT
1
2
3

