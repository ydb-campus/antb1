# Riders 237 to 240 have no trip. The outer block aggregates the riders it keeps.
query IIII nosort
SELECT COUNT(*), MIN(r.rd_id), MAX(r.rd_id), SUM(r.rd_id) FROM riders r
WHERE (SELECT COUNT(*) FROM trips t WHERE t.tr_rider = r.rd_id) = 0
----
BIGINT	BIGINT	BIGINT	HUGEINT
4	237	240	954

# ---- COUNT(x) and COUNT(DISTINCT x) (ADR 0041's SQ6) ----

# COUNT of a column is 0 over no rows as well; over a column with NULLs it counts fewer rows than COUNT(*), so a rider
