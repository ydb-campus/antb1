# ---- inside other query blocks (ADR 0041's SQ6) ----

# Inside EXISTS, NOT EXISTS and IN, a derived table, a CTE, a UNION ALL branch and a block that aggregates; over a join
# and over a UNION ALL inside the subquery; and under SELECT DISTINCT.
query I nosort
SELECT c.ct_id FROM cities c
WHERE EXISTS (SELECT 1 FROM riders r
              WHERE r.rd_city = c.ct_id AND (SELECT COUNT(*) FROM trips t WHERE t.tr_rider = r.rd_id) = 0)
ORDER BY 1
