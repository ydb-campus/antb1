# The same correlated conjunct in each branch of an OR, which OR factoring takes out as a top-level conjunct.
query I nosort
SELECT ct_id FROM cities
WHERE (ct_id < 3 AND (SELECT COUNT(*) FROM zones WHERE zn_city = ct_id) > 7)
   OR (ct_id > 4 AND (SELECT COUNT(*) FROM zones WHERE zn_city = ct_id) > 7)
ORDER BY ct_id
