# ---- errors (ADR 0041's SQ6) ----

# An overflow from a group with rows, and one only from the empty value (0 - 1 plus the BIGINT minimum, for the rows
# whose NULL i32 matches nothing): the item is computed over the empty row, so both fail.
statement error Overflow in addition of
SELECT e.id FROM edge e WHERE (SELECT COUNT(*) + 9223372036854775807 FROM edge e2 WHERE e2.i16 = e.i16) > 0 ORDER BY 1

statement error Overflow in addition of
SELECT e.id FROM edge e
WHERE (SELECT COUNT(*) - 1 + (-9223372036854775807 - 1) FROM edge e2 WHERE e2.i32 = e.i32) < 0 ORDER BY 1

# ---- DuckDB only, for good: an error on the empty row in a HAVING operand that another conjunct rejects ----

# The HAVING's other conjunct rejects the empty row, so the comparison rejects its NULL and antb1 joins back INNER and
# never computes the cast there. DuckDB computes the conjuncts in the order written and fails (the twin above, with the
# conjuncts swapped, answers in both).
onlyif duckdb
statement error Conversion Error
SELECT c.ct_id FROM cities c
WHERE (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id
       HAVING CAST(COUNT(*) - 1 AS USMALLINT) >= 0 AND COUNT(*) > 0) > 1
ORDER BY 1

