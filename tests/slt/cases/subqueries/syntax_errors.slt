# WITH lists and derived tables that both engines reject as malformed (ADR 0022, roadmap PR S4a). antb1 must fail
# with a syntax error, never Unsupported, and each record's `onlyif duckdb` twin checks that DuckDB fails in its
# parser too: a statement that antb1 wrongly calls a syntax error would parse in DuckDB and fail the twin. The tables
# are registered and the columns real, so no record fails on a missing name instead.

# ---- the input ----

query II nosort
SELECT COUNT(*), MAX(tr_row) FROM trips
----
3000	2999

# ---- WITH lists: the list without a query, a CTE without AS or its parentheses, a trailing comma ----

statement error
WITH c AS (SELECT tr_row FROM trips)

onlyif duckdb
statement error ^Parser Error:
WITH c AS (SELECT tr_row FROM trips)

statement error
WITH c AS (SELECT tr_row FROM trips);

onlyif duckdb
statement error ^Parser Error:
WITH c AS (SELECT tr_row FROM trips);

statement error
WITH c (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

onlyif duckdb
statement error ^Parser Error:
WITH c (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

statement error
WITH c AS SELECT COUNT(*) FROM trips

onlyif duckdb
statement error ^Parser Error:
WITH c AS SELECT COUNT(*) FROM trips

statement error
WITH c AS (SELECT tr_row FROM trips), SELECT COUNT(*) FROM c

onlyif duckdb
statement error ^Parser Error:
WITH c AS (SELECT tr_row FROM trips), SELECT COUNT(*) FROM c

statement error
WITH c AS (SELECT tr_row FROM trips) WITH d AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

onlyif duckdb
statement error ^Parser Error:
WITH c AS (SELECT tr_row FROM trips) WITH d AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

statement error
WITH c USING (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

onlyif duckdb
statement error ^Parser Error:
WITH c USING (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

statement error
WITH c AS NOT (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

onlyif duckdb
statement error ^Parser Error:
WITH c AS NOT (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

statement error
SELECT COUNT(*) FROM (WITH c AS (SELECT tr_row FROM trips))

onlyif duckdb
statement error ^Parser Error:
SELECT COUNT(*) FROM (WITH c AS (SELECT tr_row FROM trips))

# CTE names follow the rules of a table alias without AS.

statement error
WITH select AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM trips

onlyif duckdb
statement error ^Parser Error:
WITH select AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM trips

statement error
WITH semi AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM trips

onlyif duckdb
statement error ^Parser Error:
WITH semi AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM trips

# A CTE name that repeats an earlier one of its list, ASCII case-insensitively and also as a string, whatever the
# repeated CTE holds.

statement error
WITH c AS (SELECT tr_row FROM trips), C AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

onlyif duckdb
statement error ^Parser Error: Duplicate CTE name
WITH c AS (SELECT tr_row FROM trips), C AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

statement error
WITH "Trips" AS (SELECT tr_row FROM trips), "tRIPS" AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM trips

onlyif duckdb
statement error ^Parser Error: Duplicate CTE name
WITH "Trips" AS (SELECT tr_row FROM trips), "tRIPS" AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM trips

statement error
WITH c AS (SELECT tr_row FROM trips), 'c' AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

onlyif duckdb
statement error ^Parser Error: Duplicate CTE name
WITH c AS (SELECT tr_row FROM trips), 'c' AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

statement error
WITH c AS (SELECT tr_row FROM trips), c AS (SELECT tr_row FROM trips WHERE tr_row IS NULL) SELECT COUNT(*) FROM c

onlyif duckdb
statement error ^Parser Error: Duplicate CTE name
WITH c AS (SELECT tr_row FROM trips), c AS (SELECT tr_row FROM trips WHERE tr_row IS NULL) SELECT COUNT(*) FROM c

statement error
WITH c AS (SELECT tr_row FROM trips), c AS MATERIALIZED (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

onlyif duckdb
statement error ^Parser Error: Duplicate CTE name
WITH c AS (SELECT tr_row FROM trips), c AS MATERIALIZED (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

# ---- column alias lists: empty, a comma alone, no name, a reserved word or a word that is no alias ----

statement error
WITH c() AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

onlyif duckdb
statement error ^Parser Error:
WITH c() AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

statement error
