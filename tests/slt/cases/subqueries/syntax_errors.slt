# ---- derived tables: a column alias list without an alias or after a second one, the end of the query inside ----

statement error
SELECT COUNT(*) FROM (SELECT tr_row FROM trips) (x)

onlyif duckdb
statement error ^Parser Error:
SELECT COUNT(*) FROM (SELECT tr_row FROM trips) (x)

statement error
SELECT COUNT(*) FROM (SELECT tr_row FROM trips) AS (x)

onlyif duckdb
statement error ^Parser Error:
SELECT COUNT(*) FROM (SELECT tr_row FROM trips) AS (x)

statement error
SELECT COUNT(*) FROM (SELECT tr_row FROM trips) AS s(x) (y)

onlyif duckdb
statement error ^Parser Error:
