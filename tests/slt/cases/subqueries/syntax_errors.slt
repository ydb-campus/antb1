statement error ^Parser Error:
SELECT COUNT(*) FROM (values)

# After a derived table the words that are never aliases: time travel (AT) reads a table only.

statement error
SELECT COUNT(*) FROM (SELECT tr_row FROM trips) semi

onlyif duckdb
statement error ^Parser Error:
SELECT COUNT(*) FROM (SELECT tr_row FROM trips) semi

statement error
SELECT COUNT(*) FROM (SELECT tr_row FROM trips) AT (VERSION => 1)

onlyif duckdb
statement error ^Parser Error:
SELECT COUNT(*) FROM (SELECT tr_row FROM trips) AT (VERSION => 1)

statement error
SELECT COUNT(*) FROM (SELECT tr_row FROM trips) AS s(x) AT (VERSION => 1)

onlyif duckdb
statement error ^Parser Error:
SELECT COUNT(*) FROM (SELECT tr_row FROM trips) AS s(x) AT (VERSION => 1)

# antb1's messages.

onlyif antb1
statement error ^parse: expected SELECT, found end of input$
WITH c AS (SELECT tr_row FROM trips)

onlyif antb1
statement error ^parse: duplicate CTE name in the WITH list \(names match case-insensitively\)$
WITH c AS (SELECT tr_row FROM trips), C AS (SELECT tr_row FROM trips) SELECT COUNT(*) FROM c

# ---- DuckDB only, for good: DuckDB's answers that antb1's grammar rests on ----

# DuckDB takes a trailing comma in a column alias list (antb1 exits 4).
onlyif duckdb
query II nosort
SELECT COUNT(*), MAX(x) FROM (SELECT tr_row, tr_fare FROM trips) AS s(x,)
----
3000	2999

# A CTE's column alias list may be longer than its query's select list: DuckDB ignores the extra names.
onlyif duckdb
query II nosort
WITH c(x, y, z) AS (SELECT tr_row FROM trips) SELECT COUNT(*), MAX(x) FROM c
----
3000	2999

# A WITH list inside a derived table may reuse a name of the statement's.
onlyif duckdb
query I nosort
WITH c AS (SELECT MIN(tr_row) AS x FROM trips) SELECT x FROM (WITH c AS (SELECT MAX(tr_row) AS x FROM trips) SELECT x FROM c)
----
2999
