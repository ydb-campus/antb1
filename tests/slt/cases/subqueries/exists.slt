# An EXISTS outside a NOT EXISTS: the semi join above the anti join reads its rows rather than
# giving up on them. (This said "ADR 0026's C2c is not in" until 2026-10-21; C2c shipped on
# 2026-10-16, so both joins may now emit their build side.)
query I nosort
SELECT COUNT(*) FROM zones WHERE NOT EXISTS (SELECT * FROM trips WHERE tr_pickup = zn_id AND tr_fare > 60) AND EXISTS (SELECT * FROM trips WHERE tr_dropoff = zn_id)
----
BIGINT
40

# ---- DuckDB only until the uncorrelated EXISTS gets a PR (ADR 0023) ----

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM trips WHERE EXISTS (SELECT * FROM promos)
----
BIGINT
0

# ---- DuckDB only until mark joins get a PR (ADR 0023: EXISTS under OR exits 4) ----

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_fare > 25 OR EXISTS (SELECT * FROM riders WHERE rd_id = tr_rider AND rd_tier = 'gold')
----
BIGINT
1114

# ---- DuckDB only, for good: DuckDB's error texts ----

onlyif duckdb
statement error ^Binder Error: Ambiguous reference to table "z"
SELECT COUNT(*) FROM trips WHERE EXISTS (SELECT * FROM zones AS z, cities AS z WHERE z.zn_id = tr_pickup AND z.zn_city = z.ct_id)
