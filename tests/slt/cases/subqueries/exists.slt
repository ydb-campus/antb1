# Correlated EXISTS and NOT EXISTS (ADR 0023) over the star schema: a trip counts once however many rows match, NULL
# and dangling keys, residuals that read both blocks, conjuncts on the outer or the inner block only, a two-column
# correlation, an empty inner side and an outer name in an ON. Every pending subquery correlates through an equality
# key, as ADR 0023 rejects a correlated EXISTS without one with exit code 4.

# ---- the inputs, one table at a time ----

query I nosort
SELECT COUNT(*) FROM shifts WHERE sh_hours > 10
----
BIGINT
115

query II nosort
SELECT COUNT(*), COUNT(tr_fare) FROM trips WHERE tr_fare > 20
----
BIGINT	BIGINT
897	897

# ---- correlated EXISTS and NOT EXISTS (ADR 0023, roadmap PR U2) ----

# Each trip counts once, although 8 riders repeat their key.
query ID nosort
SELECT COUNT(*), SUM(tr_fare) FROM trips WHERE EXISTS (SELECT * FROM riders WHERE rd_id = tr_rider)
----
BIGINT	DECIMAL(38,2)
2745	41289.25

# NOT EXISTS keeps the NULL and the dangling keys: with EXISTS, every trip once.
query II nosort
SELECT COUNT(*), COUNT(tr_driver) FROM trips WHERE EXISTS (SELECT * FROM drivers WHERE dv_id = tr_driver)
----
BIGINT	BIGINT
2577	2577

query II nosort
SELECT COUNT(*), COUNT(tr_driver) FROM trips WHERE NOT EXISTS (SELECT * FROM drivers WHERE dv_id = tr_driver)
----
BIGINT	BIGINT
423	319

# A residual that reads both blocks.
query I nosort
SELECT COUNT(*) FROM trips WHERE EXISTS (SELECT * FROM shifts WHERE sh_driver = tr_driver AND sh_day < tr_day)
----
BIGINT
2206

query I nosort
SELECT COUNT(*) FROM trips WHERE NOT EXISTS (SELECT * FROM shifts WHERE sh_driver = tr_driver AND sh_day < tr_day)
----
BIGINT
794

# A conjunct on the outer block only: where it is false or NULL, NOT EXISTS keeps the trip.
query II nosort
SELECT COUNT(*), COUNT(tr_fare) FROM trips WHERE EXISTS (SELECT * FROM drivers WHERE dv_id = tr_driver AND tr_fare > 20)
----
BIGINT	BIGINT
771	771

query II nosort
SELECT COUNT(*), COUNT(tr_fare) FROM trips WHERE NOT EXISTS (SELECT * FROM drivers WHERE dv_id = tr_driver AND tr_fare > 20)
----
BIGINT	BIGINT
2229	2132

# A conjunct on the inner block only.
query I nosort
SELECT COUNT(*) FROM trips WHERE EXISTS (SELECT * FROM shifts WHERE sh_driver = tr_driver AND sh_hours > 10)
----
BIGINT
2143

# Two columns: 445 trips have a shift that day, where the inner join has 447 rows.
query I nosort
SELECT COUNT(*) FROM trips WHERE EXISTS (SELECT * FROM shifts WHERE sh_driver = tr_driver AND sh_day = tr_day)
----
BIGINT
445

query I nosort
SELECT COUNT(*) FROM trips WHERE NOT EXISTS (SELECT * FROM shifts WHERE sh_driver = tr_driver AND sh_day = tr_day)
----
BIGINT
2555

# An empty inner side.
query I nosort
SELECT COUNT(*) FROM trips WHERE EXISTS (SELECT * FROM promos WHERE pm_id = tr_promo)
----
BIGINT
0

query I nosort
SELECT COUNT(*) FROM trips WHERE NOT EXISTS (SELECT * FROM promos WHERE pm_id = tr_promo)
----
BIGINT
3000

# VARCHAR keys: NULL, std and XL.
query I nosort
SELECT COUNT(*) FROM trips WHERE NOT EXISTS (SELECT * FROM tariffs WHERE tf_code = tr_tariff)
----
BIGINT
726

# A select list other than *.
query I nosort
SELECT COUNT(*) FROM trips WHERE EXISTS (SELECT rd_city FROM riders WHERE rd_id = tr_rider AND rd_tier = 'gold')
----
BIGINT
911

# The drivers without a trip: the NULL key, drivers 90 to 95 and the key beyond INTEGER.
query I rowsort
SELECT dv_row FROM drivers WHERE NOT EXISTS (SELECT * FROM trips WHERE tr_driver = dv_id)
----
INTEGER
50
90
91
92
93
94
95
96

# An outer name in an ON: label is in no FROM item up to that JOIN, so it is cities' label, although the later zones
# has a label too.
query I rowsort
SELECT ct_id FROM cities
WHERE EXISTS (SELECT * FROM trips JOIN tariffs ON tf_code = tr_tariff AND tf_label = label JOIN zones ON zn_id = tr_pickup)
----
SMALLINT
1
4

# A subquery in an ON sees its block as the ON does (rule 10): x is a later FROM item, so no outer reference reaches it.
statement error
SELECT COUNT(*) FROM zones JOIN cities ON zn_city = ct_id AND EXISTS (SELECT * FROM drivers WHERE dv_city = x.ct_id) JOIN cities AS x ON x.ct_id = zn_city

# ... and the later cities' label does not make zones' label ambiguous.
query I nosort
SELECT COUNT(*) FROM zones JOIN drivers ON zn_city = dv_city AND EXISTS (SELECT * FROM tariffs WHERE tf_label = label) JOIN cities ON ct_id = zn_city
----
BIGINT
178

# An ON in a comma list sees its join group first, then the comma siblings before it: label is the group's cities',
# although the comma sibling zones has one too, and zn_id, which only zones has, is zones'.
query I nosort
SELECT COUNT(*) FROM zones AS a, drivers JOIN cities ON ct_id = dv_city AND EXISTS (SELECT * FROM tariffs WHERE tf_label = label)
----
BIGINT
1800

query I nosort
SELECT COUNT(*) FROM zones AS a, drivers JOIN cities ON ct_id = dv_city AND EXISTS (SELECT * FROM fleet WHERE fl_zone = zn_id)
----
BIGINT
267

# Inside EXISTS, * is checked: two bindings named z that share label.
statement error
SELECT COUNT(*) FROM trips WHERE EXISTS (SELECT * FROM zones AS z, cities AS z WHERE z.zn_id = tr_pickup AND z.zn_city = z.ct_id)

# ---- DuckDB only until the general domain join gets a PR (ADR 0023: an aggregate inside EXISTS exits 4) ----

# An aggregate returns a row even over no input, so this EXISTS keeps every trip.
onlyif duckdb
query I nosort
SELECT COUNT(*) FROM trips WHERE EXISTS (SELECT COUNT(*) FROM promos WHERE pm_id = tr_promo)
----
BIGINT
3000

# ---- the outer side far smaller than the subquery's (ADR 0026's C2b) ----

# `trips` has about twenty times the rows of `zones`, so the semi join builds on the outer side and
# emits the rows it marked there, in the build's order rather than the probe's.

# Every row of the smaller side once, however many rows of the larger one match it.
query I nosort
SELECT COUNT(*) FROM zones WHERE EXISTS (SELECT * FROM trips WHERE tr_pickup = zn_id)
----
BIGINT
40

# A residual reads both blocks, so its columns are the outer side's and then the subquery's while
# the join probes with the subquery: the marked rows are those with a pair that passes.
query I nosort
SELECT zn_id FROM zones WHERE EXISTS (SELECT * FROM trips WHERE tr_pickup = zn_id AND tr_fare > zn_radius) ORDER BY zn_id
----
INTEGER
