# A derived table right under the dropped select list loses its select list too, as in DuckDB. Under the block's WHERE
# (or anything but a LIMIT or an OFFSET) it keeps it, so antb1 computes its unread item (divergence D32).
query I nosort
SELECT COUNT(*) FROM cities WHERE EXISTS (SELECT * FROM (SELECT id, i32 + 2147483647 + 1 AS v FROM edge) AS d)
----
BIGINT
6

onlyif antb1
statement error Overflow in addition
SELECT COUNT(*) FROM cities WHERE EXISTS (SELECT * FROM (SELECT id, i32 + 2147483647 + 1 AS v FROM edge) AS d WHERE id > 0)

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM cities WHERE EXISTS (SELECT * FROM (SELECT id, i32 + 2147483647 + 1 AS v FROM edge) AS d WHERE id > 0)
----
BIGINT
6

