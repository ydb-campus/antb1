# ---- DuckDB only until references further out than the enclosing block get a PR (ADR 0023) ----

# The innermost x is the outermost block's: the middle block's x is a FROM item after the ON the subquery is in.
onlyif duckdb
query I nosort
SELECT COUNT(*) FROM cities AS x WHERE EXISTS (SELECT * FROM zones JOIN drivers ON zn_city = dv_city AND EXISTS (SELECT * FROM riders WHERE rd_city = x.ct_id) JOIN cities AS x ON x.ct_id = zn_city WHERE zn_id < 10)
----
BIGINT
3

# ---- uncorrelated EXISTS and NOT EXISTS (ADR 0041's SQ4a): COUNT(*) over LIMIT 1 of any block ----

