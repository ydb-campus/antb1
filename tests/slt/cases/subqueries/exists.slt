----
BIGINT
6

onlyif duckdb
statement error Overflow in addition
SELECT COUNT(*) FROM cities WHERE EXISTS (SELECT MAX(i32) FROM edge ORDER BY MAX(i32) + 1)

# Divergence D32: a correlated EXISTS's ORDER BY is dropped (ADR 0023's Path 1 takes its FROM and WHERE alone), so its
# keys are never computed; DuckDB computes them and fails.
onlyif antb1
query I nosort
SELECT COUNT(*) FROM cities WHERE EXISTS (SELECT * FROM edge WHERE id = ct_id ORDER BY i32 + 2147483647)
----
BIGINT
6

