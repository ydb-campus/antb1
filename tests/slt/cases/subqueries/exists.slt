# Divergence D32: an aggregate of an EXISTS block that nothing reads is computed, grouped or not, so its overflow
# fails the query; DuckDB removes it. An aggregate HAVING reads fails in both.
onlyif antb1
statement error Overflow in multiplication
SELECT COUNT(*) FROM cities WHERE EXISTS (SELECT MAX(i32 * i32) FROM edge)

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM cities WHERE EXISTS (SELECT MAX(i32 * i32) FROM edge)
----
BIGINT
6

onlyif antb1
statement error Overflow in addition
SELECT COUNT(*) FROM cities WHERE EXISTS (SELECT i16, SUM(i32 + 2147483647) FROM edge GROUP BY i16)

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM cities WHERE EXISTS (SELECT i16, SUM(i32 + 2147483647) FROM edge GROUP BY i16)
----
BIGINT
6

