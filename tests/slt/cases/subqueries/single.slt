1	NULL
2	1
6	NULL
7	1
11	NULL
12	1
16	NULL
17	1
21	NULL
22	1
26	NULL
27	1
31	NULL
32	1
36	NULL
37	1
38	NULL

statement error More than one row returned by a subquery used as an expression
SELECT (SELECT c.ct_id FROM cities c WHERE c.ct_id < z.zn_city) FROM zones z

# Remaining equality keys must reject a row before the mixed residual can overflow.
query III nosort
SELECT o.id, (SELECT i.id+1 FROM edge i WHERE i.id=o.id AND i.i32=o.id AND i.i32+1<=o.id),
       (SELECT COUNT(*) FROM edge i WHERE i.id=o.id AND i.i32=o.id AND i.i32+1<=o.id GROUP BY i.id)
FROM edge o WHERE o.id=1
----
INTEGER	INTEGER	BIGINT
1	NULL	NULL

# The single static group has the same guarded WHERE under DISTINCT and ORDER BY.
query III nosort
SELECT o.id, (SELECT COUNT(*) FROM edge i WHERE i.id=o.id AND i.i32+1<=o.id GROUP BY () ORDER BY 1),
       (SELECT DISTINCT COUNT(*) FROM edge i WHERE i.id=o.id AND i.i32+1<=o.id GROUP BY () ORDER BY 1)
FROM edge o WHERE o.id=2
----
INTEGER	BIGINT	BIGINT
2	1	1

# LIMIT stops before a later UNION ALL arm whose binding has two scalar matches.
query II nosort
SELECT o.k, (SELECT i.id FROM edge i WHERE i.id<o.k) AS v
FROM (SELECT 1 AS k FROM edge UNION ALL SELECT 2 AS k FROM edge) o LIMIT 1
----
INTEGER	INTEGER
1	0
