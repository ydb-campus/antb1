# A missing city pads even a constant select item. Repeated outer bindings each get a value.
query III rowsort
SELECT z.zn_city, (SELECT c.ct_pop FROM cities c WHERE c.ct_id = z.zn_city),
       (SELECT 1 FROM cities c WHERE c.ct_id = z.zn_city)
FROM zones z
----
