# Many candidates, one passing residual for some bindings and none for others.
query II nosort
SELECT c.ct_id, (SELECT r.rd_row FROM riders r
                 WHERE r.rd_city = c.ct_id AND r.rd_row <= c.ct_id)
FROM cities c ORDER BY c.ct_id
----
SMALLINT	INTEGER
1	0
2	1
3	2
4	NULL
5	NULL
6	NULL

# The build contains duplicate keys that none of the surviving outer rows probe.
query II nosort
SELECT c.ct_id, (SELECT r.rd_row FROM riders r WHERE r.rd_city = c.ct_id)
FROM cities c WHERE c.ct_id >= 4 ORDER BY c.ct_id
----
SMALLINT	INTEGER
4	NULL
5	NULL
6	NULL

# Identical selected values are still two rows.
statement error More than one row returned by a subquery used as an expression
SELECT (SELECT 7 FROM riders r WHERE r.rd_city = c.ct_id) FROM cities c

# NULL-equal keys match multiple rows whose selected values are all NULL.
statement error More than one row returned by a subquery used as an expression
SELECT (SELECT r.rd_city FROM riders r WHERE r.rd_city IS NOT DISTINCT FROM d.dv_city)
FROM drivers d WHERE d.dv_city IS NULL

# Two distinct groups return the same scalar value.
statement error More than one row returned by a subquery used as an expression
SELECT (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id GROUP BY r.rd_row) FROM cities c

# HAVING eliminates surplus groups before checking cardinality.
query II nosort
SELECT c.ct_id, (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id
                 GROUP BY r.rd_row HAVING MIN(r.rd_row) = 1)
FROM cities c ORDER BY c.ct_id
----
SMALLINT	BIGINT
1	NULL
2	1
3	NULL
4	NULL
5	NULL
6	NULL

# GROUP BY () has one group even when WHERE accepts no rows.
query II nosort
SELECT c.ct_id, (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id GROUP BY ())
FROM cities c ORDER BY c.ct_id
----
SMALLINT	BIGINT
1	77
2	77
3	78
4	0
5	0
6	0

# An earlier SINGLE preserves the bindings needed by a later computed select.
query III nosort
SELECT z.zn_id, (SELECT c.ct_id FROM cities c WHERE c.ct_id = z.zn_city),
       (SELECT c.ct_id + 1 FROM cities c WHERE c.ct_id = z.zn_city)
FROM zones z WHERE z.zn_id <= 8 ORDER BY z.zn_id
----
INTEGER	SMALLINT	SMALLINT
1	1	2
2	2	3
3	3	4
4	4	5
5	5	6
6	1	2
7	2	3
8	3	4
