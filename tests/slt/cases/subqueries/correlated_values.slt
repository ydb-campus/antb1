# ---- select item errors (ADR 0041's SQ5b) ----

# An overflow in an item over a real group, and one only over the empty value: the NULL i32 keys of rows 5 and 9 match
# no row, and 0 - 1 + min overflows, which an item moved above the LEFT join back computes too.
statement error Overflow in addition of
SELECT e.id, (SELECT MAX(e2.i64) + 1 FROM edge e2 WHERE e2.id = e.id) AS v FROM edge e ORDER BY 1

statement error Overflow in addition of
SELECT e.id, (SELECT COUNT(*) - 1 + (-9223372036854775807 - 1) FROM edge e2 WHERE e2.i32 = e.i32) AS v FROM edge e
ORDER BY 1

