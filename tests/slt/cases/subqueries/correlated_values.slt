# A select item that is no key, written like an aggregate argument's value that waits in the tail: DuckDB's bind error
# (ct_id is not grouped). antb1 refuses it (exit 4): before SQ5b at the aggregate's argument, since SQ5b with SQ13's
# message at the item.
pending SQ13
statement error must appear in the GROUP BY clause
SELECT (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id) AS n,
SUM(c.ct_id * (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id)) AS s FROM cities c GROUP BY c.ct_id % 2

