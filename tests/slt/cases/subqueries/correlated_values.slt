# ---- under OR (ADR 0041's SQ5a) ----

# Cities 1 to 3 have riders, 4 to 6 none. A city passes by either branch, so the value over no rows must reach the
# filter: the join back is LEFT. COUNT, SUM, COUNT(DISTINCT x) and a VARCHAR MIN; the same subquery in both branches;
# two different subqueries; an AND inside a branch; an uncorrelated value beside it.
query I nosort
SELECT c.ct_id FROM cities c WHERE (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id) > 77 OR c.ct_id = 6
ORDER BY 1
----
SMALLINT
3
6

query I nosort
SELECT c.ct_id FROM cities c WHERE (SELECT SUM(r.rd_row) FROM riders r WHERE r.rd_city = c.ct_id) > 9000 OR c.ct_id = 6
ORDER BY 1
----
SMALLINT
1
2
3
6

