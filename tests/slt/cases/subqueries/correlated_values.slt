SELECT c.ct_id, z.zn_id FROM cities c LEFT JOIN zones z ON z.zn_city = c.ct_id
AND (SELECT COUNT(*) FROM trips t WHERE t.tr_pickup = z.zn_id AND t.tr_fare > 27) = 0 ORDER BY 1, 2
