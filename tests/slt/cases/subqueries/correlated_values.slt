# which reads the ungrouped ct_id, DuckDB's bind error. antb1 refuses the item with this section's message, and SQ13
# makes it antb1's bind error.
pending SQ13
statement error
SELECT (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id) AS k, COUNT(*) AS n FROM cities c
GROUP BY (SELECT COUNT(*) FROM riders R WHERE R.rd_city = c.ct_id) ORDER BY 1

# ---- DuckDB only until constant aggregate arguments get a PR (ADR 0041: SUM((q)) exits 4) ----

# A correlated value as the whole of an aggregate's argument, or with literals alone.
onlyif duckdb
query I nosort
SELECT SUM((SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id)) FROM cities c
----
HUGEINT
232

onlyif duckdb
query I nosort
SELECT SUM((SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id) * 2) FROM cities c
----
HUGEINT
464

onlyif duckdb
query II nosort
SELECT c.ct_id % 2 AS g, COUNT(DISTINCT (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id) + 0) AS n
FROM cities c GROUP BY 1 ORDER BY 1
----
SMALLINT	BIGINT
0	2
1	3

onlyif duckdb
query II nosort
SELECT SUM((SELECT COUNT(*) FROM trips t WHERE t.tr_rider = r.rd_id) + 0), COUNT(*) FROM riders r
----
HUGEINT	BIGINT
2841	240

# ---- DuckDB only until subqueries in a LEFT JOIN's ON get a PR (ADR 0041's decision 3: DuckDB coverage) ----

# A correlated value in a LEFT JOIN's ON, in a conjunct that reads the right input alone.
onlyif duckdb
query II nosort
SELECT c.ct_id, z.zn_id FROM cities c LEFT JOIN zones z ON z.zn_city = c.ct_id
AND (SELECT COUNT(*) FROM trips t WHERE t.tr_pickup = z.zn_id AND t.tr_fare > 27) = 0 ORDER BY 1, 2
----
SMALLINT	INTEGER
1	31
2	NULL
3	8
4	9
4	19
5	10
5	20
5	30
6	NULL

# ---- DuckDB only, for good: DuckDB's refusals of correlated values in a LEFT or FULL JOIN's ON ----

# One whose conjunct reads the left input, and one in a FULL JOIN's ON.
onlyif duckdb
statement error ^Not implemented Error: Cannot perform non-inner join on subquery
SELECT c.ct_id, z.zn_id FROM cities c LEFT JOIN zones z ON z.zn_city = c.ct_id
AND (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id) = 0 ORDER BY 1, 2

onlyif duckdb
statement error ^Not implemented Error: Cannot perform non-inner join on subquery
SELECT c.ct_id, z.zn_id FROM cities c FULL JOIN zones z ON z.zn_city = c.ct_id
AND (SELECT COUNT(*) FROM trips t WHERE t.tr_pickup = z.zn_id) > 75 ORDER BY 1, 2

# ---- pending: a correlated value in a conjunct that also reads an enclosing block (ADR 0041; roadmap PR SQ8) ----

