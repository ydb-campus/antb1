# ---- errors and the order of conditions (ADR 0041's SQ5a) ----

# Values are eager (D16): the subquery is computed for every outer row before CASE or OR decides, so the cast of
# COUNT(*) - 1 fails for cities 4 to 6 in both engines, under an untaken CASE branch and beside a true OR branch.
statement error out of range for the destination type UINT16
SELECT c.ct_id FROM cities c WHERE CASE WHEN c.ct_id < 4
THEN (SELECT CAST(COUNT(*) - 1 AS USMALLINT) FROM riders r WHERE r.rd_city = c.ct_id) END > 0 ORDER BY 1

statement error out of range for the destination type UINT16
SELECT c.ct_id FROM cities c
WHERE c.ct_id >= 4 OR (SELECT CAST(COUNT(*) - 1 AS USMALLINT) FROM riders r WHERE r.rd_city = c.ct_id) > 0 ORDER BY 1

# Both engines answer when the condition that rejects the value over no rows comes first, and when the cast comes
# first over a SUM, whose strict expression is NULL over no rows. Written the other way round over a COUNT, each
# engine's outcome differs (divergence D24).
query I nosort
SELECT c.ct_id FROM cities c WHERE (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id) > 0
