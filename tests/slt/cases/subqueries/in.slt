# Uncorrelated IN and NOT IN subqueries (ADR 0022) over the star schema: a NULL in the set, a NULL probe value and an
# empty set, in both spellings of NOT IN; repeated values in the set; keys of two types; GROUP BY and HAVING inside
# the subquery; a subquery in HAVING; and a name of the outer block that the subquery's own table hides.

# ---- the inputs, one table at a time ----

query II nosort
SELECT COUNT(*), COUNT(tr_tariff) FROM trips
----
3000	2842

# tariffs and drivers each hold one NULL key, and promos is empty.
query II nosort
SELECT COUNT(*), COUNT(tf_code) FROM tariffs
----
9	8

query II nosort
SELECT COUNT(*), COUNT(dv_id) FROM drivers
----
97	96

query I nosort
SELECT COUNT(*) FROM promos
----
0

# ---- pending: IN and NOT IN subqueries (ADR 0022; roadmap PR J5 removes these guards) ----

# IN keeps the rows with a match: the NULL in the set changes nothing.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_tariff IN (SELECT tf_code FROM tariffs)
----
2274

# With a NULL in the set, NOT IN keeps no row, in either spelling.
query I nosort null_in_set
SELECT COUNT(*) FROM trips WHERE tr_tariff NOT IN (SELECT tf_code FROM tariffs)
----
0

query I nosort null_in_set
SELECT COUNT(*) FROM trips WHERE NOT (tr_tariff IN (SELECT tf_code FROM tariffs))
----
0

query I nosort null_in_set
SELECT COUNT(*) FROM trips WHERE tr_driver NOT IN (SELECT dv_id FROM drivers)
----
0

# Without the NULL code: std and XL, never a NULL probe value.
query TI rowsort
SELECT tr_tariff, COUNT(*) FROM trips WHERE tr_tariff NOT IN (SELECT tf_code FROM tariffs WHERE tf_row <> 7) GROUP BY tr_tariff
----
XL	284
std	284

# A set without NULLs drops the NULL probe values: only the 319 dangling drivers stay.
query II nosort null_probe
SELECT COUNT(*), COUNT(tr_driver) FROM trips WHERE tr_driver NOT IN (SELECT dv_id FROM drivers WHERE dv_id > 0)
----
319	319

query II nosort null_probe
SELECT COUNT(*), COUNT(tr_driver) FROM trips WHERE NOT (tr_driver IN (SELECT dv_id FROM drivers WHERE dv_id > 0))
----
319	319

# An empty set keeps every row, NULL probe values included.
query I nosort empty_set
SELECT COUNT(*) FROM trips WHERE tr_promo NOT IN (SELECT pm_id FROM promos)
----
3000

query I nosort empty_set
SELECT COUNT(*) FROM trips WHERE NOT (tr_promo IN (SELECT pm_id FROM promos))
----
3000

query I nosort empty_set
SELECT COUNT(*) FROM trips WHERE tr_driver NOT IN (SELECT dv_id FROM drivers WHERE dv_id > 9000000000)
----
3000

query I nosort
SELECT COUNT(*) FROM trips WHERE tr_promo IN (SELECT pm_id FROM promos)
----
0

# No NULL on either side: the pickups without a zone.
query II rowsort
SELECT tr_pickup, COUNT(*) FROM trips WHERE tr_pickup NOT IN (SELECT zn_id FROM zones) GROUP BY tr_pickup
----
41	69
42	69
43	69

# A repeated value in the set counts once: 2745 trips, where the inner join has 2841 rows.
query ID nosort
SELECT COUNT(*), SUM(tr_fare) FROM trips WHERE tr_rider IN (SELECT rd_id FROM riders)
----
2745	41289.25

# GROUP BY and HAVING inside the subquery: the trips of the 8 repeated riders.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_rider IN (SELECT rd_id FROM riders GROUP BY rd_id HAVING COUNT(*) > 1)
----
96

# Keys of two types: INTEGER against BIGINT (driver 2^32 + 1000 matches no trip), DECIMAL(4,2) against DECIMAL(5,3).
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_driver IN (SELECT dv_id FROM drivers)
----
2577

query DI rowsort
SELECT tr_rate, COUNT(*) FROM trips WHERE tr_rate IN (SELECT tf_rate FROM tariffs) GROUP BY tr_rate
----
1.00	348
1.25	350
1.50	348
1.75	350
2.00	345
2.50	342

query DI rowsort
SELECT tr_rate, COUNT(*) FROM trips WHERE tr_rate NOT IN (SELECT tf_rate FROM tariffs WHERE tf_rate > 1) GROUP BY tr_rate
----
0.88	343
1.00	348
2.25	343

# DATE values.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_day IN (SELECT sh_day FROM shifts WHERE sh_driver = 1000)
----
473

# A table against itself: zone 40's parent 77 is in no set, NULL parents drop out, and parents 2 to 5 are in the set.
query II rowsort
SELECT zn_id, zn_parent FROM zones WHERE zn_parent NOT IN (SELECT zn_id FROM zones WHERE zn_city <> 1)
----
11	1
16	1
21	1
26	1
31	1
36	1
40	77
6	1

# A subquery in HAVING.
query II rowsort
SELECT tr_pickup, COUNT(*) FROM trips GROUP BY tr_pickup HAVING tr_pickup NOT IN (SELECT zn_id FROM zones)
----
41	69
42	69
43	69

# Inside the subquery, label is the label of cities, not of the outer zones.
query TI rowsort
SELECT label, COUNT(*) FROM zones WHERE label IN (SELECT label FROM cities) GROUP BY label
----
airport	5
center	5

# A subquery over a join.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_driver IN (SELECT dv_id FROM drivers JOIN cities ON dv_city = ct_id WHERE ct_pop > 40000)
----
1216

# A CTE referenced inside the subquery (roadmap PR J4): the rider rows of the riders with 13 trips or
# more, repeated keys twice.
query II nosort
WITH busy AS (SELECT tr_rider AS rider FROM trips GROUP BY tr_rider HAVING COUNT(*) >= 13)
SELECT COUNT(*), COUNT(DISTINCT rd_id) FROM riders WHERE rd_id IN (SELECT rider FROM busy)
----
62	59

# ---- the shapes the generator does not write (roadmap PR J5a) ----

# The build side cast, not the probe: dv_id is the BIGINT here and tr_driver the INTEGER.
query I nosort
SELECT COUNT(*) FROM drivers WHERE dv_id IN (SELECT tr_driver FROM trips)
----
89

# A LEFT JOIN's padded right column as the probe of a NOT IN over an empty set: every row of the join
# is kept, the padded ones included, which a plain anti join over a NULL probe would not do.
query II nosort
SELECT COUNT(*), COUNT(sh_hours) FROM trips LEFT JOIN shifts ON tr_driver = sh_driver AND tr_day = sh_day
WHERE sh_hours NOT IN (SELECT pm_discount FROM promos)
----
3002	426

# A NULL grouping key under a HAVING NOT IN, against the same groups without it: promos is empty, so
# the set is empty and every group is kept, the NULL key's group included.
query II nosort all_groups
SELECT COUNT(*), SUM(n) FROM (SELECT tr_rider, COUNT(*) AS n FROM trips GROUP BY tr_rider HAVING tr_rider NOT IN (SELECT pm_id FROM promos)) AS s
----
244	3000

query II nosort all_groups
SELECT COUNT(*), SUM(n) FROM (SELECT tr_rider, COUNT(*) AS n FROM trips GROUP BY tr_rider) AS s
----
244	3000

# The same conjunct in an inner join's ON and in WHERE: an ON conjunct of an inner join counts as a
# WHERE conjunct (ADR 0022), so the two agree.
query I nosort inner_on
SELECT COUNT(*) FROM trips JOIN zones ON tr_pickup = zn_id AND tr_rider IN (SELECT rd_id FROM riders)
----
2558

query I nosort inner_on
SELECT COUNT(*) FROM trips JOIN zones ON tr_pickup = zn_id WHERE tr_rider IN (SELECT rd_id FROM riders)
----
2558

# Two subquery conjuncts of one WHERE, stacked in the order they are written.
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_rider IN (SELECT rd_id FROM riders) AND tr_driver NOT IN (SELECT dv_id FROM drivers WHERE dv_id > 0)
----
294

# A subquery as a top-level WHERE conjunct of a derived table's block: the rule is per block.
query I nosort
SELECT COUNT(*) FROM (SELECT tr_row FROM trips WHERE tr_driver IN (SELECT dv_id FROM drivers)) AS s
----
2577

# An aggregate as the probe in HAVING, which is an operand there: the riders whose trip count is one
# of the zone ids, which is 243 of the 244 groups -- one rider has more trips than any zone id.
query II nosort
SELECT COUNT(*), SUM(n) FROM (SELECT COUNT(*) AS n FROM trips GROUP BY tr_rider HAVING COUNT(*) IN (SELECT zn_id FROM zones)) AS s
----
243	2869

# ---- DuckDB only, for good: an IN list of one subquery, which antb1 reads as a list (divergence D22) ----

# A second pair of parentheses makes this an IN list holding one scalar subquery for antb1, where
# DuckDB reads the IN subquery and answers it as the single-paren form: exit code 4 at the inner '('.
onlyif duckdb
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_pickup IN ((SELECT zn_id FROM zones))
----
2793

# ---- DuckDB only until DOUBLE join keys get a PR (ADR 0022: an IN subquery of type DOUBLE exits 4) ----

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_distance IN (SELECT zn_radius FROM zones)
----
276

# ---- DuckDB only until correlated IN and NOT IN get a PR (ADR 0023) ----

onlyif duckdb
query II nosort
SELECT COUNT(*), COUNT(tr_tariff) FROM trips WHERE tr_tariff IN (SELECT tf_code FROM tariffs WHERE tf_rate = tr_rate)
----
199	199

# ---- DuckDB only, for good: IN over a VALUES table, which is postponed (ADR 0025) ----

# `VALUES` is a table constructor, not this IN list. antb1 refuses it either way, but as a call rather than as a
# query: `values` is a name in an expression (divergence D21), so the '(' before it opens no nested query -- which
# is what keeps `-VALUES(a)` round-tripping through its canonical form. In FROM, where it is no name, it is refused
# as a query (ADR 0025).
onlyif duckdb
query I nosort
SELECT COUNT(*) FROM trips WHERE tr_pickup IN (VALUES (1), (2))
----
140
