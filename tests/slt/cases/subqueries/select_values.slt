statement error Alias "n" referenced in a SELECT clause - but the expression has a subquery
SELECT ct_id, (SELECT COUNT(*) FROM cities) AS n FROM cities ORDER BY n - ct_id

onlyif antb1
query II nosort
SELECT ct_id, CASE WHEN ct_id > 3 THEN 1 ELSE 0 END + (SELECT MIN(zn_id) FROM zones) AS m FROM cities ORDER BY -m, ct_id
----
SMALLINT	INTEGER
4	2
5	2
6	2
1	1
2	1
3	1

onlyif duckdb
statement error Alias "m" referenced in a SELECT clause - but the expression has a subquery
SELECT ct_id, CASE WHEN ct_id > 3 THEN 1 ELSE 0 END + (SELECT MIN(zn_id) FROM zones) AS m FROM cities ORDER BY -m, ct_id

# ---- divergences D35 and D32: a failing value that DuckDB's optimizer deletes ----

# DuckDB's filter combiner proves ct_id = 1 AND ct_id = 2 never true and drops the block's plan, the value with it;
# and it drops a derived table's column that nothing reads, its value with it. antb1 builds the value and fails.
onlyif antb1
statement error More than one row returned by a subquery used as an expression
SELECT ct_id, (SELECT zn_id FROM zones) AS v FROM cities WHERE ct_id = 1 AND ct_id = 2

onlyif duckdb
query II rowsort
SELECT ct_id, (SELECT zn_id FROM zones) AS v FROM cities WHERE ct_id = 1 AND ct_id = 2
----
SMALLINT	INTEGER

onlyif antb1
statement error More than one row returned by a subquery used as an expression
SELECT ct_id FROM (SELECT ct_id, (SELECT zn_id FROM zones) AS v FROM cities) d ORDER BY ct_id

onlyif duckdb
query I nosort
SELECT ct_id FROM (SELECT ct_id, (SELECT zn_id FROM zones) AS v FROM cities) d ORDER BY ct_id
----
SMALLINT
1
2
3
4
5
6
