# ---- Row errors ----

# A value of two rows fails in a select item over every row, over an empty table, behind a WHERE that keeps no row,
# in an untaken CASE branch and as COALESCE's never-read argument: its join is built before any row is read.

statement error More than one row returned by a subquery used as an expression
SELECT (SELECT zn_id FROM zones) AS v FROM cities

statement error More than one row returned by a subquery used as an expression
SELECT tr_row, (SELECT zn_id FROM zones) AS c FROM trips WHERE tr_pickup IN (SELECT zn_id FROM zones WHERE zn_id < 0)

statement error More than one row returned by a subquery used as an expression
SELECT CASE WHEN ct_id > 100 THEN (SELECT zn_id FROM zones) ELSE 0 END AS v FROM cities

statement error More than one row returned by a subquery used as an expression
SELECT ct_id, CASE WHEN ct_id > 100 AND EXISTS (SELECT zn_id FROM zones ORDER BY (SELECT zn_id FROM zones)) THEN 1 ELSE 0 END AS e FROM cities ORDER BY 1

statement error More than one row returned by a subquery used as an expression
SELECT ct_id FROM cities ORDER BY (SELECT zn_id FROM zones WHERE zn_id < 3), ct_id

# A value of two rows in another block fails too: an IN subquery's select list, a derived table's column read
# outside, an EXISTS block's ORDER BY keys (under LIMIT, correlated, or by an item's alias) and an EXISTS block's
# DISTINCT list.

statement error More than one row returned by a subquery used as an expression
