SELECT ct_id, v FROM (SELECT ct_id, (SELECT zn_id FROM zones) AS v FROM cities) d ORDER BY ct_id

statement error More than one row returned by a subquery used as an expression
SELECT ct_id FROM cities WHERE EXISTS (SELECT 1 FROM zones ORDER BY zn_id + (SELECT ct_id FROM cities) LIMIT 1) ORDER BY ct_id

statement error More than one row returned by a subquery used as an expression
SELECT ct_id FROM cities WHERE EXISTS (SELECT zn_id FROM zones ORDER BY zn_id + (SELECT zn_id FROM zones)) ORDER BY 1

statement error More than one row returned by a subquery used as an expression
SELECT ct_id FROM cities c WHERE EXISTS (SELECT zn_id FROM zones z WHERE z.zn_city = c.ct_id ORDER BY zn_id + (SELECT zn_id FROM zones)) ORDER BY 1

statement error More than one row returned by a subquery used as an expression
SELECT ct_id FROM cities WHERE EXISTS (SELECT DISTINCT (SELECT zn_id FROM zones) FROM zones) ORDER BY 1

statement error More than one row returned by a subquery used as an expression
SELECT ct_id FROM cities WHERE EXISTS (SELECT (SELECT zn_id FROM zones) AS v FROM zones ORDER BY v) ORDER BY 1

statement error More than one row returned by a subquery used as an expression
SELECT ct_id FROM cities c WHERE EXISTS (SELECT (SELECT zn_id FROM zones) AS v FROM zones z WHERE z.zn_city = c.ct_id ORDER BY v) ORDER BY 1

statement error More than one row returned by a subquery used as an expression
