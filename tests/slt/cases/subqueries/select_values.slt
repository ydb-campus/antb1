statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*) FROM trips WHERE EXISTS (SELECT zn_id FROM zones ORDER BY zn_id + (SELECT zn_id FROM zones) LIMIT 1)

statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*) FROM trips WHERE EXISTS (SELECT zn_id FROM zones WHERE zn_id = tr_pickup ORDER BY zn_id + (SELECT zn_id FROM zones))

statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*) FROM trips WHERE EXISTS (SELECT (SELECT zn_id FROM zones) AS v FROM zones ORDER BY v LIMIT 1)

statement error More than one row returned by a subquery used as an expression
SELECT * FROM (SELECT ct_id, (SELECT zn_id FROM zones) AS v FROM cities UNION ALL SELECT zn_id, zn_city FROM zones) u ORDER BY 1

