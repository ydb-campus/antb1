statement error More than one row returned by a subquery used as an expression
SELECT zn_city, (SELECT zn_id FROM zones) AS v FROM zones GROUP BY zn_city HAVING COUNT(*) < 0

statement error More than one row returned by a subquery used as an expression
SELECT tr_driver, COUNT(*) + (SELECT zn_id FROM zones) AS c FROM trips GROUP BY tr_driver HAVING COUNT(*) < 0

statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*) AS c, (SELECT zn_id FROM zones) AS v FROM zones HAVING COUNT(*) < 0

statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*) + (SELECT zn_id FROM zones) AS c FROM promos

statement error More than one row returned by a subquery used as an expression
SELECT SUM(pm_id * (SELECT zn_id FROM zones)) AS s FROM promos

statement error More than one row returned by a subquery used as an expression
