# ---- errors and boundaries ----

# A value of two rows fails in a block that aggregates, in both engines: as a GROUP BY key (an expression, or the
# value alone), in a select item over a key or over an aggregate, in a CASE branch over aggregates, in an item that a
# HAVING reads by its alias, under DISTINCT and in a ROLLUP block's select list.

statement error More than one row returned by a subquery used as an expression
SELECT zn_city + (SELECT ct_id FROM cities) AS k, COUNT(*) AS c FROM zones GROUP BY zn_city + (SELECT ct_id FROM cities)

statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*) AS c FROM zones GROUP BY (SELECT zn_city FROM zones WHERE zn_id < 3)

statement error More than one row returned by a subquery used as an expression
SELECT zn_city, zn_city * (SELECT ct_id FROM cities) AS v FROM zones GROUP BY zn_city

statement error More than one row returned by a subquery used as an expression
SELECT zn_city, COUNT(*) + (SELECT zn_id FROM zones) AS c FROM zones GROUP BY zn_city

statement error More than one row returned by a subquery used as an expression
SELECT zn_city, CASE WHEN COUNT(*) > 100 THEN (SELECT zn_id FROM zones) ELSE 0 END AS v FROM zones GROUP BY zn_city

statement error More than one row returned by a subquery used as an expression
SELECT zn_city, COUNT(*) + (SELECT zn_id FROM zones) AS c FROM zones GROUP BY zn_city HAVING c > 5

statement error More than one row returned by a subquery used as an expression
SELECT DISTINCT COUNT(*) + (SELECT zn_id FROM zones) AS c FROM zones GROUP BY zn_city

statement error More than one row returned by a subquery used as an expression
SELECT zn_city, COUNT(*) + (SELECT zn_id FROM zones) AS c FROM zones GROUP BY ROLLUP (zn_city)

# The value's join is built before any row is read, so it fails where no row or group reads it: a key over an empty
# table, a HAVING aggregate's argument and an ORDER BY over zero groups, an item behind a HAVING that keeps no group
# (or no global row), a global aggregate over an empty table, and a key behind a WHERE IN that turns out empty.

