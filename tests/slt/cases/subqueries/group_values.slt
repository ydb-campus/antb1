# An aggregate of the subquery's own columns, of no column (a literal argument too) or of both is in that subquery's
# WHERE: a bind error in both engines (their texts differ). Under a subquery in GROUP BY it is DuckDB's GROUP BY error.

statement error
SELECT ct_id, (SELECT COUNT(*) FROM zones WHERE zn_id > MAX(zn_id)) AS v FROM cities ORDER BY ct_id

statement error
SELECT zn_city, (SELECT COUNT(*) FROM cities WHERE ct_id < COUNT(*)) AS n FROM zones GROUP BY zn_city ORDER BY zn_city

statement error
SELECT ct_id FROM cities ORDER BY (SELECT COUNT(*) FROM zones WHERE zn_id > MAX(zn_id)), ct_id

statement error
SELECT zn_city, (SELECT COUNT(*) FROM cities WHERE ct_id < SUM(1)) AS n FROM zones GROUP BY zn_city ORDER BY zn_city

statement error
SELECT zn_city, (SELECT COUNT(*) FROM cities c WHERE c.ct_id < MAX(c.ct_id)) AS n FROM zones GROUP BY zn_city ORDER BY zn_city

statement error
SELECT zn_city, COUNT(*) AS c FROM zones WHERE zn_city IN (1, 2) GROUP BY zn_city ORDER BY (SELECT COUNT(*) FROM cities WHERE ct_id < COUNT(*)), zn_city

statement error GROUP BY clause cannot contain aggregates
SELECT (SELECT COUNT(*) FROM cities WHERE ct_id < MAX(z.zn_city)) AS n FROM zones z GROUP BY n

# Inside a derived table or a CTE body under such a subquery antb1 refuses every aggregate in a WHERE or ON (exit
# 4), as under a HAVING subquery: no binder path reads one there. DuckDB fails one of the derived table's own columns
# with a bind error and answers one of an enclosing block's.

onlyif duckdb
statement error
SELECT zn_city, (SELECT COUNT(*) FROM (SELECT * FROM cities WHERE MAX(ct_id) > 1) d) AS n FROM zones GROUP BY zn_city ORDER BY zn_city

onlyif duckdb
statement error
SELECT ct_id, (SELECT COUNT(*) FROM (SELECT * FROM zones WHERE MAX(zn_id) > 1) d) AS n FROM cities ORDER BY ct_id

onlyif duckdb
statement error
SELECT ct_id FROM cities ORDER BY (SELECT COUNT(*) FROM (SELECT * FROM zones WHERE MAX(zn_id) > 1) d), ct_id

onlyif duckdb
query I nosort
SELECT (SELECT COUNT(*) FROM (SELECT zn_id FROM zones WHERE zn_id < SUM(cities.ct_id)) d) FROM cities
----
BIGINT
20

# The owner holds the subquery in an aggregate's argument, or in its GROUP BY: a bind error in both engines (their
# texts differ).
statement error
SELECT ct_id, (SELECT SUM(z.zn_id * (SELECT COUNT(*) FROM drivers WHERE dv_city < MAX(z.zn_city))) FROM zones z) AS s FROM cities ORDER BY ct_id

statement error
SELECT ct_id, (SELECT COUNT(*) FROM zones z GROUP BY z.zn_city, (SELECT COUNT(*) FROM drivers WHERE dv_city < MAX(z.zn_id)) LIMIT 1) AS s FROM cities ORDER BY ct_id

# ---- divergence D38: a GROUP BY key that holds a subquery, written again otherwise ----

# antb1 matches the select item to the key only where the subquery is written alike, as parsed: another select alias
# inside it, or another case of a name, is another expression, whose column is not grouped. DuckDB ignores both.
onlyif antb1
statement error must appear in the GROUP BY clause
SELECT zn_city + (SELECT MIN(ct_id) AS m FROM cities) AS k, COUNT(*) AS c FROM zones GROUP BY zn_city + (SELECT MIN(ct_id) FROM cities) ORDER BY 1 NULLS FIRST

onlyif duckdb
query II nosort
SELECT zn_city + (SELECT MIN(ct_id) AS m FROM cities) AS k, COUNT(*) AS c FROM zones GROUP BY zn_city + (SELECT MIN(ct_id) FROM cities) ORDER BY 1 NULLS FIRST
