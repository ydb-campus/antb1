# The outer filter excludes the binding whose aggregate argument would overflow.
query I nosort
SELECT (SELECT SUM(i.i32 + 1) FROM edge i WHERE i.i16 = o.i16 AND i.id <= o.id)
FROM (SELECT i16, id FROM edge WHERE id = 2) o
----
HUGEINT
1

# Both binding columns pass through the derived table. Its earlier scalar value is still an output.
query III nosort
SELECT o.id, o.n, (SELECT COUNT(*) FROM edge i WHERE i.i16 = o.k AND i.id <= o.id)
FROM (SELECT p.id, p.i16 AS k, (SELECT MAX(m.id) FROM edge m WHERE m.i16 = p.i16) AS n
      FROM edge p) o
ORDER BY o.id
----
INTEGER	INTEGER	BIGINT
0	0	1
1	1	1
2	2	1
3	3	1
4	4	1
5	NULL	0
6	6	1
7	7	1
8	NULL	0
9	9	1
10	10	1
11	11	1

# The domain keeps a computed cutoff and a projected constant. An unrelated expression reads a mark.
query III nosort
SELECT o.cutoff, o.flag, (SELECT COUNT(*) FROM edge i WHERE i.i16 = o.k AND i.id < o.cutoff AND i.id <= o.cap)
FROM (SELECT p.id + 1 AS cutoff, p.i16 AS k, 2 AS cap,
             CASE WHEN EXISTS (SELECT 1 FROM edge m WHERE m.i16 = p.i16) THEN 1 ELSE 0 END AS flag
      FROM edge p) o
ORDER BY o.cutoff
----
INTEGER	INTEGER	BIGINT
1	1	1
2	1	1
3	1	1
4	1	0
5	1	0
6	0	0
7	1	0
8	1	0
9	0	0
10	1	0
11	1	0
12	1	0

# An unmatched LEFT JOIN supplies a NULL anchor and the preserved row supplies the cutoff.
# Ordinary equality finds no match for that NULL. NULL-safe equality can still count inner rows.
query III nosort
SELECT l.id, (SELECT COUNT(*) FROM edge i WHERE i.i16 = r.i16 AND i.id <= l.id),
       (SELECT COUNT(*) FROM edge i WHERE i.i16 IS NOT DISTINCT FROM r.i16 AND i.id <= l.id)
FROM edge l LEFT JOIN edge r ON r.id = l.id AND r.id = 4
WHERE l.id IN (4, 8, 10)
ORDER BY l.id
----
INTEGER	BIGINT	BIGINT
4	1	1
8	0	2
10	0	2
