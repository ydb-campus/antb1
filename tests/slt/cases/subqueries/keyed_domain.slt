1	1	0	NULL
1	11	2	7
1	16	3	18
1	6	1	1
2	12	2	9
2	2	0	NULL
2	7	1	2
3	13	2	11
3	3	0	NULL
3	8	1	3
4	14	2	13
4	4	0	NULL
4	9	1	4
5	10	1	5
5	15	2	15
5	5	0	NULL

# The inner scan is empty. HAVING can retain the empty count or eliminate the result row.
query III rowsort
SELECT o.id, (SELECT COUNT(*) FROM edge i WHERE i.id < 0 AND i.i16 = o.i16 AND i.id < o.id HAVING COUNT(*) = 0),
       (SELECT COUNT(*) FROM edge i WHERE i.id < 0 AND i.i16 = o.i16 AND i.id < o.id HAVING COUNT(*) > 0)
FROM edge o
----
