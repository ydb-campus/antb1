11	0	NULL
2	0	NULL
3	0	NULL
4	0	NULL
5	0	NULL
6	0	NULL
7	0	NULL
8	0	NULL
9	0	NULL

# The consuming comparison rejects the empty SUM. Both equality anchors must match before aggregating.
query I rowsort
SELECT o.zn_id FROM zones o
WHERE (SELECT SUM(i.zn_id) FROM zones i WHERE i.zn_city = o.zn_city
       AND i.zn_parent IS NOT DISTINCT FROM o.zn_parent AND i.zn_id < o.zn_id) > 0
