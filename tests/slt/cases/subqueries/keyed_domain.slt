# A NULL equality key can match with IS NOT DISTINCT FROM. A NULL cutoff never passes <=.
query III rowsort
SELECT o.i16, o.i32, (SELECT SUM(i.id) FROM edge i
                      WHERE i.i16 IS NOT DISTINCT FROM o.i16 AND o.i32 >= i.i32)
FROM edge o
----
SMALLINT	INTEGER	HUGEINT
-1	-1	3
-100	-100000	7
-12345	54321	10
-32768	-2147483648	0
0	0	2
1	1	4
100	100000	6
12345	NULL	NULL
32767	2147483647	1
7	-7	11
NULL	7	8
NULL	NULL	NULL

# Several cutoffs for the same key. Both scalar values must see the same bindings.
query IIII rowsort
SELECT o.zn_city, o.zn_id,
       (SELECT COUNT(*) FROM zones i WHERE i.zn_city = o.zn_city AND i.zn_id < o.zn_id),
       (SELECT SUM(i.zn_id) FROM zones i WHERE i.zn_city = o.zn_city AND i.zn_id < o.zn_id)
FROM zones o WHERE o.zn_id <= 16
----
