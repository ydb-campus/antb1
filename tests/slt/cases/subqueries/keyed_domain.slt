# Two copies of every binding. Deduplicating only the equality key mixes cutoffs;
# feeding both copies to the aggregate doubles each count. The outer copies must both survive.
query III rowsort
SELECT o.i16, o.i32, (SELECT COUNT(*) FROM edge i WHERE i.i16 = o.i16 AND i.i32 <= o.i32)
FROM (SELECT i16, i32 FROM edge UNION ALL SELECT i16, i32 FROM edge) o
----
SMALLINT	INTEGER	BIGINT
-1	-1	1
-1	-1	1
-100	-100000	1
-100	-100000	1
-12345	54321	1
-12345	54321	1
-32768	-2147483648	1
-32768	-2147483648	1
