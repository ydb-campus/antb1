query I nosort
WITH v AS (SELECT id, id % 3 AS k FROM edge)
SELECT o.id FROM v o WHERE o.id NOT IN (SELECT COALESCE(i.i16, o.k) FROM edge i
WHERE i.id % 3 = o.k) ORDER BY o.id
