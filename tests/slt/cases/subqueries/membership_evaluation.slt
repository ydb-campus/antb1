# Correlated membership: selected values are evaluated only for their bindings.

# IN: outer item over an empty correlated set
query I nosort
SELECT o.k FROM (SELECT ct_id AS k, ct_id + 39999 AS y FROM cities WHERE ct_id = 1) o WHERE 0 IN (SELECT CAST(o.y AS SMALLINT) FROM cities i WHERE i.ct_id = 2 AND i.ct_id = o.k)
----
SMALLINT

# IN: outer item after a false residual
query I nosort
SELECT o.k FROM (SELECT ct_id AS k, ct_id + 39999 AS y FROM cities WHERE ct_id = 1) o WHERE 0 IN (SELECT CAST(o.y AS SMALLINT) FROM cities i WHERE i.ct_id = o.k AND o.y < 0)
----
SMALLINT

# IN: outer item after a NULL residual
query I nosort
SELECT o.k FROM (SELECT ct_id AS k, ct_id + 39999 AS y FROM cities WHERE ct_id = 1) o WHERE 0 IN (SELECT CAST(o.y AS SMALLINT) FROM cities i WHERE i.ct_id = o.k AND o.y = CASE WHEN o.k = 1 THEN NULL ELSE o.y END)
----
SMALLINT

# IN: grouped item over an absent binding
query I nosort
SELECT o.k FROM (SELECT ct_id AS k, ct_id + 39999 AS y FROM cities WHERE ct_id = 1) o WHERE 0 IN (SELECT CAST(MAX(i.ct_id) + 39999 AS SMALLINT) FROM cities i WHERE i.ct_id = 2 AND i.ct_id = o.k GROUP BY i.ct_id)
----
SMALLINT

# IN: group argument over an absent binding
query I nosort
SELECT o.k FROM (SELECT ct_id AS k, ct_id + 39999 AS y FROM cities WHERE ct_id = 1) o WHERE 0 IN (SELECT MAX(CAST(i.ct_id + 39999 AS SMALLINT)) FROM cities i WHERE i.ct_id = 2 AND i.ct_id = o.k GROUP BY i.ct_id)
----
SMALLINT

# IN: grouped item after its correlation filter
query I nosort
SELECT o.k FROM (SELECT ct_id AS k, ct_id + 39999 AS y FROM cities WHERE ct_id = 1) o WHERE 0 IN (SELECT CAST(MAX(i.ct_id) + 39999 AS SMALLINT) FROM cities i WHERE i.ct_id = o.k AND o.k < 0 GROUP BY i.ct_id)
----
SMALLINT

# IN: static aggregate preserves its empty-input NULL
query I nosort
SELECT o.k FROM (SELECT ct_id AS k, ct_id + 39999 AS y FROM cities WHERE ct_id = 1) o WHERE 0 IN (SELECT CAST(MAX(i.ct_id) + 39999 AS SMALLINT) FROM cities i WHERE i.ct_id = 2 AND i.ct_id = o.k)
----
SMALLINT

