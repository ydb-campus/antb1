# Group-domain restriction keeps correlation NULL semantics: =
query I nosort
SELECT o.ct_id FROM (SELECT ct_id, CASE WHEN ct_id = 1 THEN NULL ELSE ct_id END AS k FROM cities WHERE ct_id = 1) o WHERE 10 NOT IN (SELECT CAST(MAX(i.v) AS SMALLINT) FROM (SELECT ct_id, CASE WHEN ct_id = 1 THEN NULL ELSE ct_id END AS k, CASE WHEN ct_id = 1 THEN 10 ELSE 40000 END AS v FROM cities) i WHERE i.k = o.k GROUP BY i.ct_id)
----
SMALLINT
1

# Group-domain restriction keeps correlation NULL semantics: IS NOT DISTINCT FROM
query I nosort
SELECT o.ct_id FROM (SELECT ct_id, CASE WHEN ct_id = 1 THEN NULL ELSE ct_id END AS k FROM cities WHERE ct_id = 1) o WHERE 10 NOT IN (SELECT CAST(MAX(i.v) AS SMALLINT) FROM (SELECT ct_id, CASE WHEN ct_id = 1 THEN NULL ELSE ct_id END AS k, CASE WHEN ct_id = 1 THEN 10 ELSE 40000 END AS v FROM cities) i WHERE i.k IS NOT DISTINCT FROM o.k GROUP BY i.ct_id)
----
SMALLINT

# IN: a matching first item does not hide a later item error
statement error out of range
SELECT o.ct_id FROM cities o WHERE o.ct_id = 1 AND 0 IN (SELECT CAST(CASE WHEN i.ct_id = 1 THEN 0 ELSE 40000 END AS SMALLINT) FROM cities i WHERE i.ct_id // 10000 = o.ct_id // 10000 AND o.ct_id > 0)

# NOT IN: a matching first item does not hide a later item error
statement error out of range
SELECT o.ct_id FROM cities o WHERE o.ct_id = 1 AND 0 NOT IN (SELECT CAST(CASE WHEN i.ct_id = 1 THEN 0 ELSE 40000 END AS SMALLINT) FROM cities i WHERE i.ct_id // 10000 = o.ct_id // 10000 AND o.ct_id > 0)

# IN: DISTINCT item over an absent binding
query I nosort
SELECT o.k FROM (SELECT ct_id AS k FROM cities WHERE ct_id = 1) o WHERE 0 IN (SELECT DISTINCT CAST(i.ct_id + 39999 AS SMALLINT) FROM cities i WHERE i.ct_id = 2 AND i.ct_id = o.k)
----
SMALLINT

# IN: static aggregate argument over an absent binding
query I nosort
SELECT o.k FROM (SELECT ct_id AS k FROM cities WHERE ct_id = 1) o WHERE 0 IN (SELECT MAX(CAST(i.ct_id + 39999 AS SMALLINT)) FROM cities i WHERE i.ct_id = 2 AND i.ct_id = o.k)
----
SMALLINT

# NOT IN: DISTINCT retains eager inner item evaluation
statement error out of range
SELECT o.k FROM (SELECT ct_id AS k FROM cities WHERE ct_id = 1) o WHERE 0 NOT IN (SELECT DISTINCT CAST(i.ct_id + 39999 AS SMALLINT) FROM cities i WHERE i.ct_id = 2 AND i.ct_id = o.k)

# NOT IN: static aggregate argument over an absent binding
query I nosort
