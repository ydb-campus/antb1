# One correlation bucket with disjoint membership values: no candidate-pair scan.
query I nosort
SELECT COUNT(*) FROM riders o WHERE o.rd_row NOT IN (SELECT i.rd_row + 10000 FROM riders i WHERE i.rd_row // 10000 = o.rd_row // 10000)
----
BIGINT
240

# IN: inner selected expression after a false correlation residual
query I nosort
SELECT o.k FROM (SELECT ct_id AS k, ct_id + 39999 AS y FROM cities WHERE ct_id = 1) o WHERE 0 IN (SELECT CAST(i.ct_id + 39999 AS SMALLINT) FROM cities i WHERE i.ct_id = o.k AND o.y < 0)
----
SMALLINT

# IN: inner selected expression after a NULL correlation residual
query I nosort
SELECT o.k FROM (SELECT ct_id AS k, ct_id + 39999 AS y FROM cities WHERE ct_id = 1) o WHERE 0 IN (SELECT CAST(i.ct_id + 39999 AS SMALLINT) FROM cities i WHERE i.ct_id = o.k AND o.y = CASE WHEN o.k = 1 THEN NULL ELSE o.y END)
----
SMALLINT

