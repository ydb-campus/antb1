# One correlation bucket with disjoint membership values: no candidate-pair scan.
query I nosort
SELECT COUNT(*) FROM riders o WHERE o.rd_row NOT IN (SELECT i.rd_row + 10000 FROM riders i WHERE i.rd_row // 10000 = o.rd_row // 10000)
----
BIGINT
240

