query I nosort
SELECT o.k FROM (SELECT ct_id AS k, ct_id + 39999 AS y FROM cities WHERE ct_id = 1) o WHERE 0 NOT IN (SELECT CAST(i.ct_id + 39999 AS SMALLINT) FROM cities i WHERE i.ct_id = o.k AND o.y < 0)
