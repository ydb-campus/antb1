# All three values compare in DuckDB's common type: with a DOUBLE bound the operand's sum is computed as written (DuckDB
# keeps its cast to DOUBLE) and overflows; with an INTEGER bound the constant moves and nothing overflows.
statement error Overflow in addition
SELECT id FROM edge WHERE i32 + 1 BETWEEN (SELECT MIN(d) FROM edge) AND 100

query I nosort
SELECT id FROM edge WHERE i32 + 1 BETWEEN (SELECT MIN(i32) FROM edge) AND 100 ORDER BY id
----
INTEGER
0
2
3
4
7
8
11

# ---- divergence D35: errors of subqueries next to a join that turns out empty ----

# The IN written after the failing subquery: antb1 prepares the IN's build first, finds it empty and never builds the
# subquery's; DuckDB builds both.
onlyif antb1
query I nosort
SELECT COUNT(*) FROM cities WHERE ct_id = (SELECT zn_city FROM zones) AND ct_id IN (SELECT pm_id FROM promos)
----
BIGINT
0

onlyif duckdb
statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*) FROM cities WHERE ct_id = (SELECT zn_city FROM zones) AND ct_id IN (SELECT pm_id FROM promos)

# The IN written first: both fail.
statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*) FROM cities WHERE ct_id IN (SELECT pm_id FROM promos) AND ct_id = (SELECT zn_city FROM zones)

# A condition that never holds: DuckDB's filter combiner removes the block's plan, the subquery with it; antb1 fails.
onlyif antb1
statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*) FROM cities WHERE ct_id = 1 AND ct_id = 2 AND ct_id = (SELECT zn_city FROM zones)

onlyif duckdb
query I nosort
SELECT COUNT(*) FROM cities WHERE ct_id = 1 AND ct_id = 2 AND ct_id = (SELECT zn_city FROM zones)
----
BIGINT
0

# A WHERE subquery under a HAVING IN that turns out empty.
onlyif antb1
query II nosort
SELECT zn_city, COUNT(*) FROM zones WHERE zn_id = (SELECT zn_id FROM zones WHERE zn_city = 1) GROUP BY zn_city HAVING COUNT(*) IN (SELECT pm_id FROM promos) ORDER BY zn_city
----
SMALLINT	BIGINT

onlyif duckdb
statement error More than one row returned by a subquery used as an expression
SELECT zn_city, COUNT(*) FROM zones WHERE zn_id = (SELECT zn_id FROM zones WHERE zn_city = 1) GROUP BY zn_city HAVING COUNT(*) IN (SELECT pm_id FROM promos) ORDER BY zn_city

# An uncorrelated EXISTS that is false empties no join (its count is one row), so both fail.
statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*) FROM cities WHERE ct_id = (SELECT zn_city FROM zones) AND EXISTS (SELECT * FROM promos)
