# ---- a correlated EXISTS in CASE, COALESCE and IN lists in WHERE (ADR 0041's SQ8a) ----

# CASE WHEN E compared with a constant. DuckDB: 4, 5, 6.
pending SQ8a
query I nosort
SELECT c.ct_id FROM cities c
WHERE CASE WHEN EXISTS (SELECT * FROM riders r WHERE r.rd_city = c.ct_id) THEN 1 ELSE 0 END = 0 ORDER BY 1
----
SMALLINT
4
5
6

# CASE WHEN NOT E whose THEN reads the outer row. DuckDB: 5.
pending SQ8a
query I nosort
SELECT c.ct_id FROM cities c
WHERE CASE WHEN NOT EXISTS (SELECT * FROM drivers d WHERE d.dv_city = c.ct_id) THEN c.ct_pop ELSE 0 END > 5000
ORDER BY 1
----
SMALLINT
5

# The mark in a second WHEN, after one that reads the outer row. DuckDB: 1, 2, 3, 4.
pending SQ8a
query I nosort
SELECT c.ct_id FROM cities c
WHERE CASE WHEN c.ct_pop IS NULL THEN 2 WHEN EXISTS (SELECT * FROM riders r WHERE r.rd_city = c.ct_id) THEN 1
ELSE 0 END > 0 ORDER BY 1
----
SMALLINT
1
2
3
4

# Two-valued: WHEN E and WHEN NOT E cover every row, NULL keys too, so ELSE 2 never wins. DuckDB: the 8 riders
# without a city (14, 43, 72, 101, 130, 159, 188, 217).
pending SQ8a
query I nosort
SELECT r.rd_id FROM riders r
WHERE CASE WHEN EXISTS (SELECT * FROM drivers d WHERE d.dv_city = r.rd_city) THEN 1
WHEN NOT EXISTS (SELECT * FROM drivers d WHERE d.dv_city = r.rd_city) THEN 0 ELSE 2 END = 0 ORDER BY 1
----
BIGINT
14
43
72
101
130
159
188
217

# A nested CASE, the inner block selecting a constant. DuckDB: 4.
pending SQ8a
query I nosort
SELECT c.ct_id FROM cities c
WHERE CASE WHEN EXISTS (SELECT * FROM drivers d WHERE d.dv_city = c.ct_id)
THEN CASE WHEN EXISTS (SELECT 1 FROM riders r WHERE r.rd_city = c.ct_id) THEN 2 ELSE 1 END ELSE 0 END = 1 ORDER BY 1
----
SMALLINT
4

# Under COALESCE: the CASE is NULL where E is FALSE and for city 4's NULL ct_pop; then the mark fills city 4's NULL.
# DuckDB: 1, 2, 4, 5, 6; 4.
pending SQ8a
query I nosort
SELECT c.ct_id FROM cities c
WHERE COALESCE(CASE WHEN EXISTS (SELECT * FROM drivers d WHERE d.dv_city = c.ct_id) THEN c.ct_pop END, 50000) > 40000
ORDER BY 1
----
SMALLINT
1
2
4
5
6

pending SQ8a
query I nosort
SELECT c.ct_id FROM cities c
WHERE COALESCE(c.ct_pop, CASE WHEN EXISTS (SELECT * FROM drivers d WHERE d.dv_city = c.ct_id) THEN 1 ELSE 0 END) = 1
ORDER BY 1
----
SMALLINT
4

