AND (z.zn_id > 35 OR EXISTS (SELECT * FROM riders r WHERE r.rd_city = c.ct_id AND r.rd_tier = 'gold'))
LEFT JOIN drivers d ON d.dv_city = c.ct_id AND d.dv_row < 3 GROUP BY 1 ORDER BY 1
