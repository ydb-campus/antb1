SELECT COUNT(*), SUM(r.rd_row) FROM riders r
WHERE EXISTS (SELECT * FROM trips t WHERE t.tr_rider = r.rd_id AND t.tr_tariff = 'NIGHT')
OR EXISTS (SELECT * FROM trips t WHERE t.tr_rider = r.rd_id AND t.tr_tariff = 'NIGHT')
