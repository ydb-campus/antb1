query I nosort
SELECT c.ct_id FROM cities c WHERE EXISTS (SELECT * FROM drivers d WHERE d.dv_city = c.ct_id)
AND (NOT EXISTS (SELECT * FROM riders r WHERE r.rd_city = c.ct_id) OR c.ct_id = 1) ORDER BY 1
