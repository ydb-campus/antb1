query I nosort
SELECT c.ct_id FROM cities c
WHERE (EXISTS (SELECT * FROM riders r WHERE r.rd_city = c.ct_id) AND c.ct_pop > 40000)
OR (EXISTS (SELECT * FROM drivers d WHERE d.dv_city = c.ct_id) AND c.ct_id > 3) ORDER BY 1
----
SMALLINT
1
2
4

# One block in both branches, once under NOT: neither branch holds for city 4 (NULL ct_pop). DuckDB: 3, 5.
pending SQ8a
query I nosort
SELECT c.ct_id FROM cities c
WHERE (EXISTS (SELECT * FROM drivers d WHERE d.dv_city = c.ct_id) AND c.ct_pop < 40000)
OR (NOT EXISTS (SELECT * FROM drivers d WHERE d.dv_city = c.ct_id) AND c.ct_pop > 5000) ORDER BY 1
----
SMALLINT
3
5

# A top-level EXISTS conjunct (a semi join) beside a mark in another conjunct. DuckDB: 1, 4.
