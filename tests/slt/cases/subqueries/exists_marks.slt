# ---- a top-level EXISTS beside an OR of two more, each over a join of two tables ----

# Riders with a trip in week 9 (89 riders), and with a trip in week 14 that cost more than 20 (54) or a booking in weeks
# 60 to 62 (37): of the 89, 13 have only the second, 12 only the third and 2 both. The trips join the calendar with ON,
# the bookings with a comma; each block is correlated through the rider's key alone.

# The three as top-level conjuncts, three semi joins, no mark. DuckDB: (gold, 1, 154), (plus, 1, 189).
query TII nosort
SELECT r.rd_tier, COUNT(*) AS n, SUM(r.rd_row) AS s FROM riders r
WHERE EXISTS (SELECT * FROM trips t JOIN days d ON d.dy_day = t.tr_day WHERE t.tr_rider = r.rd_id AND d.dy_week = 9)
AND EXISTS (SELECT * FROM trips t JOIN days d ON d.dy_day = t.tr_day
WHERE t.tr_rider = r.rd_id AND d.dy_week = 14 AND t.tr_fare > 20)
AND EXISTS (SELECT * FROM bookings b, days d WHERE d.dy_day = b.bk_day AND b.bk_rider = r.rd_id
AND d.dy_week BETWEEN 60 AND 62)
GROUP BY r.rd_tier ORDER BY 1
----
VARCHAR	BIGINT	HUGEINT
gold	1	154
plus	1	189

