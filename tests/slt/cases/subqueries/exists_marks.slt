# ---- the order of a bind error and a mark (ADR 0041's SQ8a) ----

# A bind error that binds before the mark: in an earlier WHERE conjunct, and in WHERE under a select item's CASE, which
# binds after WHERE. Main reports it already. DuckDB: the bind error, both.
statement error nope
SELECT c.ct_id FROM cities c
WHERE nope > 0 AND (c.ct_id = 6 OR EXISTS (SELECT * FROM riders r WHERE r.rd_city = c.ct_id)) ORDER BY 1

statement error nope
SELECT c.ct_id, CASE WHEN EXISTS (SELECT * FROM riders r WHERE r.rd_city = c.ct_id) THEN 1 ELSE 0 END AS m
FROM cities c WHERE nope > 0 ORDER BY 1

# A bind error that binds after the mark: main refuses the mark first, and once SQ8a binds it both engines report the
