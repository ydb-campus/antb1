# Correlated EXISTS as a two-valued mark (ADR 0041's SQ8a) over the star schema: TRUE where its block has a row that
# passes its keys and its other conjuncts, else FALSE, never NULL. Under OR, NOT and CASE in WHERE and in inner ONs; in
# select items, ORDER BY, GROUP BY keys and aggregate arguments; its residuals and keys (NULL-equal ones, NULL outer
# and inner keys, empty and all-NULL inner sides); a top-level EXISTS beside an OR of two more; one EXISTS as a semi
# join, an anti join and a mark (the memo and the order); marks nested in other blocks; the shapes of a mark's block;
# the divergences a mark takes part in (D16, D23, D35); and the boundaries SQ8a keeps. Each record pending SQ8a exits 4
# on main with "a correlated EXISTS is supported only as a top-level conjunct of WHERE or an inner ON".

# ---- the inputs, one table at a time ----

# 80 riders per tier, 78 distinct keys in each. DuckDB: (basic, 80, 78, 9400), (gold, 80, 78, 9720), (plus, 80, 78,
# 9560).
query TIII nosort
SELECT rd_tier, COUNT(*), COUNT(DISTINCT rd_id), SUM(rd_row) FROM riders GROUP BY rd_tier ORDER BY 1
----
VARCHAR	BIGINT	BIGINT	HUGEINT
basic	80	78	9400
gold	80	78	9720
plus	80	78	9560

# The calendar: 52 weeks a year. DuckDB: (2026, 364, 1, 52), (2027, 364, 53, 104), (2028, 364, 105, 156), (2029, 364,
# 157, 208).
query IIII nosort
SELECT dy_year, COUNT(*), MIN(dy_week), MAX(dy_week) FROM days GROUP BY dy_year ORDER BY 1
----
SMALLINT	BIGINT	INTEGER	INTEGER
2026	364	1	52
2027	364	53	104
2028	364	105	156
2029	364	157	208

# The trips fall in weeks 9 to 14 of 2026, the bookings in 2027 and 2028. DuckDB: (3000, 2869, 243, 2026-03-01,
# 2026-03-31); (1800, 1721, 236, 2026-12-28, 2028-12-24).
query IIITT nosort
SELECT COUNT(*), COUNT(tr_rider), COUNT(DISTINCT tr_rider), MIN(tr_day), MAX(tr_day) FROM trips
----
BIGINT	BIGINT	BIGINT	DATE	DATE
3000	2869	243	2026-03-01	2026-03-31

query IIITT nosort
SELECT COUNT(*), COUNT(bk_rider), COUNT(DISTINCT bk_rider), MIN(bk_day), MAX(bk_day) FROM bookings
----
BIGINT	BIGINT	BIGINT	DATE	DATE
1800	1721	236	2026-12-28	2028-12-24

# The NIGHT trips. DuckDB: (284, 119, 274).
query III nosort
SELECT COUNT(*), COUNT(DISTINCT tr_rider), COUNT(tr_fare) FROM trips WHERE tr_tariff = 'NIGHT'
----
BIGINT	BIGINT	BIGINT
284	119	274

# ---- a correlated EXISTS under OR in WHERE (ADR 0041's SQ8a) ----

# E OR p: cities 1 to 3 have riders, 4 to 6 none. DuckDB: 1, 2, 3, 6.
pending SQ8a
query I nosort
SELECT c.ct_id FROM cities c WHERE EXISTS (SELECT * FROM riders r WHERE r.rd_city = c.ct_id) OR c.ct_id = 6
ORDER BY 1
----
SMALLINT
1
2
3
6

# p OR E, the key written outer = inner: drivers in cities 1 to 4. DuckDB: 1 to 5.
pending SQ8a
query I nosort
SELECT c.ct_id FROM cities c WHERE c.ct_id = 5 OR EXISTS (SELECT * FROM drivers d WHERE c.ct_id = d.dv_city)
ORDER BY 1
----
SMALLINT
1
2
3
4
5

# NOT E under OR, with unqualified names. DuckDB: 1, 4, 5, 6.
pending SQ8a
query I nosort
SELECT ct_id FROM cities WHERE NOT EXISTS (SELECT * FROM riders WHERE rd_city = ct_id) OR ct_id = 1 ORDER BY 1
----
SMALLINT
1
4
5
6

# The other branch is NULL for city 4 (ct_pop): FALSE OR NULL drops the city (no riders), TRUE OR NULL keeps it
# (drivers). DuckDB: 1, 2, 3, 6; then 1, 2, 3, 4, 6.
pending SQ8a
query I nosort
SELECT c.ct_id FROM cities c WHERE EXISTS (SELECT * FROM riders r WHERE r.rd_city = c.ct_id) OR c.ct_pop < 5000
ORDER BY 1
----
SMALLINT
1
2
3
6

pending SQ8a
query I nosort
SELECT c.ct_id FROM cities c WHERE EXISTS (SELECT * FROM drivers d WHERE d.dv_city = c.ct_id) OR c.ct_pop < 5000
ORDER BY 1
----
SMALLINT
1
2
3
4
6

# Over 3000 trips: each trip counts once, although riders 47 and 167 have two gold rows each, and the 60 trips over
# 27 pass both ways. DuckDB: 950 trips (row sum 1418377); 2110 trips (row sum 3168226).
pending SQ8a
query II nosort
SELECT COUNT(*), SUM(t.tr_row) FROM trips t
WHERE EXISTS (SELECT * FROM riders r WHERE r.rd_id = t.tr_rider AND r.rd_tier = 'gold') OR t.tr_fare > 27
----
BIGINT	HUGEINT
950	1418377

pending SQ8a
query II nosort
SELECT COUNT(*), SUM(t.tr_row) FROM trips t
WHERE NOT EXISTS (SELECT * FROM riders r WHERE r.rd_id = t.tr_rider AND r.rd_tier = 'gold') OR t.tr_fare > 27
----
BIGINT	HUGEINT
2110	3168226

# Two marks under one OR, one block selecting a column: basic riders in cities 1 and 2, drivers who started after
# 2025-12-07 in cities 2 to 4. DuckDB: 1, 2, 3, 4.
pending SQ8a
query I nosort
SELECT c.ct_id FROM cities c
WHERE EXISTS (SELECT * FROM riders r WHERE r.rd_city = c.ct_id AND r.rd_tier = 'basic')
OR EXISTS (SELECT d.dv_id FROM drivers d WHERE d.dv_city = c.ct_id AND d.dv_since > DATE '2025-12-07') ORDER BY 1
----
SMALLINT
1
2
3
4

# Three under one OR, the third a NOT EXISTS over the trips of the zone itself. DuckDB: 33 zones, 1 to 37.
pending SQ8a
query III nosort
SELECT COUNT(*), MIN(z.zn_id), MAX(z.zn_id) FROM zones z
WHERE EXISTS (SELECT * FROM riders r WHERE r.rd_city = z.zn_city AND r.rd_tier = 'gold')
OR EXISTS (SELECT * FROM drivers d WHERE d.dv_city = z.zn_city AND d.dv_since < DATE '2025-01-09')
OR NOT EXISTS (SELECT * FROM trips t WHERE t.tr_pickup = z.zn_id AND t.tr_fare > 27)
----
BIGINT	INTEGER	INTEGER
33	1	37

# AND branches with nothing in common, so no semi join can be pulled out of the OR. DuckDB: 1, 2, 4.
