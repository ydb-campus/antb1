# SQ8b: correlated EXISTS blocks, including NULL keys, empty inputs and repeated bindings.

# Hash large results while keeping small boundary-case answers readable.
# The digest checks every value and its order; result types are checked separately.
hash-threshold 16

# groups; =; EXISTS, including NULL and repeated outer keys.
query I nosort
SELECT c.rd_row FROM riders c WHERE EXISTS (SELECT r.rd_tier FROM riders r WHERE r.rd_city = c.rd_city GROUP BY r.rd_tier) ORDER BY 1
----
INTEGER
232 values hashing to 68d00196d2ca1a2b8f50bea2b86a923ad71cff1e87619c9de563d2a716eb0ece

# groups; =; NOT EXISTS, including NULL and repeated outer keys.
query I nosort
SELECT c.rd_row FROM riders c WHERE NOT EXISTS (SELECT r.rd_tier FROM riders r WHERE r.rd_city = c.rd_city GROUP BY r.rd_tier) ORDER BY 1
----
INTEGER
13
42
71
100
129
158
187
216

query IT nosort
SELECT c.rd_row, CASE WHEN EXISTS (SELECT r.rd_tier FROM riders r WHERE r.rd_city = c.rd_city GROUP BY r.rd_tier) THEN 'yes' ELSE 'no' END AS flag FROM riders c ORDER BY 1
----
INTEGER	VARCHAR
480 values hashing to 1379d7b6da288d252d51c190d2b73ffc1d9a0e25e5e04ced2196517dc3c84867

# having; =; EXISTS, including NULL and repeated outer keys.
query I nosort
