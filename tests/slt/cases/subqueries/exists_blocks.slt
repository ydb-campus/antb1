# A grouped aggregate over no rows has no group, unlike a static aggregate.
query I nosort
SELECT c.ct_id FROM cities c WHERE EXISTS (SELECT r.rd_tier FROM riders r WHERE r.rd_city = c.ct_id AND r.rd_city > 0 GROUP BY r.rd_tier HAVING COUNT(*) = 0) ORDER BY 1
----
SMALLINT

# Empty input under DISTINCT and OFFSET.
query I nosort
SELECT c.ct_id FROM cities c WHERE NOT EXISTS (SELECT DISTINCT r.rd_tier FROM riders r WHERE r.rd_city = c.ct_id AND r.rd_row < 0 OFFSET 1) ORDER BY 1
----
SMALLINT
1
2
3
4
5
6

# A positive limit keeps the plain residual-correlation path.
query I nosort
SELECT c.ct_id FROM cities c WHERE EXISTS (SELECT 1 FROM riders r WHERE r.rd_city = c.ct_id AND r.rd_row < c.ct_pop LIMIT 1) ORDER BY 1
----
SMALLINT
1
2
3

# Two outer columns share one representative.
query I nosort
SELECT c.ct_id FROM cities c JOIN cities d ON d.ct_id = c.ct_id WHERE EXISTS (SELECT r.rd_tier FROM riders r WHERE r.rd_city = c.ct_id AND r.rd_city = d.ct_id GROUP BY r.rd_tier OFFSET 1) ORDER BY 1
----
SMALLINT
1
2
3

# An uncorrelated value in grouped HAVING.
query I nosort
SELECT c.ct_id FROM cities c WHERE EXISTS (SELECT r.rd_tier FROM riders r WHERE r.rd_city = c.ct_id GROUP BY r.rd_tier HAVING COUNT(*) > (SELECT COUNT(*) FROM promos)) ORDER BY 1
----
SMALLINT
1
2
3

