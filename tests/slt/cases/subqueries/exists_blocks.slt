BIGINT
3


# Combined grouping, DISTINCT, ordering and limits.
query I nosort
SELECT COUNT(*) FROM cities c WHERE EXISTS (SELECT DISTINCT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id HAVING COUNT(*) = 0 OFFSET 1)
----
BIGINT
0


# Combined grouping, DISTINCT, ordering and limits.
query I nosort
SELECT COUNT(*) FROM cities c WHERE EXISTS (SELECT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id ORDER BY 1 LIMIT 1)
----
BIGINT
6


# Combined grouping, DISTINCT, ordering and limits.
query I nosort
SELECT COUNT(*) FROM cities c WHERE EXISTS (SELECT DISTINCT COUNT(*) FROM riders r WHERE r.rd_city = c.ct_id GROUP BY r.rd_tier HAVING COUNT(*) > 1 OFFSET 1)
----
BIGINT
2


# Combined grouping, DISTINCT, ordering and limits.
query I nosort
SELECT COUNT(*) FROM cities c WHERE EXISTS (SELECT DISTINCT r.rd_tier FROM riders r WHERE r.rd_city = c.ct_id GROUP BY r.rd_tier HAVING COUNT(*) > 1 LIMIT 1 OFFSET 1)
----
BIGINT
3


