query I nosort
SELECT ct_id FROM cities WHERE NOT (NOT EXISTS (SELECT 1 FROM zones WHERE zn_id = 1)) ORDER BY ct_id
----
SMALLINT
1
2
3
4
5
6

query I nosort
SELECT ct_id FROM cities WHERE NOT NOT EXISTS (SELECT 1 FROM zones WHERE zn_id > 1000) ORDER BY ct_id
