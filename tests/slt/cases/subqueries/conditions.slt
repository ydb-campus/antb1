# CASE WHEN EXISTS, true and false, and CASE WHEN NOT EXISTS over an empty table.
query I nosort
SELECT ct_id FROM cities WHERE CASE WHEN EXISTS (SELECT 1 FROM zones WHERE zn_id = 1) THEN ct_pop ELSE ct_id END > 40000 ORDER BY ct_id
----
SMALLINT
1
2

query I nosort
SELECT ct_id FROM cities WHERE CASE WHEN EXISTS (SELECT 1 FROM zones WHERE zn_id > 1000) THEN 0 ELSE ct_id END > 4 ORDER BY ct_id
----
SMALLINT
5
6

query I nosort
SELECT ct_id FROM cities WHERE CASE WHEN NOT EXISTS (SELECT 1 FROM promos) THEN ct_id ELSE 0 END > 3 ORDER BY ct_id
