SELECT ct_id FROM cities WHERE ct_id = 1 OR ct_id > (SELECT zn_city FROM zones) GROUP BY ct_id HAVING COUNT(*) IN (SELECT pm_id FROM promos) ORDER BY ct_id

statement error More than one row returned by a subquery used as an expression
SELECT ct_id FROM cities WHERE ct_id = 1 OR ct_id > (SELECT zn_city FROM zones) GROUP BY ct_id HAVING COUNT(*) IN (SELECT zn_city FROM zones) ORDER BY ct_id

# ---- divergence D35: a value under OR next to a condition that never holds ----

# DuckDB's filter combiner proves ct_id = 1 AND ct_id = 2 never true and removes the block's plan, the value with it;
# antb1 has no filter combiner (D34) and fails. A condition that never holds by the data alone removes nothing in
# either engine: both fail.
onlyif antb1
statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*) FROM cities WHERE ct_id = 1 AND ct_id = 2 AND (ct_id = 3 OR ct_id > (SELECT zn_city FROM zones))

onlyif duckdb
query I rowsort
SELECT COUNT(*) FROM cities WHERE ct_id = 1 AND ct_id = 2 AND (ct_id = 3 OR ct_id > (SELECT zn_city FROM zones))
----
BIGINT
0

statement error More than one row returned by a subquery used as an expression
SELECT COUNT(*) FROM cities WHERE ct_id = 1 AND ct_pop = 45000 AND (ct_id = 3 OR ct_id > (SELECT zn_city FROM zones))

# ---- divergence D14: a comparison over a value folded to never-true ----

# A value's SMALLINT sum against a literal outside SMALLINT's range is a whole conjunct that antb1 folds to never-true
# at bind time, so it computes no sum; DuckDB computes 32767 + 1 in SMALLINT and fails. The value's join still builds
# below the folded filter, so a value of two rows fails in both.
onlyif antb1
query I nosort
SELECT id FROM edge WHERE (SELECT i16 FROM edge WHERE id = 1) + 1 > 40000 ORDER BY id
----
INTEGER

onlyif duckdb
statement error Overflow in addition of
SELECT id FROM edge WHERE (SELECT i16 FROM edge WHERE id = 1) + 1 > 40000 ORDER BY id

statement error More than one row returned by a subquery used as an expression
SELECT id FROM edge WHERE (SELECT i16 FROM edge WHERE id <= 2) + 1 > 40000 ORDER BY id

# ---- pending: values in select lists and aggregate arguments (ADR 0041; roadmap PR SQ2 removes these guards) ----

# A value in the select list, added to a column on every row: NULL where the column is NULL.
pending SQ2
query II nosort
SELECT ct_id, (SELECT zn_parent FROM zones WHERE zn_id = 10) + ct_pop FROM cities ORDER BY ct_id
----
SMALLINT	INTEGER
1	120005
2	45005
3	30005
4	NULL
5	8005
6	2505

# A value in an aggregate's argument, in a block whose WHERE holds a value of its own: one in an IN list, which SQ1
# answers.
pending SQ2
query II nosort
SELECT zn_city, SUM(zn_id * (SELECT zn_parent FROM zones WHERE zn_id = 10)) FROM zones WHERE zn_city IN (1, (SELECT ct_id FROM cities WHERE label = 'harbor')) GROUP BY zn_city ORDER BY zn_city
----
SMALLINT	HUGEINT
1	740
2	780

# ---- pending: IN, NOT IN, = ANY and <> ALL in any condition (ADR 0041; roadmap PR SQ7 removes these guards) ----

# The set holds 1, 2, 5, 9 and a NULL, so IN is true for cities 1, 2 and 5 and NULL for the others, and NOT IN is
# never true: IN under OR, NOT NOT over IN, IN in a CASE WHEN (whose ELSE takes the NULLs), NOT IN under OR.
pending SQ7
query I nosort
SELECT ct_id FROM cities WHERE ct_id IN (SELECT zn_city FROM zones WHERE zn_id > 35) OR ct_id = 6 ORDER BY ct_id
----
SMALLINT
1
2
5
6

pending SQ7
query I nosort
SELECT ct_id FROM cities WHERE NOT (NOT (ct_id IN (SELECT zn_city FROM zones WHERE zn_id > 35))) ORDER BY ct_id
----
SMALLINT
1
2
5

pending SQ7
query I nosort
SELECT ct_id FROM cities WHERE CASE WHEN ct_id IN (SELECT zn_city FROM zones WHERE zn_id > 35) THEN 1 ELSE 0 END = 0 ORDER BY ct_id
----
SMALLINT
3
4
6

pending SQ7
query I nosort
SELECT ct_id FROM cities WHERE ct_id NOT IN (SELECT zn_city FROM zones WHERE zn_id > 35) OR ct_id = 6 ORDER BY ct_id
----
SMALLINT
6

# = ANY is IN, and <> ALL over the same set without its NULL is NOT IN.
pending SQ7
query I nosort
SELECT ct_id FROM cities WHERE ct_id = ANY (SELECT zn_city FROM zones WHERE zn_id > 35) ORDER BY ct_id
----
SMALLINT
1
2
5

pending SQ7
query I nosort
SELECT ct_id FROM cities WHERE ct_id <> ALL (SELECT zn_city FROM zones WHERE zn_id > 35 AND zn_city IS NOT NULL) ORDER BY ct_id
----
SMALLINT
3
4
6

# An IN that every branch of an OR shares, which OR factoring would make a conjunct; city 6's IN is NULL.
pending SQ7
query I nosort
SELECT ct_id FROM cities WHERE (ct_pop > 40000 AND ct_id IN (SELECT zn_city FROM zones WHERE zn_id > 35)) OR (ct_pop < 10000 AND ct_id IN (SELECT zn_city FROM zones WHERE zn_id > 35)) ORDER BY ct_id
----
SMALLINT
1
2
5

# A probe that reads no column: a value (zone 7's city, 2) and a literal.
pending SQ7
query I nosort
SELECT ct_id FROM cities WHERE (SELECT zn_city FROM zones WHERE zn_id = 7) IN (SELECT zn_city FROM zones WHERE zn_id > 35) AND ct_id < 3 ORDER BY ct_id
----
SMALLINT
1
2

pending SQ7
query I nosort
SELECT ct_id FROM cities WHERE 2 IN (SELECT zn_city FROM zones WHERE zn_id > 35) AND ct_id = 1 ORDER BY ct_id
----
SMALLINT
1

# ---- pending: a correlated value outside a top-level comparison (ADR 0041; roadmap PR SQ5 removes these guards) ----

# A correlated MAX in arithmetic; under OR, where city 5 passes by its comparison and city 6, which has no zone and so a
# NULL MAX, by the other branch; and in a COALESCE, which turns city 6's NULL into 0 and keeps the row.
pending SQ5
query I nosort
SELECT ct_id FROM cities WHERE ct_pop > (SELECT MAX(zn_id) FROM zones WHERE zn_city = ct_id) * 1000 ORDER BY ct_id
----
SMALLINT
1
2

pending SQ5
query I nosort
SELECT ct_id FROM cities WHERE ct_id < (SELECT MAX(zn_parent) FROM zones WHERE zn_city = ct_id) OR ct_id = 6 ORDER BY ct_id
----
SMALLINT
5
6

pending SQ5
query I nosort
SELECT ct_id FROM cities WHERE COALESCE((SELECT MAX(zn_id) FROM zones WHERE zn_city = ct_id), 0) < ct_id * 10 ORDER BY ct_id
----
SMALLINT
4
5
6

# Two correlated aggregates compared: one dependent join each.
pending SQ5
query I nosort
SELECT c.ct_id FROM cities c WHERE (SELECT MAX(z.zn_id) FROM zones z WHERE z.zn_city = c.ct_id) > (SELECT MIN(d.dv_city) * 10 FROM drivers d WHERE d.dv_city = c.ct_id) ORDER BY 1
----
SMALLINT
1
2
3

# ---- DuckDB only until the general domain join gets a PR (ADR 0023: a correlation of two types exits 4) ----

# A value keys a correlated block as an inner equivalent only where it is the outer column's type: an INTEGER value
# against the SMALLINT ct_id, and an expression over a value, have none.
onlyif duckdb
query I nosort
SELECT ct_id FROM cities c WHERE ct_pop > (SELECT SUM(zn_id) FROM zones z WHERE (SELECT MIN(zn_id) FROM zones) = c.ct_id) ORDER BY ct_id
----
SMALLINT
1

onlyif duckdb
query I nosort
SELECT ct_id FROM cities c WHERE ct_pop > (SELECT SUM(zn_id) FROM zones z WHERE (SELECT MIN(zn_city) FROM zones) + 0 = c.ct_id) ORDER BY ct_id
----
SMALLINT
1

# ---- DuckDB only until subqueries in a LEFT JOIN's ON get a PR (ADR 0041's decision 3: DuckDB coverage) ----

# DuckDB answers a subquery in a LEFT JOIN's ON in a conjunct that reads the right input alone: a value (a COUNT over
# no row: 0), an IN whose set holds a NULL, and an EXISTS under OR with a column of that input. A city whose zone fails
# them is padded.
onlyif duckdb
query II nosort
SELECT ct_id, zn_id FROM cities LEFT JOIN zones ON zn_id = ct_id AND zn_parent >= (SELECT COUNT(*) FROM promos) ORDER BY ct_id
----
SMALLINT	INTEGER
1	NULL
2	NULL
3	NULL
4	NULL
5	NULL
6	6

onlyif duckdb
query II nosort
SELECT ct_id, zn_id FROM cities LEFT JOIN zones ON zn_id = ct_id AND zn_city IN (SELECT zn_city FROM zones WHERE zn_id > 36) ORDER BY ct_id
----
SMALLINT	INTEGER
1	NULL
2	2
3	NULL
4	NULL
5	5
6	NULL

onlyif duckdb
query II nosort
SELECT ct_id, zn_id FROM cities LEFT JOIN zones ON zn_id = ct_id AND (zn_city > 3 OR EXISTS (SELECT 1 FROM promos)) ORDER BY ct_id
----
SMALLINT	INTEGER
1	NULL
2	NULL
3	NULL
4	4
5	5
6	NULL

# ---- DuckDB only, for good: DuckDB's refusals of subqueries in a FULL JOIN's or a LEFT JOIN's ON ----

# DuckDB refuses any subquery in a FULL JOIN's ON, and one in a LEFT JOIN's ON whose conjunct reads the left input or
# no column. antb1 refuses them too (exit code 4), and an Unsupported answer passes no record. In a FULL JOIN's ON a
# value directly compared and the same value in arithmetic; in a LEFT JOIN's ON an uncorrelated EXISTS alone and a
# value compared with a column of the left input.
onlyif duckdb
statement error ^Not implemented Error: Cannot perform non-inner join on subquery
SELECT ct_id, zn_id FROM cities FULL JOIN zones ON zn_id = ct_id AND zn_parent >= (SELECT COUNT(*) FROM promos) ORDER BY ct_id, zn_id

onlyif duckdb
statement error ^Not implemented Error: Cannot perform non-inner join on subquery
SELECT ct_id, zn_id FROM cities FULL JOIN zones ON zn_id = ct_id AND zn_parent >= (SELECT COUNT(*) FROM promos) + 1 ORDER BY ct_id, zn_id

onlyif duckdb
statement error ^Not implemented Error: Cannot perform non-inner join on subquery
SELECT ct_id, zn_id FROM cities LEFT JOIN zones ON zn_id = ct_id AND EXISTS (SELECT * FROM promos) ORDER BY ct_id

onlyif duckdb
statement error ^Not implemented Error: Cannot perform non-inner join on subquery
SELECT ct_id, zn_id FROM cities LEFT JOIN zones ON zn_id = ct_id AND ct_pop >= (SELECT COUNT(*) FROM promos) ORDER BY ct_id
