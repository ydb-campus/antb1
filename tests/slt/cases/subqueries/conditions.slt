# An element of two rows or more fails, whatever the other elements match.
statement error More than one row returned by a subquery used as an expression
SELECT zn_id FROM zones WHERE zn_id IN (1, (SELECT zn_city FROM zones WHERE zn_id < 3))

statement error More than one row returned by a subquery used as an expression
SELECT zn_id FROM zones WHERE zn_id IN ((SELECT ct_id FROM cities), 50)

# ---- LIKE ----

# A value as LIKE's operand (never its pattern): LIKE, NOT LIKE, and a NULL row.
query I nosort
SELECT ct_id FROM cities WHERE (SELECT label FROM zones WHERE zn_id = 2) LIKE 'no%' AND ct_id < 3 ORDER BY ct_id
----
SMALLINT
1
