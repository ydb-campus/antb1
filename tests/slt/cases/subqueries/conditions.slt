# Uncorrelated subqueries as values in conditions (ADR 0041's SQ1, its first PR): a scalar subquery or an EXISTS
# anywhere inside a condition of WHERE or of an inner join's ON, one inside a FULL JOIN's left input included -- under
# AND, OR, NOT and CASE, in arithmetic, functions, COALESCE, casts, IS [NOT] NULL, IS [NOT] DISTINCT FROM, IN lists,
# LIKE's operand and BETWEEN -- through its single value (NULL over no row, DuckDB's error over two or more), which is
# computed before any row is read (decision 9); a conjunct of a correlated block that reads the enclosing block and
# holds such a value; and a correlated conjunct every branch of an OR shares.

# ---- the inputs, one table at a time ----

query ITI nosort
SELECT ct_id, label, ct_pop FROM cities ORDER BY ct_id
----
SMALLINT	VARCHAR	INTEGER
1	center	120000
2	harbor	45000
3	hills	30000
4	airport	NULL
5	old town	8000
6	outskirts	2500

query III nosort
SELECT zn_id, zn_city, zn_parent FROM zones WHERE zn_id <= 12 ORDER BY zn_id
----
INTEGER	SMALLINT	INTEGER
1	1	NULL
2	2	NULL
3	3	NULL
4	4	NULL
5	5	NULL
6	1	1
7	2	2
8	3	3
9	4	4
10	5	5
11	1	1
12	2	2

query I nosort
SELECT COUNT(*) FROM promos
----
BIGINT
0

query IIII nosort
SELECT id, i16, i32, i64 FROM edge ORDER BY id
----
INTEGER	SMALLINT	INTEGER	BIGINT
0	-32768	-2147483648	-9223372036854775808
1	32767	2147483647	9223372036854775807
2	0	0	0
3	-1	-1	-1
4	1	1	1
5	NULL	NULL	NULL
6	100	100000	1000000000000000
7	-100	-100000	-1000000000000000
8	NULL	7	NULL
9	12345	NULL	42
10	-12345	54321	-42
11	7	-7	7

# ---- under OR: a value of one row, of no row, of a NULL row ----

# A value under OR, decided per row: one row's value; no row and a NULL row are NULL, so only the other branch keeps a
# row. City 4's population is NULL: its comparison is NULL, and so is its OR.
query I nosort
SELECT ct_id FROM cities WHERE ct_pop > (SELECT ct_pop FROM cities WHERE label = 'hills') OR ct_id = 5 ORDER BY ct_id
----
SMALLINT
1
2
5

query I nosort
SELECT ct_id FROM cities WHERE ct_pop > (SELECT ct_pop FROM cities WHERE ct_id > 100) OR ct_id = 5 ORDER BY ct_id
----
SMALLINT
5

query I nosort
SELECT ct_id FROM cities WHERE ct_pop > (SELECT ct_pop FROM cities WHERE label = 'airport') OR ct_id = 5 ORDER BY ct_id
----
SMALLINT
5

# An aggregate's value, and the same aggregate over no row: one row, whose value is NULL.
query I nosort
SELECT ct_id FROM cities WHERE ct_id > (SELECT MIN(zn_city) FROM zones) OR ct_id = 1 ORDER BY ct_id
----
SMALLINT
1
2
3
4
5
6

query I nosort
SELECT ct_id FROM cities WHERE ct_id > (SELECT MIN(zn_city) FROM zones WHERE zn_id > 1000) OR ct_id = 1 ORDER BY ct_id
----
SMALLINT
1

# Arithmetic over the value that would overflow, in an OR whose first branch holds for every row: no error.
query I rowsort
SELECT COUNT(*) FROM edge WHERE id >= 0 OR i32 > (SELECT MAX(i64) FROM edge) + 1
----
BIGINT
12

# ---- under NOT ----

# NOT over a comparison with a value: NOT NULL is NULL, so a value of no row or of a NULL row keeps nothing.
query I nosort
SELECT ct_id FROM cities WHERE NOT (ct_pop > (SELECT ct_pop FROM cities WHERE label = 'hills')) ORDER BY ct_id
----
SMALLINT
3
5
6

query I nosort
SELECT ct_id FROM cities WHERE NOT (ct_pop > (SELECT ct_pop FROM cities WHERE ct_id > 100)) ORDER BY ct_id
----
SMALLINT

query I nosort
SELECT ct_id FROM cities WHERE NOT (ct_pop > (SELECT ct_pop FROM cities WHERE label = 'airport')) ORDER BY ct_id
----
SMALLINT

# NOT over an OR: a row whose comparison is NULL and whose other branch is false stays NULL.
query I nosort
SELECT ct_id FROM cities WHERE NOT (ct_pop > (SELECT ct_pop FROM cities WHERE label = 'hills') OR ct_id = 5) ORDER BY ct_id
----
SMALLINT
3
6

# NOT over IS NULL of a value that reads no column of the block: every row, or none for a NULL row.
query I nosort
SELECT ct_id FROM cities WHERE NOT ((SELECT zn_parent FROM zones WHERE zn_id = 10) IS NULL) ORDER BY ct_id
----
SMALLINT
1
2
3
4
5
6

query I nosort
SELECT ct_id FROM cities WHERE NOT ((SELECT zn_parent FROM zones WHERE zn_id = 1) IS NULL) ORDER BY ct_id
----
SMALLINT

# ---- CASE ----

# A value in a WHEN condition: one row, an aggregate, and no row, whose NULL condition sends every row to the ELSE.
query I nosort
SELECT ct_id FROM cities WHERE CASE WHEN ct_pop > (SELECT ct_pop FROM cities WHERE label = 'hills') THEN 1 ELSE 0 END = 1 ORDER BY ct_id
----
SMALLINT
1
2

query I nosort
SELECT ct_id FROM cities WHERE CASE WHEN ct_id > (SELECT MIN(zn_city) FROM zones) THEN 1 ELSE 0 END = 1 ORDER BY ct_id
----
SMALLINT
2
3
4
5
6

query I nosort
SELECT ct_id FROM cities WHERE CASE WHEN ct_pop > (SELECT ct_pop FROM cities WHERE ct_id > 100) THEN 1 ELSE 0 END = 0 ORDER BY ct_id
----
SMALLINT
1
2
3
4
5
6

# CASE x WHEN: a value as the operand that every WHEN compares (a NULL row matches none: the ELSE), and as a WHEN.
query I nosort
SELECT ct_id FROM cities WHERE CASE (SELECT zn_parent FROM zones WHERE zn_id = 10) WHEN 5 THEN ct_pop ELSE ct_id END > 20000 ORDER BY ct_id
----
SMALLINT
1
2
3

query I nosort
SELECT ct_id FROM cities WHERE CASE (SELECT zn_parent FROM zones WHERE zn_id = 1) WHEN 5 THEN ct_pop ELSE ct_id END > 4 ORDER BY ct_id
----
SMALLINT
5
6

query I nosort
SELECT ct_id FROM cities WHERE CASE (SELECT MIN(zn_city) FROM zones) WHEN 1 THEN ct_id WHEN 2 THEN 0 END > 2 ORDER BY ct_id
----
SMALLINT
3
4
5
6

query I nosort
SELECT ct_id FROM cities WHERE CASE ct_id WHEN (SELECT zn_parent FROM zones WHERE zn_id = 10) THEN 1 ELSE 0 END = 1 ORDER BY ct_id
----
SMALLINT
5

# Values as THEN and ELSE, and a THEN of no row: NULL for the rows that take it.
query I nosort
SELECT ct_id FROM cities WHERE CASE WHEN ct_id > 3 THEN (SELECT zn_parent FROM zones WHERE zn_id = 9) ELSE (SELECT MAX(zn_city) FROM zones WHERE zn_id < 3) END < ct_id ORDER BY ct_id
----
SMALLINT
3
5
6

query I nosort
SELECT ct_id FROM cities WHERE CASE WHEN ct_id > 3 THEN (SELECT zn_parent FROM zones WHERE zn_id > 1000) ELSE ct_id END > 1 ORDER BY ct_id
----
SMALLINT
2
3

# Arithmetic that would overflow over a value of one row and over an aggregate, in an ELSE no row takes: no error.
query I nosort
SELECT ct_id FROM cities WHERE CASE WHEN ct_id > 0 THEN 0 ELSE (SELECT i64 FROM edge WHERE id = 1) + 1 END = 0 ORDER BY ct_id
----
SMALLINT
1
2
3
4
5
6

query I rowsort
SELECT COUNT(*) FROM edge WHERE CASE WHEN id >= 0 THEN 0 ELSE (SELECT MAX(i64) FROM edge) + 1 END = 0
----
BIGINT
12

# ---- EXISTS and NOT EXISTS under OR, NOT and CASE ----

# Under OR: EXISTS over no row is false, over two rows true (it reads no value, so no error), over LIMIT 0 false, over
# an ungrouped aggregate of an empty table true (one row), over a grouped one false.
query I nosort
SELECT ct_id FROM cities WHERE EXISTS (SELECT 1 FROM zones WHERE zn_city > 100) OR ct_id = 1 ORDER BY ct_id
----
SMALLINT
1

query I nosort
SELECT ct_id FROM cities WHERE EXISTS (SELECT zn_id FROM zones WHERE zn_city = 2) OR ct_id = 1 ORDER BY ct_id
----
SMALLINT
1
2
3
4
5
6

query I nosort
SELECT ct_id FROM cities WHERE EXISTS (SELECT 1 FROM zones LIMIT 0) OR ct_id = 2 ORDER BY ct_id
----
SMALLINT
2

query I nosort
SELECT ct_id FROM cities WHERE EXISTS (SELECT MAX(pm_id) FROM promos) OR ct_id = 2 ORDER BY ct_id
----
SMALLINT
1
2
3
4
5
6

query I nosort
SELECT ct_id FROM cities WHERE EXISTS (SELECT MAX(pm_id) FROM promos GROUP BY pm_code) OR ct_id = 2 ORDER BY ct_id
----
SMALLINT
2

