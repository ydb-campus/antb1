# A CASE over an EXISTS with no column in its branches is a value of each row too, no constant.
query I nosort
SELECT ct_id FROM cities WHERE CASE WHEN EXISTS (SELECT 1 FROM zones WHERE zn_id = 1) THEN 1 ELSE 0 END = 1 ORDER BY ct_id
----
SMALLINT
1
2
3
4
5
6

query I nosort
SELECT ct_id FROM cities WHERE CASE WHEN NOT EXISTS (SELECT 1 FROM promos) THEN 0 ELSE 1 END = 1 ORDER BY ct_id
----
SMALLINT

# In an inner join's ON: NOT EXISTS under OR, false, so the other branch decides.
query II nosort
SELECT ct_id, zn_id FROM cities JOIN zones ON zn_city = ct_id AND (NOT EXISTS (SELECT 1 FROM drivers WHERE dv_city = 1) OR zn_radius > 3) ORDER BY zn_id
----
SMALLINT	INTEGER
2	12
4	24
1	36

# The EXISTS block's own value has two rows: the error is raised, although the other branch holds for a row.
statement error More than one row returned by a subquery used as an expression
SELECT ct_id FROM cities WHERE ct_id = 1 OR EXISTS (SELECT 1 FROM zones WHERE zn_id > (SELECT zn_id FROM zones WHERE zn_city = 2))

# ---- OR factoring ----

# A conjunct every branch shares leaves the OR as a conjunct of its own: a value, an uncorrelated EXISTS.
query I nosort
SELECT ct_id FROM cities WHERE (ct_id = 1 AND ct_pop <= (SELECT ct_pop FROM cities WHERE label = 'harbor')) OR (ct_id = 3 AND ct_pop <= (SELECT ct_pop FROM cities WHERE label = 'harbor')) ORDER BY ct_id
----
SMALLINT
3

query I nosort
SELECT ct_id FROM cities WHERE (ct_id = 1 AND EXISTS (SELECT 1 FROM zones WHERE zn_city = 9)) OR (ct_id = 3 AND EXISTS (SELECT 1 FROM zones WHERE zn_city = 9)) ORDER BY ct_id
----
SMALLINT
1
3

# An OR its shared conjunct implies is dropped, and the shared conjunct alone decides. A value only the dropped branch
# holds is never computed, so its two rows raise no error (as in DuckDB).
query I nosort
SELECT ct_id FROM cities WHERE (ct_id = 1 AND ct_pop > (SELECT ct_pop FROM cities WHERE label = 'hills')) OR ct_pop > (SELECT ct_pop FROM cities WHERE label = 'hills') ORDER BY ct_id
----
SMALLINT
1
2

query I rowsort
SELECT COUNT(*) FROM cities WHERE (ct_id = 2 AND ct_id > (SELECT zn_city FROM zones)) OR ct_id = 2
----
BIGINT
1

# The same value compared with another literal in each branch.
query I nosort
SELECT ct_id FROM cities WHERE ((SELECT MIN(zn_city) FROM zones) = 1 AND ct_id = 2) OR ((SELECT MIN(zn_city) FROM zones) = 2 AND ct_id = 3) ORDER BY ct_id
----
SMALLINT
2

# A correlated conjunct every branch shares: EXISTS, NOT EXISTS and a scalar value.
query I rowsort
SELECT COUNT(*) FROM trips WHERE (tr_fare > 25 AND EXISTS (SELECT 1 FROM riders WHERE rd_id = tr_rider AND rd_tier = 'gold')) OR (tr_fare < 5 AND EXISTS (SELECT 1 FROM riders WHERE rd_id = tr_rider AND rd_tier = 'gold'))
----
BIGINT
147

query I rowsort
SELECT COUNT(*) FROM trips WHERE (tr_fare > 25 AND NOT EXISTS (SELECT 1 FROM riders WHERE rd_id = tr_rider AND rd_tier = 'gold')) OR (tr_fare < 5 AND NOT EXISTS (SELECT 1 FROM riders WHERE rd_id = tr_rider AND rd_tier = 'gold'))
----
BIGINT
332

query I nosort
SELECT ct_id FROM cities WHERE (ct_id < 3 AND ct_pop > (SELECT SUM(zn_id) * 200 FROM zones WHERE zn_city = ct_id)) OR (ct_id > 4 AND ct_pop > (SELECT SUM(zn_id) * 200 FROM zones WHERE zn_city = ct_id)) ORDER BY ct_id
----
SMALLINT
1
2

# A dropped branch that holds a correlated value: the shared correlated conjunct alone decides.
query I nosort
SELECT ct_id FROM cities WHERE (ct_pop > (SELECT SUM(zn_id) * 200 FROM zones WHERE zn_city = ct_id) AND ct_id = 1) OR ct_pop > (SELECT SUM(zn_id) * 200 FROM zones WHERE zn_city = ct_id) ORDER BY ct_id
----
SMALLINT
1
2
3

# ---- arithmetic, functions, COALESCE and casts over a value ----

# A value plus a literal against a column; over no row or a NULL row the sum is NULL, and NOT keeps it NULL.
query I rowsort
SELECT COUNT(*) FROM trips WHERE tr_pickup > (SELECT zn_parent FROM zones WHERE zn_id = 10) + 1
----
BIGINT
2580

query I rowsort
SELECT COUNT(*) FROM trips WHERE tr_pickup > (SELECT pm_id FROM promos) + 1
----
BIGINT
0

query I rowsort
SELECT COUNT(*) FROM trips WHERE NOT (tr_pickup > (SELECT zn_parent FROM zones WHERE zn_id = 1) + 1)
----
BIGINT
0

