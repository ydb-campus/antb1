# ---- three-valued logic, sets and types ----

# The three-valued result of IN and NOT IN, per edge row as T, F or N (NULL): a NULL probe gives NULL unless the
# set is empty; a NULL in the set turns every miss into NULL, also for a probe that is never NULL; sets of only
# NULLs; BIGINT, SMALLINT, VARCHAR and INTEGER sets with a NULL, and a set without one.

query IT nosort
SELECT id, CASE WHEN i32 IN (SELECT i32 FROM edge WHERE id IN (2, 3, 4)) THEN 'T' WHEN NOT (i32 IN (SELECT i32 FROM edge WHERE id IN (2, 3, 4))) THEN 'F' ELSE 'N' END AS m FROM edge ORDER BY id
