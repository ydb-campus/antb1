query RRRR nosort
SELECT stddev_samp(i16), stddev_pop(i16), var_samp(i16), var_pop(i16) FROM edge WHERE i16 > 100000
----
DOUBLE	DOUBLE	DOUBLE	DOUBLE
NULL	NULL	NULL	NULL

query IR rowsort
SELECT tr_rider % 3 AS r, var_samp(tr_fare) FROM trips GROUP BY r HAVING var_samp(tr_fare) > 0
