# The variance family (ADR 0037's AG2, docs/sql-subset.md): STDDEV_SAMP, STDDEV_POP, VAR_SAMP and VAR_POP, with the
# aliases STDDEV and VARIANCE, DOUBLE over any number column as DuckDB computes them.

query RRRRRR nosort
SELECT stddev_samp(i16), STDDEV(i32), stddev_pop(i64), var_samp(u16), VARIANCE(d), var_pop(d + 1) FROM edge
----
DOUBLE	DOUBLE	DOUBLE	DOUBLE	DOUBLE	DOUBLE
16506.68622239014	1012333500.9996302	4124817395479092736	508882026.7666667	8.526331969098496e+34	7.673698772188646e+34

query RRRR nosort
SELECT stddev_samp(d9_2), var_pop(d9_2), stddev_pop(d18_4), variance(d38_10) FROM decimals
----
DOUBLE	DOUBLE	DOUBLE	DOUBLE
2461829.817128057	5882352929427.211	16726198465241.85	5.88235294117647e+54

query IRRRI rowsort
SELECT tr_rider % 5 AS r, stddev_samp(tr_fare), var_pop(tr_fare), stddev_pop(tr_row), COUNT(*) FROM trips GROUP BY r
----
BIGINT	DOUBLE	DOUBLE	DOUBLE	BIGINT
0	7.008018586095118	49.02415156857876	862.248269966075	572
1	6.999826643584183	48.91085167201821	864.4198555150444	584
2	7.032632788920477	49.36881056732408	872.6111967582071	574
3	6.880933807255382	47.26100734569556	863.8116306637182	569
4	7.102073206006872	50.34773574380167	866.0903576235467	570
NULL	7.023941550556693	48.94728439456876	869.7528384546957	131

