# ---- counts, which merge through a kind of their own ----

# COUNT of a column of the grouped side, which is the shape ADR 0032 was written for. The exchange counts
# below and sums those counts above, through a kind whose result stays BIGINT -- a SUM of integers would have
# returned HUGEINT, which is not the type COUNT asked for.
query II nosort
SELECT zn_city, COUNT(tr_fare) FROM trips LEFT JOIN zones ON tr_pickup = zn_id
GROUP BY zn_city ORDER BY zn_city
----
1	540
2	542
3	474
4	474
5	539
9	67
NULL	267

# The same over a grouped side that can go missing, where a left row with no match reads no partial at all.
# A missing partial counted nothing, so it adds zero -- and 0 is what COUNT of a column answered for such a
# row. This is the case the whole kind exists to get right.
query TI nosort
SELECT a.tr_day, COUNT(b.tr_fare) FROM trips a LEFT JOIN trips b ON a.tr_pickup = b.tr_dropoff
WHERE a.tr_pickup > 40 GROUP BY a.tr_day ORDER BY a.tr_day
