# The same with every group unmatched, so every row must come back NULL: if a missing partial were read as
# anything else, this block is where it would show.
query TDD nosort
SELECT a.tr_day, SUM(b.tr_fare), MAX(b.tr_fare) FROM trips a LEFT JOIN trips b ON a.tr_pickup = b.tr_dropoff
WHERE a.tr_pickup > 40 GROUP BY a.tr_day ORDER BY a.tr_day
