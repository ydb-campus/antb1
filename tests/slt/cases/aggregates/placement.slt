# An aggregate reading both inputs, which no single side can compute.
query IR nosort
SELECT zn_city, SUM(tr_fare + zn_radius) FROM trips LEFT JOIN zones ON tr_pickup = zn_id
GROUP BY zn_city ORDER BY zn_city
----
1	8314
2	9383.75
3	7083.25
4	8276.75
5	9263
9	NULL
NULL	1083.75

# ---- a chain of joins: the exchange travels past the join the aggregate reads ----

# The partial lands two joins below the aggregate, grouping `cities` by the key `riders` joins it on,
# and the Compute of a computed argument travels down with it. Each of these was checked with
# `antb1 explain` to hold two GroupAggregate nodes with the partial on `cities`, not one.
#
# `tr_tariff` is introduced ABOVE the candidate join, so the pre-grouping does not hold it. That is
# the soundness claim of the whole rewrite: a partial joins to the rows above exactly as its member
# rows would have, so the fan-out is unchanged and the final step groups again. `riders` repeats 8 of
# its keys, so this really does fan out, and `tr_tariff` and `rd_tier` both hold NULLs.
query TTI nosort
SELECT tr_tariff, rd_tier, SUM(ct_pop) FROM trips, riders, cities
WHERE tr_rider = rd_id AND rd_city = ct_id GROUP BY tr_tariff, rd_tier ORDER BY tr_tariff, rd_tier
----
