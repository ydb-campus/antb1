# A grouped aggregate computed on one input of the join it reads (docs/adr/0032-aggregate-placement.md). The
# rewrite is invisible in SQL -- it changes no answer, which is the whole of what these cases check. Each one
# below is a shape the gate admits, so each really is answered by the exchanged plan and not by the written one --
# `antb1 explain` shows two GroupAggregate nodes where the query has one, and that was checked for each rather
# than assumed: the first attempt at the condition 3 case grouped by a column of 3000 distinct values, which the
# gate refuses for making one group a row, so it was answered by the written plan and proved nothing. The
# refusals at the end are here because a rewrite that fired on them would answer differently.

# ---- the inputs, so a wrong exchange cannot hide in a shape nobody checked ----

query I nosort
SELECT COUNT(*) FROM trips
----
3000

# Every zone is picked up from, so no row of `zones` goes unmatched -- which is why nothing below needs the
# padding of condition 5: the side being grouped here is `trips`, the preserved one.
query I nosort
SELECT COUNT(*) FROM zones WHERE zn_id NOT IN (SELECT tr_pickup FROM trips)
----
0

# ---- shapes the exchange takes ----

# SUM of the aggregated side, grouped by a column of the other. The sum of partial sums is the sum.
query ID nosort
SELECT zn_city, SUM(tr_fare) FROM trips LEFT JOIN zones ON tr_pickup = zn_id GROUP BY zn_city ORDER BY zn_city
----
1	8401.75
2	8432.75
3	7356.00
4	7328.75
5	8320.50
9	1016.00
NULL	4136.75

# MIN and MAX together, which merge by taking the same function of the partials.
query IDD nosort
SELECT zn_city, MIN(tr_fare), MAX(tr_fare) FROM trips LEFT JOIN zones ON tr_pickup = zn_id
GROUP BY zn_city ORDER BY zn_city
----
1	3.50	27.50
2	3.50	27.50
3	3.50	27.50
4	3.50	27.50
5	3.50	27.50
9	3.50	27.50
NULL	3.50	27.50

