# ---- shapes the exchange declines, whose answers must be the written ones ----

# A count beside the sum: summing partial counts returns HUGEINT where COUNT returns BIGINT, so the exchange
# has nothing to say the plan can express and leaves the query alone.
query IDI nosort
SELECT zn_city, SUM(tr_fare), COUNT(*) FROM trips LEFT JOIN zones ON tr_pickup = zn_id
GROUP BY zn_city ORDER BY zn_city
----
1	8401.75	559
2	8432.75	559
3	7356.00	490
4	7328.75	489
5	8320.50	558
9	1016.00	69
NULL	4136.75	276

# AVG, whose partial is a pair and whose final divides.
query IR nosort
SELECT zn_city, AVG(tr_fare) FROM trips LEFT JOIN zones ON tr_pickup = zn_id GROUP BY zn_city ORDER BY zn_city
----
1	15.558796296296297
2	15.558579335793358
3	15.518987341772151
4	15.461497890295359
5	15.436920222634509
9	15.164179104477611
NULL	15.493445692883896

# An aggregate reading both inputs, which no single side can compute.
query IR nosort
SELECT zn_city, SUM(tr_fare + zn_radius) FROM trips LEFT JOIN zones ON tr_pickup = zn_id
GROUP BY zn_city ORDER BY zn_city
----
1	8314
2	9383.75
3	7083.25
4	8276.75
5	9263
9	NULL
NULL	1083.75
