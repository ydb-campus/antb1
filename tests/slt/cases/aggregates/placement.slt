# A filter on the grouped side, which the planner pushes below the join and so below the partial: the partial
# must aggregate the rows that survive it, not the rows the table holds. The first case above already shows
# that unmatched trips survive, as its NULL group.
query ID nosort
SELECT zn_city, SUM(tr_fare) FROM trips LEFT JOIN zones ON tr_pickup = zn_id
WHERE tr_fare > 10 GROUP BY zn_city ORDER BY zn_city
----
1	7378.50
2	7416.00
3	6467.25
4	6440.75
5	7314.75
9	894.75
NULL	3627.50

# ---- the padding shape: the grouped side is the one that can go missing ----

# A self-join whose right side is grouped, so a left row with no match reads no partial at all. For SUM and MAX
# the written query answered NULL there, which is already what an aggregate of a missing partial gives -- which
# is why the exchange builds no mapping. This is the shape ADR 0032 exists for, and the only one here where
# `needs_identity` is set.
query TDD nosort
SELECT a.tr_day, SUM(b.tr_fare), MAX(b.tr_fare) FROM trips a LEFT JOIN trips b ON a.tr_pickup = b.tr_dropoff
GROUP BY a.tr_day ORDER BY a.tr_day
