1	NULL	1047.50
2	0.5	1001.50
2	0.75	1063.50
2	1	1061.50
2	1.5	1047.75
2	2	1034.00
2	2.25	1056.25
2	2.75	1091.00
2	3.25	1077.25
3	1	1077.50
3	1.25	1025.75
3	1.75	999.75
3	2.25	1023.75
3	2.5	1093.25
3	3	1069.00
3	NULL	1067.00
4	0.75	1079.75
4	1.25	1044.25
4	1.5	1015.50
4	2	1026.00
4	2.5	1036.50
4	2.75	1057.50
4	3.25	1069.25
5	0.5	1050.25
5	1	1045.25
5	1.25	1021.50
5	1.5	1031.50
5	1.75	1022.50
5	2.25	1040.00
5	2.75	1050.50
5	3	1059.00
9	NULL	1016.00
NULL	0.75	1033.50
NULL	NULL	3103.25

# A grouping column of the AGGREGATED side, which condition 3 puts into the pre-grouping: the partial groups the
# trips by their promo as well as by the join key, or its groups would merge rows this query separates. This is
# the condition whose omission changes aggregate values rather than row counts, so it is the one case here that
# has to be answered by the exchange -- `keys=[trips.tr_pickup, trips.tr_promo]` below the join.
query IID nosort
SELECT zn_city, tr_promo, SUM(tr_fare) FROM trips LEFT JOIN zones ON tr_pickup = zn_id
GROUP BY zn_city, tr_promo ORDER BY zn_city, tr_promo
----
1	1	37.25
1	2	49.50
1	3	19.50
1	4	58.25
1	NULL	8237.25
2	1	34.75
2	2	32.25
2	3	56.25
2	4	69.75
2	NULL	8239.75
3	1	47.50
3	2	31.50
3	3	25.50
3	4	54.75
3	NULL	7196.75
4	1	40.50
4	2	53.00
4	3	14.00
4	4	30.00
4	NULL	7191.25
5	1	51.00
5	2	45.00
5	3	37.75
5	4	27.00
5	NULL	8159.75
9	3	14.50
9	NULL	1001.50
NULL	1	19.75
NULL	2	15.00
NULL	3	25.50
NULL	4	7.50
NULL	NULL	4069.00

# A filter on the grouped side, which the planner pushes below the join and so below the partial: the partial
# must aggregate the rows that survive it, not the rows the table holds. The first case above already shows
# that unmatched trips survive, as its NULL group.
query ID nosort
SELECT zn_city, SUM(tr_fare) FROM trips LEFT JOIN zones ON tr_pickup = zn_id
WHERE tr_fare > 10 GROUP BY zn_city ORDER BY zn_city
----
1	7378.50
2	7416.00
3	6467.25
4	6440.75
5	7314.75
9	894.75
NULL	3627.50

# ---- the padding shape: the grouped side is the one that can go missing ----

# A self-join whose right side is grouped, so a left row with no match reads no partial at all. For SUM and MAX
# the written query answered NULL there, which is already what an aggregate of a missing partial gives -- which
# is why the exchange builds no mapping. This is the shape ADR 0032 exists for, and the only one here where
# `needs_identity` is set.
query TDD nosort
SELECT a.tr_day, SUM(b.tr_fare), MAX(b.tr_fare) FROM trips a LEFT JOIN trips b ON a.tr_pickup = b.tr_dropoff
GROUP BY a.tr_day ORDER BY a.tr_day
----
