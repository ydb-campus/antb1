# The same chain with the aggregated side's own grouping column, so the pre-grouping holds a column
# of the grouping set as well as the join key (condition 3's second half, two joins down).
query TIII nosort
SELECT rd_tier, ct_id, COUNT(*), SUM(ct_pop) FROM trips, riders, cities
WHERE tr_rider = rd_id AND rd_city = ct_id GROUP BY rd_tier, ct_id ORDER BY rd_tier, ct_id
----
basic	1	456	54720000
basic	2	460	20700000
gold	2	454	20430000
gold	3	456	13680000
plus	1	459	55080000
plus	3	459	13770000
