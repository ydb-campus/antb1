# A count through the chain, which merges as a sum of counts, and MIN and MAX, which merge as
# themselves. ct_pop holds a NULL, so COUNT(ct_pop) and COUNT(*) differ.
query TTIII nosort
SELECT tr_tariff, rd_tier, COUNT(ct_pop), MIN(ct_pop), MAX(ct_pop) FROM trips, riders, cities
WHERE tr_rider = rd_id AND rd_city = ct_id GROUP BY tr_tariff, rd_tier ORDER BY tr_tariff, rd_tier
