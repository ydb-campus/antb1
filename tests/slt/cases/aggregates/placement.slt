# A grouping column of the AGGREGATED side, which condition 3 puts into the pre-grouping: the partial groups the
# trips by their promo as well as by the join key, or its groups would merge rows this query separates. This is
# the condition whose omission changes aggregate values rather than row counts, so it is the one case here that
# has to be answered by the exchange -- `keys=[trips.tr_pickup, trips.tr_promo]` below the join.
query IID nosort
SELECT zn_city, tr_promo, SUM(tr_fare) FROM trips LEFT JOIN zones ON tr_pickup = zn_id
GROUP BY zn_city, tr_promo ORDER BY zn_city, tr_promo
