# Runs the command after `--`, an antb1-slt ratchet whose refused query has a message that quotes SENTINEL, and
# checks its local refusal report (RatchetOptions::refusals) without printing it. The command's output must not hold
# SENTINEL. FILE must hold it after the place LINE, a regex (EXPECT=present), must not exist (EXPECT=absent), or is
# not checked (EXPECT=unchecked). COSTS, if given, is a costs file (--costs) that must exist and not hold SENTINEL.
# With PLANT=1 a stale FILE is written first; with PLANT_DIR=1 a directory that is not empty takes FILE's place, so
# that the run can neither remove nor write it. Prints the command's output and a verdict line, and exits with the
# command's exit code, or 1 when a check fails.
#
#   cmake -DFILE=<path> -DSENTINEL=<text> -DEXPECT=present|absent|unchecked [-DLINE=<regex>] [-DCOSTS=<path>]
#         [-DPLANT=1 | -DPLANT_DIR=1] -P check_refusals.cmake -- <command> [args...]
cmake_minimum_required(VERSION 3.29) # cmake_language(EXIT)

foreach(_var FILE SENTINEL EXPECT)
  if(NOT DEFINED ${_var})
    message(FATAL_ERROR "check_refusals.cmake: -D${_var}=... is required")
  endif()
endforeach()
set(_command "")
set(_in_command FALSE)
math(EXPR _last "${CMAKE_ARGC} - 1")
foreach(_i RANGE 0 ${_last})
  if(_in_command)
    list(APPEND _command "${CMAKE_ARGV${_i}}")
  elseif(CMAKE_ARGV${_i} STREQUAL "--")
    set(_in_command TRUE)
  endif()
endforeach()
if(NOT _command)
  message(FATAL_ERROR "check_refusals.cmake: no command after --")
endif()

if(PLANT)
  file(WRITE "${FILE}" "a stale report\n")
elseif(PLANT_DIR)
  file(MAKE_DIRECTORY "${FILE}/not-empty")
endif()
execute_process(COMMAND ${_command} RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _out)
set(_problems "")
set(_verdict "")
string(FIND "${_out}" "${SENTINEL}" _at)
if(NOT _at EQUAL -1)
  list(APPEND _problems "the output holds the sentinel")
  set(_out "(the output is withheld: it holds the sentinel)\n")
endif()
if(EXPECT STREQUAL "present")
  if(NOT EXISTS "${FILE}")
    list(APPEND _problems "there is no refusals file")
  else()
    file(READ "${FILE}" _report)
    string(FIND "${_report}" "${SENTINEL}" _in)
    if(_in EQUAL -1)
      list(APPEND _problems "the refusals file lacks the sentinel")
    elseif(DEFINED LINE AND NOT _report MATCHES "${LINE}")
      list(APPEND _problems "the refusals file lacks its place")
    else()
      set(_verdict "refusals file: holds the sentinel at its place")
    endif()
  endif()
elseif(EXPECT STREQUAL "absent")
  if(EXISTS "${FILE}")
    list(APPEND _problems "a refusals file exists")
  else()
    set(_verdict "refusals file: none")
  endif()
endif()
if(DEFINED COSTS)
  if(NOT EXISTS "${COSTS}")
    list(APPEND _problems "there is no costs file")
  else()
    file(READ "${COSTS}" _costs)
    string(FIND "${_costs}" "${SENTINEL}" _in_costs)
    if(NOT _in_costs EQUAL -1)
      list(APPEND _problems "the costs file holds the sentinel")
    else()
      string(APPEND _verdict "; costs file: no sentinel")
    endif()
  endif()
endif()
message("${_out}${_verdict}")
if(_problems)
  message("check_refusals.cmake: ${_problems}")
  cmake_language(EXIT 1)
endif()
if(NOT _rc MATCHES "^[0-9]+$")
  set(_rc 125)
endif()
cmake_language(EXIT ${_rc})
