# The pending guard (tests/slt/README.md): DuckDB runs a `pending <roadmap id>` record as usual, the slt.* and
# parallel.* tests skip it, and harness.slt.pending runs it on antb1, where it must still get Unsupported. Z9 is no
# roadmap PR: these records use a recursive CTE, which antb1 does not answer (docs/sql-subset.md), so they stay
# pending, and the self-tests harness.slt.pending.mutate.* make antb1 answer them, or fail them with an execution
# error, which the check must report.

query I nosort
SELECT COUNT(*) FROM edge
----
BIGINT
12

pending Z9
query I nosort
WITH RECURSIVE countdown(n) AS (SELECT COUNT(*) FROM (SELECT * FROM edge LIMIT 3) AS seed UNION ALL SELECT n - 1 FROM countdown WHERE n > 0) SELECT COUNT(*) FROM countdown
----
BIGINT
4

pending Z9
statement error
WITH RECURSIVE countdown(n) AS (SELECT COUNT(*) FROM (SELECT * FROM no_such_table LIMIT 3) AS seed UNION ALL SELECT n - 1 FROM countdown WHERE n > 0) SELECT COUNT(*) FROM countdown
