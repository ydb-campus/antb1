# libFuzzer dictionary for antb1-sql-parser-fuzzer (-dict=fuzz/sql.dict): the tokens of the SQL subset
# (docs/sql-subset.md) and of common SQL outside it, which the parser must reject cleanly.

# keywords of the subset
kw_select="SELECT"
kw_from="FROM"
kw_where="WHERE"
kw_and="AND"
kw_limit="LIMIT"
kw_as="AS"
kw_date="DATE"
kw_count="COUNT"
kw_sum="SUM"
kw_avg="AVG"
kw_min="MIN"
kw_max="MAX"
kw_count_star="COUNT(*)"
kw_select_count="SELECT COUNT(*) FROM "

# keywords outside the subset (must yield Unsupported or a syntax error, never a crash)
kw_or="OR"
kw_not="NOT"
kw_null="NULL"
kw_is="IS"
kw_in="IN"
kw_like="LIKE"
kw_between="BETWEEN"
kw_distinct="DISTINCT"
kw_group_by="GROUP BY"
kw_order_by="ORDER BY"
kw_having="HAVING"
kw_join="JOIN"
kw_on="ON"
kw_offset="OFFSET"
kw_true="TRUE"
kw_false="FALSE"
kw_case="CASE"
kw_when="WHEN"
kw_then="THEN"
kw_end="END"
kw_insert="INSERT"

# punctuation and operators
p_star="*"
p_comma=","
p_lparen="("
p_rparen=")"
p_semicolon=";"
p_dot="."
p_plus="+"
p_minus="-"
p_slash="/"
p_percent="%"
op_eq="="
op_ne="<>"
op_ne_bang="!="
op_lt="<"
op_le="<="
op_gt=">"
op_ge=">="

# literals, quoting and comments
q_string="'"
q_string_escape="''"
q_ident="\""
q_ident_escape="\"\""
lit_int="42"
lit_neg="-7"
lit_big="99999999999999999999999"
lit_decimal="1.5"
lit_leading_dot=".25"
lit_exp="2.5e3"
lit_exp_neg="1E-9"
lit_date="DATE '2024-02-29'"
path_parquet="'data/part-0.parquet'"
path_glob="'data/*.parquet'"
comment_line="--"
comment_open="/*"
comment_close="*/"
ws_newline="\x0a"
ws_tab="\x09"
byte_nul="\x00"
byte_high="\xff"
