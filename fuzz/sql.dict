# libFuzzer dictionary for antb1-sql-parser-fuzzer (-dict=fuzz/sql.dict): the tokens of the SQL subset
# (docs/sql-subset.md) and of common SQL outside it, which the parser must reject cleanly.

# keywords of the subset
kw_select="SELECT"
kw_from="FROM"
kw_where="WHERE"
kw_and="AND"
kw_between="BETWEEN"
op_not_between=" NOT BETWEEN "
op_between_range=" BETWEEN 1 AND 2"
kw_limit="LIMIT"
kw_as="AS"
kw_date="DATE"
kw_timestamp="TIMESTAMP"
kw_count="COUNT"
kw_sum="SUM"
kw_avg="AVG"
kw_min="MIN"
kw_max="MAX"
kw_count_star="COUNT(*)"
kw_select_count="SELECT COUNT(*) FROM "
kw_distinct="DISTINCT"
kw_group_by="GROUP BY"
kw_order_by="ORDER BY"
kw_asc="ASC"
kw_desc="DESC"
kw_nulls_first="NULLS FIRST"
kw_nulls_last="NULLS LAST"
kw_offset="OFFSET"
kw_having_kw="HAVING"
kw_else="ELSE"
kw_extract="EXTRACT("
kw_extract_minute="EXTRACT(minute FROM "
kw_case_when="CASE WHEN "
kw_cast="CAST("
kw_try_cast="TRY_CAST("
kw_as_date=" AS DATE)"
p_double_colon="::"
type_date="::DATE"
type_integer="INTEGER"
type_decimal="DECIMAL(15, 2)"
fn_call="f("
p_int_divide="//"
nest_open="(((("
nest_close="))))"
kw_join="JOIN"
kw_on="ON"
kw_cross="CROSS"
kw_inner="INNER"
kw_left="LEFT"
kw_outer="OUTER"
join_inner=" INNER JOIN "
join_left_outer=" LEFT OUTER JOIN "
join_cross=" CROSS JOIN "
col_qualified="t.x"
col_qualified_quoted="\"t\".\"x\""
alias_quoted=" AS \"a\""
kw_with="WITH"
with_cte="WITH c AS (SELECT "
cte_as=" AS (SELECT "
derived_open="(SELECT "
derived_star="(SELECT * FROM "
derived_columns=") AS s("
column_list="(x, \"y\")"

# keywords outside the subset (must yield Unsupported or a syntax error, never a crash)
kw_or="OR"
kw_not="NOT"
kw_null="NULL"
kw_is="IS"
kw_in="IN"
kw_like="LIKE"
kw_escape="ESCAPE"
lit_like_pattern="'%_%'"
kw_having="HAVING"
kw_using="USING"
kw_natural="NATURAL"
kw_right="RIGHT"
kw_full="FULL"
kw_lateral="LATERAL"
kw_semi="SEMI"
kw_anti="ANTI"
kw_asof="ASOF"
kw_positional="POSITIONAL"
kw_pivot="PIVOT"
kw_unpivot="UNPIVOT"
kw_tablesample="TABLESAMPLE"
kw_at="AT"
kw_only="ONLY"
kw_glob="GLOB"
kw_recursive="RECURSIVE"
kw_materialized="MATERIALIZED"
kw_using_key=" USING KEY "
kw_values="VALUES"
kw_table="TABLE"
kw_union="UNION"
p_dot_star=".*"
kw_true="TRUE"
kw_false="FALSE"
kw_case="CASE"
kw_when="WHEN"
kw_then="THEN"
kw_end="END"
kw_insert="INSERT"
type_quoted="\"DATE\""
type_double_precision="DOUBLE PRECISION"
type_with_time_zone="TIMESTAMP WITH TIME ZONE"
type_array="[]"
kw_array="ARRAY"
kw_interval="INTERVAL"

# punctuation and operators
p_star="*"
p_comma=","
p_lparen="("
p_rparen=")"
p_semicolon=";"
p_dot="."
p_plus="+"
p_minus="-"
p_slash="/"
p_percent="%"
op_eq="="
op_ne="<>"
op_ne_bang="!="
op_lt="<"
op_le="<="
op_gt=">"
op_ge=">="

# literals, quoting and comments
q_string="'"
q_string_escape="''"
q_ident="\""
q_ident_escape="\"\""
lit_int="42"
lit_neg="-7"
lit_big="99999999999999999999999"
lit_decimal="1.5"
lit_leading_dot=".25"
lit_exp="2.5e3"
lit_exp_neg="1E-9"
lit_date="DATE '2024-02-29'"
lit_timestamp="TIMESTAMP '2024-02-29 23:59:59.999999'"
path_parquet="'data/part-0.parquet'"
path_glob="'data/*.parquet'"
comment_line="--"
comment_open="/*"
comment_close="*/"
ws_newline="\x0a"
ws_tab="\x09"
byte_nul="\x00"
byte_high="\xff"
